{%- comment -%}
  Reviews — structure ported from the Patches "Scrolling Reviews" section:
  a dark band with two marquee rows travelling in opposite directions. Each
  row's cards are rendered twice so the -50% translate loops seamlessly.
  Cards carry stars, name, a verified badge and a 3-line clamped quote.
{%- endcomment -%}

{%- capture star_svg -%}
<svg width="18" height="18" viewBox="0 0 24 24" fill="#FBBF24" stroke="#FBBF24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
{%- endcapture -%}

{%- capture verified_svg -%}
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
{%- endcapture -%}

{%- assign total = section.blocks.size -%}
{%- assign half = total | plus: 1 | divided_by: 2 -%}

<section class="scroll-reviews-section" aria-labelledby="reviews-scroll-heading"
  style="--review-speed: {{ section.settings.speed | default: 120 }}s;">

  <header class="scroll-reviews-header">
    <h2 id="reviews-scroll-heading" class="scroll-reviews-title">{{ section.settings.heading | default: 'DTF Transfer Reviews — Verified Feedback from Real Customers' }}</h2>
    <p class="scroll-reviews-sub">{{ section.settings.subheading | default: 'Verified Feedback from Authentic Customers' }}</p>
  </header>

  {%- for row in (1..2) -%}
    <div class="scroll-row-wrap">
      <div class="scroll-row {% if row == 1 %}scroll-left{% else %}scroll-right{% endif %}">
        {%- for pass in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if row == 1 and forloop.index > half -%}{%- continue -%}{%- endif -%}
            {%- if row == 2 and forloop.index <= half -%}{%- continue -%}{%- endif -%}
            <article class="scroll-card"{% if pass == 2 %} aria-hidden="true"{% endif %} {{ block.shopify_attributes }}>
              <header class="scroll-card-header">
                <div class="scroll-stars">
                  {%- assign rating = block.settings.rating | default: 5 -%}
                  {%- for i in (1..rating) -%}{{ star_svg }}{%- endfor -%}
                </div>
                <p class="scroll-name">{{ block.settings.name }}</p>
                <div class="scroll-verified">{{ verified_svg }}<span>Verified buyer</span></div>
              </header>
              <p class="scroll-text">"{{ block.settings.quote }}"</p>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endfor -%}

</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "DTF Transfer Reviews — Verified Feedback from Real Customers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Verified Feedback from Authentic Customers" },
    { "type": "range", "id": "speed", "label": "Scroll duration (s)", "min": 40, "max": 300, "step": 10, "default": 120 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "textarea", "id": "quote", "label": "Quote" },
