{%- comment -%}
  FAQs page — heading, search box, category tabs and an accordion grouped by
  category. Add a "Category" block, then the "Question" blocks that belong to
  it underneath. Tabs are built automatically from the Category blocks.
  CSS and JS live in this file.
{%- endcomment -%}

<style>
  .fq-page { padding: 40px 0 80px; background: #fff; }
  .fq-wrap { max-width: 1000px; margin: 0 auto; padding: 0 24px; }

  .fq-crumbs { display: flex; align-items: center; gap: 8px; margin: 0 0 18px; font-size: 0.85rem; color: #667085; }
  .fq-crumbs a { color: #0B3D2E; font-weight: 700; }
  .fq-crumbs a:hover { text-decoration: underline; }

  .fq-head { text-align: center; margin-bottom: 28px; }
  .fq-head h1 { font-size: clamp(1.9rem, 3.4vw, 2.7rem); font-weight: 900; letter-spacing: -0.02em; line-height: 1.12; color: #0B3D2E; margin: 0 0 12px; }
  .fq-head h1 span { background: #B6F000; padding: 0 8px; border-radius: 8px; }
  .fq-head p { max-width: 640px; margin: 0 auto; font-size: 1rem; line-height: 1.7; color: #475467; }
  .fq-head p a { color: #0B3D2E; font-weight: 700; text-decoration: underline; }

  .fq-search { position: relative; max-width: 560px; margin: 0 auto 22px; }
  .fq-search svg { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: #667085; pointer-events: none; }
  .fq-search input { width: 100%; padding: 14px 16px 14px 46px; border: 1px solid #D6DAE0; border-radius: 999px; background: #fff; font-family: inherit; font-size: 0.96rem; color: #101828; }
  .fq-search input:focus { outline: none; border-color: #B6F000; box-shadow: 0 0 0 3px rgba(182, 240, 0, 0.3); }

    .fq-tabs { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; margin-bottom: 34px; }
  .fq-tab { padding: 9px 14px; border: 1px solid #E5E7EB; border-radius: 999px; background: #fff; font-family: inherit; font-size: 0.82rem; font-weight: 700; color: #0B3D2E; cursor: pointer; white-space: nowrap; transition: background 0.15s, border-color 0.15s; }
  @media (min-width: 1040px) {
    .fq-tabs { flex-wrap: nowrap; margin-left: -40px; margin-right: -40px; }
  }
  .fq-tab:hover { border-color: #B6F000; }
  .fq-tab.is-active { background: #B6F000; border-color: #B6F000; color: #0B3D2E; }

  .fq-group { margin-bottom: 34px; }
  .fq-group[hidden] { display: none; }
  .fq-group-title { font-size: 1.3rem; font-weight: 900; letter-spacing: -0.01em; color: #0B3D2E; margin: 0 0 14px; }
  .fq-list { display: flex; flex-direction: column; gap: 12px; }

  .fq-item { border: 1px solid #E5E7EB; border-radius: 12px; background: #fff; overflow: hidden; box-shadow: 0 1px 4px rgba(16, 24, 40, 0.05); transition: box-shadow 0.2s, border-color 0.2s; }
  .fq-item:hover { box-shadow: 0 4px 12px rgba(16, 24, 40, 0.1); }
  .fq-item[hidden] { display: none; }
  .fq-item[open] { border-color: #B6F000; }
  .fq-item summary { display: flex; align-items: center; gap: 14px; padding: 18px 20px; cursor: pointer; list-style: none; font-size: 0.98rem; font-weight: 800; color: #0B3D2E; line-height: 1.4; }
  .fq-item summary::-webkit-details-marker { display: none; }
  .fq-item summary::before { content: ""; flex: 0 0 auto; align-self: stretch; width: 5px; margin: -18px 0 -18px -20px; background: #B6F000; }
  .fq-q { flex: 1; }
  .fq-chev { flex: 0 0 auto; display: flex; color: #667085; transition: transform 0.25s; }
  .fq-item[open] .fq-chev { transform: rotate(180deg); }
  .fq-a { padding: 0 20px 20px 20px; font-size: 0.93rem; line-height: 1.75; color: #475467; }
  .fq-a p { margin: 0 0 10px; }
  .fq-a p:last-child { margin-bottom: 0; }
  .fq-a ul, .fq-a ol { margin: 0 0 10px; padding-left: 22px; list-style: revert; }
  .fq-a li { margin-bottom: 4px; }
  .fq-a strong { color: #101828; }
  .fq-a a { color: #0B3D2E; font-weight: 700; text-decoration: underline; }

  .fq-empty { display: none; text-align: center; padding: 40px 16px; border: 1px dashed #D6DAE0; border-radius: 12px; margin-bottom: 34px; }
  .fq-empty.is-visible { display: block; }
  .fq-empty h3 { margin: 0 0 6px; font-size: 1.1rem; color: #0B3D2E; }
  .fq-empty p { margin: 0; color: #667085; font-size: 0.92rem; }

  .fq-cta { margin-top: 20px; padding: 36px 24px; text-align: center; border-radius: 16px; background: #E8F5E9; border: 1px solid #B6F000; }
  .fq-cta h2 { margin: 0 0 8px; font-size: 1.4rem; font-weight: 900; color: #0B3D2E; }
  .fq-cta p { margin: 0 0 20px; font-size: 0.95rem; color: #475467; }
  .fq-cta-btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .fq-btn { display: inline-flex; align-items: center; justify-content: center; padding: 13px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 800; transition: transform 0.15s; }
  .fq-btn--primary { background: #B6F000; color: #0B3D2E; }
  .fq-btn--ghost { background: #fff; color: #0B3D2E; border: 1px solid #0B3D2E; }

  @media (max-width: 640px) {
    .fq-page { padding: 24px 0 56px; }
    .fq-wrap { padding: 0 16px; }
    .fq-tabs { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin-left: -16px; margin-right: -16px; padding: 0 16px 4px; scrollbar-width: none; }
    .fq-tabs::-webkit-scrollbar { display: none; }
    .fq-tab { flex: 0 0 auto; white-space: nowrap; }
    .fq-item summary { padding: 15px 16px; font-size: 0.92rem; }
    .fq-item summary::before { margin: -15px 0 -15px -16px; }
    .fq-a { padding: 0 16px 16px; font-size: 0.88rem; }
    .fq-cta { padding: 28px 16px; }
    .fq-btn { width: 100%; max-width: 300px; }
  }
</style>

<section class="fq-page" data-faq>
  <div class="fq-wrap">

    <nav class="fq-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span>/</span><span>FAQs</span>
    </nav>

    <div class="fq-head">
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.intro != blank -%}
        <p>{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="fq-search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
      <input type="search" placeholder="Search questions..." aria-label="Search FAQs" data-faq-search>
    </div>

    <div class="fq-tabs" role="tablist">
      <button type="button" class="fq-tab is-active" data-faq-tab="all">All Categories</button>
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <button type="button" class="fq-tab" data-faq-tab="{{ block.settings.name | handleize }}">{{ block.settings.name }}</button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="fq-empty" data-faq-empty>
      <h3>No results found</h3>
      <p>Try different keywords or browse by category.</p>
    </div>

    {%- assign group_open = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'category' -%}
        {%- if group_open -%}</div></section>{%- endif -%}
        <section class="fq-group" data-faq-group data-cat="{{ block.settings.name | handleize }}">
          <h2 class="fq-group-title" {{ block.shopify_attributes }}>{{ block.settings.name }}</h2>
          <div class="fq-list">
        {%- assign group_open = true -%}
      {%- elsif block.type == 'faq' -%}
        <details class="fq-item" data-faq-item {{ block.shopify_attributes }}>
          <summary>
            <span class="fq-q">{{ block.settings.question }}</span>
            <span class="fq-chev"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span>
          </summary>
          <div class="fq-a">{{ block.settings.answer }}</div>
        </details>
      {%- endif -%}
    {%- endfor -%}
    {%- if group_open -%}</div></section>{%- endif -%}

    <div class="fq-cta">
      <h2>{{ section.settings.cta_heading }}</h2>
      <p>{{ section.settings.cta_text }}</p>
      <div class="fq-cta-btns">
        {%- if section.settings.cta_primary_label != blank -%}
          <a class="fq-btn fq-btn--primary" href="{{ section.settings.cta_primary_link | default: '/pages/contact-us' }}">{{ section.settings.cta_primary_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta_secondary_label != blank -%}
          <a class="fq-btn fq-btn--ghost" href="{{ section.settings.cta_secondary_link | default: '/collections' }}">{{ section.settings.cta_secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  var root = document.querySelector('[data-faq]');
  if (!root) return;

  var search = root.querySelector('[data-faq-search]');
  var tabs = root.querySelectorAll('[data-faq-tab]');
  var groups = root.querySelectorAll('[data-faq-group]');
  var empty = root.querySelector('[data-faq-empty]');
  var activeCat = 'all';

  function apply() {
    var q = (search.value || '').trim().toLowerCase();
    var anyVisible = false;

    groups.forEach(function (group) {
      var inCategory = activeCat === 'all' || group.getAttribute('data-cat') === activeCat;
      var groupHasMatch = false;

      group.querySelectorAll('[data-faq-item]').forEach(function (item) {
        var match = !q || item.textContent.toLowerCase().indexOf(q) !== -1;
        item.hidden = !match;
        if (match) groupHasMatch = true;
      });

      var show = inCategory && groupHasMatch;
      group.hidden = !show;
      if (show) anyVisible = true;
    });

    empty.classList.toggle('is-visible', !anyVisible);
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      activeCat = tab.getAttribute('data-faq-tab');
      tabs.forEach(function (t) { t.classList.toggle('is-active', t === tab); });
      apply();
    });
  });

  search.addEventListener('input', apply);
})();
</script>

{% schema %}
{
  "name": "FAQs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Find answers to common questions about our DTF transfers, ordering process, shipping, and more. Can't find what you're looking for? Contact our support team." },

    { "type": "header", "content": "Bottom call to action" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Still Have Questions?" },
    { "type": "text", "id": "cta_text", "label": "Text", "default": "Can't find the answer you're looking for? Please contact our support team." },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button label", "default": "Contact Support" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary button link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button label", "default": "Get a Quote" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "name", "label": "Category name", "default": "Ordering Process" }
      ]
    },
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Your question here?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Your answer here.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQs",
      "blocks": [
        { "type": "category", "settings": { "name": "Ordering Process" } },
        { "type": "faq", "settings": { "question": "How do I place an order for DTF transfers?", "answer": "<p>Upload your artwork, choose your transfer size and quantity, then proceed to checkout. You can also use our Gang Sheet Builder to fit several designs on one sheet.</p>" } },
        { "type": "faq", "settings": { "question": "Is there a minimum order quantity?", "answer": "<p>No. There are <strong>no minimums, setup fees or art fees</strong>. Order one transfer or thousands.</p>" } },
        { "type": "faq", "settings": { "question": "What file types can I upload?", "answer": "<p>We accept PNG, JPG, JPEG, SVG, PDF, AI, EPS, PSD, TIFF and WEBP files. For the sharpest results, upload artwork at 300 DPI at the final print size.</p>" } },

        { "type": "category", "settings": { "name": "Shipping & Delivery" } },
        { "type": "faq", "settings": { "question": "How fast do you ship?", "answer": "<p>Orders are printed in-house and ship within <strong>24 hours</strong>. Delivery time depends on the shipping option you choose at checkout.</p>" } },
        { "type": "faq", "settings": { "question": "Do you offer free shipping?", "answer": "<p>Yes, shipping is free on all transfer orders.</p>" } },

        { "type": "category", "settings": { "name": "Payment Options" } },
        { "type": "faq", "settings": { "question": "What payment methods do you accept?", "answer": "<p>We accept major credit and debit cards and digital wallets at checkout. Buy now, pay later options such as Shop Pay, Afterpay, Klarna, Sezzle and Affirm are available on eligible orders.</p>" } },
        { "type": "faq", "settings": { "question": "Do you offer volume discounts?", "answer": "<p>Yes. We count every transfer in your order, and the more you buy the more you save, with discounts of up to 50% per piece.</p>" } },

        { "type": "category", "settings": { "name": "Product Information" } },
        { "type": "faq", "settings": { "question": "What fabrics do DTF transfers work on?", "answer": "<p>DTF transfers work on cotton, polyester, blends, nylon, leather and most other fabrics, in any color.</p>" } },
        { "type": "faq", "settings": { "question": "How many washes will my transfers last?", "answer": "<p>Our transfers are certified for <strong>100+ washes</strong> when applied and cared for as directed.</p>" } },
        { "type": "faq", "settings": { "question": "How do I apply a DTF transfer?", "answer": "<ol><li>Pre-press the garment for a few seconds to remove moisture</li><li>Position the transfer and press with heat and firm pressure</li><li>Peel the film as directed on your order, then finish with a short second press</li></ol><p>Check your order paperwork for the exact temperature and time for your transfer type.</p>" } },

        { "type": "category", "settings": { "name": "Returns & Refunds" } },
        { "type": "faq", "settings": { "question": "What if there is a problem with my order?", "answer": "<p>Every order is backed by our <strong>100% Satisfaction Guarantee</strong>. If something isn't right, contact us and we will make it right.</p>" } },
        { "type": "faq", "settings": { "question": "Can I cancel or change my order?", "answer": "<p>Orders move into production quickly, so contact us as soon as possible and we will do our best to help before printing begins.</p>" } },

        { "type": "category", "settings": { "name": "Custom Design" } },
        { "type": "faq", "settings": { "question": "Can you help me create or fix my artwork?", "answer": "<p>Yes. Use our Design Studio or AI tools, or add Design Notes at checkout and our art team will review your file before printing, with no extra art fees.</p>" } },
        { "type": "faq", "settings": { "question": "Can I print logos or characters I don't own?", "answer": "<p>No. Please only upload artwork you own or have permission to use. Trademarked or copyrighted designs without a license cannot be printed.</p>" } }
      ]
    }
  ]
}
{% endschema %}
