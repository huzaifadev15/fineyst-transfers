      {%- assign sidebar_links = "Home,/|DTF Transfers,/products/dtf-transfers|Gang Sheet Builder,/products/uv-dtf-gang-sheet-builder|Blank Apparel,/collections/blank-apparel|Supplies,/collections/supplies|How It Works,/pages/how-it-works|FAQ,/pages/faq|Free Sample Pack,/pages/free-sample|Contact,/pages/contact-us" | split: "|" -%}
      {%- for link in sidebar_links -%}
        {%- assign lparts = link | split: "," -%}
        <a href="{{ lparts[1] }}" class="sidebar-link">{{ lparts[0] }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {%- endfor -%}
    </div>
    <div class="sidebar-footer">
      <p>Need Help?</p>
      <a href="tel:{{ section.settings.phone | default: '+18884997708' | remove: '-' | remove: ' ' }}">{{ section.settings.phone | default: '1-888-499-7708' }}</a>
      <span>Mon-Fri: 9AM - 5PM EST</span>
    </div>
  </div>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Search overlay -->
  <div class="search-overlay" id="searchOverlay" aria-hidden="true" role="dialog" aria-label="Search">
    <div class="search-overlay-header">
      <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" class="search-overlay-logo">
      <button class="search-close-btn" id="searchCloseBtn" aria-label="Close search">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div class="search-overlay-body">
      <div class="search-input-wrap">
        <svg class="search-icon-inside" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
        <input type="search" id="searchInput" class="search-input" placeholder="Search transfers, blanks, supplies…" autocomplete="off" aria-label="Search" spellcheck="false">
        <button type="button" class="search-submit-btn" id="searchSubmitBtn" aria-label="Submit search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>
      <div class="search-tabs" id="searchTabs">
        <button class="search-tab active" data-filter="all" id="tabAll">All (0)</button>
        <button class="search-tab" data-filter="product" id="tabProducts">Products (0)</button>
        <button class="search-tab" data-filter="page" id="tabPages">Pages (0)</button>
      </div>
      <div class="search-results" id="searchResults">
        <div class="search-empty">Start typing to search…</div>
      </div>
    </div>
    <div class="search-overlay-footer">
      <span class="search-esc-hint">Press ESC to close</span>
      <a href="/collections/all" class="search-browse-all">Browse All Products &rarr;</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "default": "FREE SHIPPING ON ALL TRANSFER ORDERS — PRINTED & SHIPPED IN 24 HOURS" },
    { "type": "url", "id": "cta_link", "label": "Header CTA link" },
    { "type": "text", "id": "phone", "label": "Support phone", "default": "1-888-499-7708" }
  ]
}
{% endschema %}
