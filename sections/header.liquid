{%- comment -%}
  Header — structure ported from Fineyst Patches (fixed dark bar, centered nav,
  hover mega menus, capsule category bar, mobile sidebar, search overlay).
  Content and palette are Fineyst Transfers / Ninja-style.
{%- endcomment -%}

<header class="site-header">
  <div class="topbar">
    {{ section.settings.announcement | default: 'FREE SHIPPING ON ALL TRANSFER ORDERS — PRINTED &amp; SHIPPED IN 24 HOURS' }}
  </div>

  <div class="navbar-bg">
    <div class="navbar-inner">

      <!-- Mobile: hamburger -->
      <div class="mobile-only">
        <button class="hamburger-btn" id="mobileMenuOpen" aria-label="Open menu">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16"/><path d="M4 18h16"/><path d="M4 6h16"/></svg>
        </button>
      </div>

      <!-- Logo -->
      <div class="logo-wrap">
        <a href="/" class="logo">
          <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" width="260" height="46" class="navbar-logo">
        </a>
      </div>

      <!-- Mobile: cart -->
      <div class="mobile-only mobile-cart">
        <a href="{{ routes.cart_url }}" class="icon-btn cart-icon-link" aria-label="Cart">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count-badge" aria-label="{{ cart.item_count }} items in cart">{% if cart.item_count > 99 %}99+{% else %}{{ cart.item_count }}{% endif %}</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Desktop nav -->
      <nav class="desktop-nav" aria-label="Main navigation">

        <!-- DTF TRANSFERS -->
        <div class="mega-wrap">
          <div class="nav-item has-mega">
            <button class="nav-link">DTF TRANSFERS
