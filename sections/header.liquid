{%- comment -%}
  Header — structure ported from Fineyst Patches (fixed dark bar, centered nav,
  hover mega menus, capsule category bar, mobile sidebar, search overlay).
  Content and palette are Fineyst Transfers / Ninja-style.
{%- endcomment -%}

<header class="site-header">
  <div class="topbar">
    {{ section.settings.announcement | default: 'FREE SHIPPING ON ALL TRANSFER ORDERS — PRINTED &amp; SHIPPED IN 24 HOURS' }}
  </div>

  <div class="navbar-bg">
    <div class="navbar-inner">

      <!-- Mobile: hamburger -->
      <div class="mobile-only">
        <button class="hamburger-btn" id="mobileMenuOpen" aria-label="Open menu">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16"/><path d="M4 18h16"/><path d="M4 6h16"/></svg>
        </button>
      </div>

      <!-- Logo -->
      <div class="logo-wrap">
        <a href="/" class="logo">
          <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" width="260" height="46" class="navbar-logo">
        </a>
      </div>

      <!-- Mobile: cart -->
      <div class="mobile-only mobile-cart">
        <a href="{{ routes.cart_url }}" class="icon-btn cart-icon-link" aria-label="Cart">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count-badge" aria-label="{{ cart.item_count }} items in cart">{% if cart.item_count > 99 %}99+{% else %}{{ cart.item_count }}{% endif %}</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Desktop nav -->
      <nav class="desktop-nav" aria-label="Main navigation">

        <!-- DTF TRANSFERS -->
        <div class="mega-wrap">
          <div class="nav-item has-mega">
            <button class="nav-link">DTF TRANSFERS
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <div class="mega-menu mega-menu--compact">
            <div class="mega-inner">
              <div class="mega-section-label">Custom DTF Transfers</div>
              <div class="mega-cards mega-cards--stack">
                <a href="/products/dtf-transfers" class="mega-card mega-card--row">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-1.jpg' | asset_url }})"></span>
                  <span class="mega-card-body">
                    <span class="mega-card-badge mega-card-badge--blue">Most Popular</span>
                    <span class="mega-card-title">Transfers by Size</span>
                    <p>Upload any design, press on any material</p>
                  </span>
                </a>
                <a href="/products/build-your-own-gang-sheet" class="mega-card mega-card--row">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-2.jpg' | asset_url }})"></span>
                  <span class="mega-card-body">
                    <span class="mega-card-badge mega-card-badge--green">All Skill Levels</span>
                    <span class="mega-card-title">Build a Gang Sheet</span>
                    <p>Design and arrange online</p>
                  </span>
                </a>
                <a href="/products/premium-dtf-gang-sheets" class="mega-card mega-card--row">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-3.jpg' | asset_url }})"></span>
                  <span class="mega-card-body">
                    <span class="mega-card-badge mega-card-badge--yellow">For Pros</span>
                    <span class="mega-card-title">Upload a Gang Sheet</span>
                    <p>Upload a print-ready file</p>
                  </span>
                </a>
              </div>
              <div class="mega-footer">
                <span>No minimums · No setup fees · 24-hour production</span>
                <a href="/collections/dtf-transfers">Shop All Transfers &rarr;</a>
              </div>
            </div>
          </div>
        </div>

        <!-- UV DTF PERMASTICKERS -->
        <div class="mega-wrap">
          <div class="nav-item has-mega">
            <button class="nav-link">UV DTF PERMASTICKERS
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <div class="mega-menu mega-menu--compact">
            <div class="mega-inner">
              <div class="mega-section-label">UV DTF PermaStickers</div>
              <div class="mega-cards mega-cards--stack">
                <a href="/collections/uv-dtf" class="mega-card mega-card--row">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-1.jpg' | asset_url }})"></span>
                  <span class="mega-card-body">
                    <span class="mega-card-badge mega-card-badge--blue">Most Popular</span>
                    <span class="mega-card-title">UV DTF PermaStickers by Size</span>
                    <p>Upload any design. Press on any hard good</p>
                  </span>
                </a>
                <a href="/pages/gang-sheet-builder" class="mega-card mega-card--row">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-2.jpg' | asset_url }})"></span>
                  <span class="mega-card-body">
                    <span class="mega-card-badge mega-card-badge--green">All Skill Levels</span>
                    <span class="mega-card-title">Build a UV DTF Gang Sheet</span>
                    <p>Easily design &amp; build online</p>
                  </span>
                </a>
                <a href="/products/premium-dtf-gang-sheets" class="mega-card mega-card--row">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-3.jpg' | asset_url }})"></span>
                  <span class="mega-card-body">
                    <span class="mega-card-badge mega-card-badge--yellow">For Pros</span>
                    <span class="mega-card-title">Upload a UV DTF Gang Sheet</span>
                    <p>Upload a print-ready file</p>
                  </span>
                </a>
              </div>
              <div class="mega-footer">
                <span>No minimums · No setup fees · 24-hour production</span>
                <a href="/collections/uv-dtf">Shop All UV DTF &rarr;</a>
              </div>
            </div>
          </div>
        </div>

        <!-- BLANK APPAREL -->
        <div class="mega-wrap">
          <div class="nav-item has-mega">
            <button class="nav-link">BLANK APPAREL
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <div class="mega-menu">
            <div class="mega-inner">
              <div class="mega-cols mega-cols--5">
                <div class="mega-col">
                  <div class="mega-col-hd">T-Shirts</div>
                  <ul>
                    <li><a href="/collections/short-sleeve">Short Sleeve</a></li>
                    <li><a href="/collections/long-sleeve">Long Sleeve</a></li>
                    <li><a href="/collections/three-quarter-sleeve">3/4 Sleeve</a></li>
                    <li><a href="/collections/raglan-t-shirts">Raglan T-Shirts</a></li>
                    <li><a href="/collections/pocket-t-shirts">Pocket T-Shirts</a></li>
                    <li><a href="/collections/performance-shirts">Performance Shirts</a></li>
                    <li><a href="/collections/tank-tops">Tank Tops</a></li>
                    <li><a href="/collections/crop-tops">Crop Tops</a></li>
                    <li><a href="/collections/tie-dye">Tie-Dye</a></li>
                    <li><a href="/collections/woven-shirts">Woven Shirts</a></li>
                  </ul>
                </div>
                <div class="mega-col">
                  <div class="mega-col-hd">Hoodies</div>
                  <ul>
                    <li><a href="/collections/crewnecks">Crewnecks</a></li>
                    <li><a href="/collections/pullover-hoodies">Pullover Hoodies</a></li>
                    <li><a href="/collections/full-zip-hoodies">Full-Zip Hoodies</a></li>
                    <li><a href="/collections/multicolored-hoodies">Multicolored Hoodies</a></li>
                    <li><a href="/collections/eco-friendly">Eco-Friendly</a></li>
                  </ul>
                </div>
                <div class="mega-col">
                  <div class="mega-col-hd">Hats</div>
                  <ul>
                    <li><a href="/collections/baseball-caps">Baseball Caps</a></li>
                    <li><a href="/collections/performance-hats">Performance Hats</a></li>
                    <li><a href="/collections/beanies">Beanies</a></li>
                    <li><a href="/collections/trucker-hats">Trucker Hats</a></li>
                    <li><a href="/collections/snapback-hats">Snapback Hats</a></li>
                    <li><a href="/collections/5-panel">5-Panel</a></li>
                    <li><a href="/collections/6-panel">6-Panel</a></li>
                    <li><a href="/collections/bandanas">Bandanas</a></li>
                  </ul>
                </div>
                <div class="mega-col">
                  <div class="mega-col-hd">Categories</div>
                  <ul>
                    <li><a href="/collections/accessories">Accessories</a></li>
                    <li><a href="/collections/drinkware-hard-goods">Drinkware &amp; Hard Goods</a></li>
                    <li><a href="/collections/bags">Bags</a></li>
                    <li><a href="/collections/infant-toddler">Infant &amp; Toddler</a></li>
                    <li><a href="/collections/kids">Kids</a></li>
                    <li><a href="/collections/outerwear">Outerwear</a></li>
                    <li><a href="/collections/pants">Pants</a></li>
                    <li><a href="/collections/polos">Polos</a></li>
                    <li><a href="/collections/shorts">Shorts</a></li>
                    <li><a href="/collections/women">Women</a></li>
                  </ul>
                </div>
                <div class="mega-col">
                  <div class="mega-col-hd">Brands</div>
                  <ul>
                    <li><a href="/collections/bella-canvas">Bella + Canvas</a></li>
                    <li><a href="/collections/big-accessories">Big Accessories</a></li>
                    <li><a href="/collections/champion">Champion</a></li>
                    <li><a href="/collections/comfort-colors">Comfort Colors</a></li>
                    <li><a href="/collections/gildan">Gildan</a></li>
                    <li><a href="/collections/hanes">Hanes</a></li>
                    <li><a href="/collections/jerzees">Jerzees</a></li>
                    <li><a href="/collections/nautica">Nautica</a></li>
                    <li><a href="/collections/next-level">Next Level</a></li>
                  </ul>
                </div>
              </div>
              <div class="mega-footer mega-footer--banner">
                <span class="mega-footer-note">
                  <svg class="mega-footer-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  <strong>FREE SHIPPING</strong>&nbsp;on blank apparel orders $59+
                </span>
                <a href="/collections/blank-apparel" class="mega-footer-btn">Shop All Blank Apparel &rarr;</a>
              </div>
            </div>
          </div>
        </div>

        <!-- SUPPLIES -->
        <div class="mega-wrap">
          <div class="nav-item has-mega">
            <button class="nav-link">SUPPLIES
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <div class="mega-menu">
            <div class="mega-inner">
              <div class="mega-section-label">Pressing Supplies</div>
              <div class="mega-cards mega-cards--grid">
                <a href="/products/heat-press" class="mega-card mega-card--small">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-4.jpg' | asset_url }})"></span>
                  <span class="mega-card-title">Heat Presses</span>
                </a>
                <a href="/products/pressing-sheet" class="mega-card mega-card--small">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-5.avif' | asset_url }})"></span>
                  <span class="mega-card-title">Pressing Sheets</span>
                </a>
                <a href="/products/heat-tape" class="mega-card mega-card--small">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-6.avif' | asset_url }})"></span>
                  <span class="mega-card-title">Heat Tape</span>
                </a>
                <a href="/products/placement-guide" class="mega-card mega-card--small">
                  <span class="mega-card-thumb" style="background-image:url({{ 'dtf-8.avif' | asset_url }})"></span>
                  <span class="mega-card-title">Placement Guides</span>
                </a>
              </div>
              <div class="mega-footer">
                <span>Buy 3 supplies, get 10% off</span>
                <a href="/collections/supplies">Shop All Supplies &rarr;</a>
              </div>
            </div>
          </div>
        </div>

        <div class="nav-item"><a href="/pages/how-it-works" class="nav-link">HOW IT WORKS</a></div>
        <div class="nav-item"><a href="/pages/faq" class="nav-link">FAQ</a></div>

        <!-- SUPPORT & TOOLS -->
        <div class="mega-wrap">
          <div class="nav-item has-mega">
            <button class="nav-link">SUPPORT &amp; TOOLS
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chevron" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
            </button>
          </div>
          <div class="mega-menu">
            <div class="mega-inner">
              <div class="mega-cols">
                <div class="mega-col">
                  <div class="mega-col-hd">Help</div>
                  <ul>
                    <li><a href="/pages/contact-us">Contact Us</a></li>
                    <li><a href="/pages/submit-an-order-issue">Submit an Order Issue</a></li>
                    <li><a href="/pages/shipping">Shipping &amp; Turnaround</a></li>
                  </ul>
                </div>
                <div class="mega-col">
                  <div class="mega-col-hd">Learn</div>
                  <ul>
                    <li><a href="/pages/pressing-instructions">Pressing Instructions</a></li>
                    <li><a href="/pages/how-it-works">How It Works</a></li>
                    <li><a href="/pages/faq">FAQ</a></li>
                  </ul>
                </div>
                <div class="mega-col">
                  <div class="mega-col-hd">Design Tools</div>
                  <ul>
                    <li><a href="/pages/gang-sheet-builder">Gang Sheet Builder</a></li>
                    <li><a href="/pages/design-library">Design Library</a></li>
                    <li><a href="/pages/art-guidelines">Art Guidelines</a></li>
                  </ul>
                </div>
                <div class="mega-col">
                  <div class="mega-col-hd">Explore</div>
                  <ul>
                    <li><a href="/pages/rewards">Fineyst Perks</a></li>
                    <li><a href="/pages/about-us">About Us</a></li>
                    <li><a href="/pages/reviews">Reviews</a></li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>

      <!-- Right actions -->
      <div class="header-actions">
        <div class="quote-wrap">
          <div class="quote-glow"></div>
          <a href="{{ section.settings.cta_link | default: '/pages/free-samples' }}" class="btn-quote">
            <div class="btn-quote-inner">
              <span class="quote-free">FREE</span>
              <span class="quote-dark">SAMPLE
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="quote-arrow" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </span>
            </div>
          </a>
        </div>
        <button class="icon-btn" aria-label="Search" id="searchToggleBtn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
        </button>
        <a href="{{ routes.account_login_url }}" class="icon-btn" aria-label="Account">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
        <a href="{{ routes.cart_url }}" class="icon-btn cart-icon-link" aria-label="Cart">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          {%- if cart.item_count > 0 -%}
            <span class="cart-count-badge" aria-label="{{ cart.item_count }} items in cart">{% if cart.item_count > 99 %}99+{% else %}{{ cart.item_count }}{% endif %}</span>
          {%- endif -%}
        </a>
      </div>
    </div>

    <!-- Capsule category tabs -->
    <div class="capsule-bar">
      <div class="capsule-tabs-wrap">
        <div class="capsule-tabs-scroll" id="capsuleTabsScroll">
          <div class="capsule-tabs-inner">
            {%- assign tab_links = "By Size,/products/dtf-transfers|Gang Sheets,/pages/gang-sheet-builder|UV DTF,/collections/uv-dtf|Puff,/collections/puff-transfers|Glitter,/collections/glitter-transfers|Reflective,/collections/reflective-transfers|Sublimation,/collections/sublimation|Blanks,/collections/blank-apparel|Supplies,/collections/supplies" | split: "|" -%}
            {%- for tab in tab_links -%}
              {%- assign tparts = tab | split: "," -%}
              <a href="{{ tparts[1] }}" class="capsule-tab{% if request.path == tparts[1] %} is-active{% endif %}"{% if request.path == tparts[1] %} aria-current="page"{% endif %}>{{ tparts[0] }}</a>
            {%- endfor -%}
          </div>
        </div>
        <button class="capsule-tab-arrow" id="capsuleTabArrow" aria-label="Scroll tabs right">
          <span class="capsule-arrow-inner">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile sidebar -->
  <div class="mobile-sidebar" id="mobileSidebar">
    <div class="sidebar-header">
      <a href="/">
        <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" width="200" height="34" class="navbar-logo">
      </a>
      <button class="sidebar-close" id="mobileMenuClose" aria-label="Close menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div class="sidebar-body">
      {%- assign sidebar_links = "Home,/|DTF Transfers,/products/dtf-transfers|Gang Sheet Builder,/pages/gang-sheet-builder|Blank Apparel,/collections/blank-apparel|Supplies,/collections/supplies|How It Works,/pages/how-it-works|FAQ,/pages/faq|Free Sample Pack,/pages/free-samples|Contact,/pages/contact-us" | split: "|" -%}
      {%- for link in sidebar_links -%}
        {%- assign lparts = link | split: "," -%}
        <a href="{{ lparts[1] }}" class="sidebar-link">{{ lparts[0] }}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      {%- endfor -%}
    </div>
    <div class="sidebar-footer">
      <p>Need Help?</p>
      <a href="tel:{{ section.settings.phone | default: '+18884997708' | remove: '-' | remove: ' ' }}">{{ section.settings.phone | default: '1-888-499-7708' }}</a>
      <span>Mon-Fri: 9AM - 5PM EST</span>
    </div>
  </div>
  <div class="sidebar-overlay" id="sidebarOverlay"></div>

  <!-- Search overlay -->
  <div class="search-overlay" id="searchOverlay" aria-hidden="true" role="dialog" aria-label="Search">
    <div class="search-overlay-header">
      <img src="{{ 'logo.svg' | asset_url }}" alt="{{ shop.name }}" class="search-overlay-logo">
      <button class="search-close-btn" id="searchCloseBtn" aria-label="Close search">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
    <div class="search-overlay-body">
      <div class="search-input-wrap">
        <svg class="search-icon-inside" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/></svg>
        <input type="search" id="searchInput" class="search-input" placeholder="Search transfers, blanks, supplies…" autocomplete="off" aria-label="Search" spellcheck="false">
        <button type="button" class="search-submit-btn" id="searchSubmitBtn" aria-label="Submit search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </button>
      </div>
      <div class="search-tabs" id="searchTabs">
        <button class="search-tab active" data-filter="all" id="tabAll">All (0)</button>
        <button class="search-tab" data-filter="product" id="tabProducts">Products (0)</button>
        <button class="search-tab" data-filter="page" id="tabPages">Pages (0)</button>
      </div>
      <div class="search-results" id="searchResults">
        <div class="search-empty">Start typing to search…</div>
      </div>
    </div>
    <div class="search-overlay-footer">
      <span class="search-esc-hint">Press ESC to close</span>
      <a href="/collections/all" class="search-browse-all">Browse All Products &rarr;</a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement bar text", "default": "FREE SHIPPING ON ALL TRANSFER ORDERS — PRINTED & SHIPPED IN 24 HOURS" },
    { "type": "url", "id": "cta_link", "label": "Header CTA link" },
    { "type": "text", "id": "phone", "label": "Support phone", "default": "1-888-499-7708" }
  ]
}
{% endschema %}
