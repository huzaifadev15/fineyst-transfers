{%- comment -%}
  PDP Related — "Shop More Popular Products": a 4-up grid of specialty transfer
  cards, each with an image, title, one-line description, price and ship note,
  and a full-width blue CTA. Mirrors the Ninja Transfers PDP block.
{%- endcomment -%}

<section class="pdp-related">
  <div class="pdp-related-inner">
    <h2 class="pdp-related-title">{{ section.settings.heading | default: 'Shop More Popular Products' }}</h2>

    <div class="pdp-related-grid">
      {%- for block in section.blocks -%}
        {%- assign rel_product = all_products[block.settings.handle] -%}
        {%- assign rel_image = rel_product.featured_image | default: rel_product.images.first -%}
        {%- if rel_product != blank -%}
          {%- assign rel_url = rel_product.url -%}
        {%- else -%}
          {%- assign rel_url = block.settings.handle | prepend: '/products/' -%}
        {%- endif -%}
        <article class="pdp-related-card" {{ block.shopify_attributes }}>
          <a class="pdp-related-media" href="{{ rel_url }}" aria-label="{{ block.settings.title }}">
            {%- if rel_image != blank -%}
              {{ rel_image | image_url: width: 600, height: 600, crop: 'center' | image_tag: loading: 'lazy', alt: block.settings.title, width: 300, height: 300 }}
            {%- else -%}
              <img src="{{ block.settings.static_image | strip | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="300" height="300">
            {%- endif -%}
          </a>
          <div class="pdp-related-body">
            <h3 class="pdp-related-name"><a href="{{ rel_url }}">{{ block.settings.title }}</a></h3>
            <p class="pdp-related-desc">{{ block.settings.text }}</p>
            <p class="pdp-related-price">{{ block.settings.price }}</p>
            <p class="pdp-related-ships">{{ block.settings.ships }}</p>
            <a class="pdp-related-btn" href="{{ rel_url }}">{{ block.settings.cta | default: 'Shop Now' }}</a>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP Related Products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop More Popular Products" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Product",
      "settings": [
        { "type": "text", "id": "handle", "label": "Product handle" },
        { "type": "text", "id": "static_image", "label": "Fallback image file", "info": "Filename in /assets, used until the product has an image." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Description" },
        { "type": "text", "id": "price", "label": "Price line" },
        { "type": "text", "id": "ships", "label": "Ship note" },
        { "type": "text", "id": "cta", "label": "Button label" }
      ]
    }
  ],
  "presets": [
    {
