{%- comment -%}
  Contact Us — left: heading, intro and contact details; right: message form.
  Uses Shopify's built-in contact form, so messages arrive at the store email
  (Settings > Notifications > Customer contact). All CSS lives in this file.
{%- endcomment -%}

<style>
  .ct-page { padding: 48px 0 80px; background: #fff; }
  .ct-inner { max-width: 1180px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); gap: 56px; align-items: start; }

  .ct-info h1 { font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 900; letter-spacing: -0.02em; line-height: 1.1; color: #0B3D2E; margin: 0 0 18px; }
  .ct-info h1 span { background: #B6F000; padding: 0 8px; border-radius: 8px; }
  .ct-intro { font-size: 1rem; line-height: 1.7; color: #475467; margin: 0 0 14px; }
  .ct-intro a { color: #0B3D2E; font-weight: 700; text-decoration: underline; }

  .ct-list { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .ct-list li a { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border: 1px solid #E5E7EB; border-radius: 12px; background: #fff; color: #0B3D2E; font-size: 0.98rem; font-weight: 700; transition: border-color 0.15s, background 0.15s; }
  .ct-list li a:hover { border-color: #B6F000; background: #E8F5E9; }
  .ct-ic { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 10px; background: #E8F5E9; color: #0B3D2E; }
  .ct-hours { margin: 18px 0 0; font-size: 0.88rem; color: #667085; }

  .ct-card { background: #fff; border: 1px solid #E5E7EB; border-radius: 16px; box-shadow: 0 6px 24px rgba(16, 24, 40, 0.08); padding: 32px; }
  .ct-card h2 { font-size: 1.5rem; font-weight: 900; letter-spacing: -0.01em; color: #0B3D2E; margin: 0 0 8px; }
  .ct-card-sub { margin: 0 0 22px; font-size: 0.92rem; line-height: 1.6; color: #667085; }

  .ct-alert { margin: 0 0 20px; padding: 14px 16px; border-radius: 10px; font-size: 0.9rem; font-weight: 600; line-height: 1.5; }
  .ct-alert--ok { background: #E8F5E9; border: 1px solid #B6F000; color: #0B3D2E; }
  .ct-alert--err { background: #FDECEF; border: 1px solid #F5C2CE; color: #C92A2A; }

  .ct-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ct-field { margin-bottom: 16px; }
  .ct-field label { display: block; margin-bottom: 6px; font-size: 0.85rem; font-weight: 700; color: #0B3D2E; }
  .ct-field input,
  .ct-field select,
  .ct-field textarea { width: 100%; padding: 12px 14px; border: 1px solid #D6DAE0; border-radius: 10px; background: #fff; font-family: inherit; font-size: 0.95rem; color: #101828; }
  .ct-field textarea { min-height: 130px; resize: vertical; }
  .ct-field input:focus,
  .ct-field select:focus,
  .ct-field textarea:focus { outline: none; border-color: #B6F000; box-shadow: 0 0 0 3px rgba(182, 240, 0, 0.3); }
  .ct-phone { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 10px; }

  .ct-consent { display: flex; align-items: flex-start; gap: 10px; margin: 4px 0 20px; font-size: 0.84rem; line-height: 1.5; color: #475467; cursor: pointer; }
  .ct-consent input { flex: 0 0 auto; width: 18px; height: 18px; margin-top: 2px; accent-color: #0B3D2E; }
  .ct-consent a { color: #0B3D2E; font-weight: 700; text-decoration: underline; }

  .ct-submit { display: block; width: 100%; padding: 15px 24px; border: none; border-radius: 10px; background: #B6F000; color: #0B3D2E; font-family: inherit; font-size: 1rem; font-weight: 800; cursor: pointer; transition: background 0.15s; }

  @media (max-width: 900px) {
    .ct-inner { grid-template-columns: 1fr; gap: 32px; padding: 0 16px; }
    .ct-page { padding: 28px 0 56px; }
    .ct-card { padding: 22px 18px; }
  }
  @media (max-width: 480px) {
    .ct-row { grid-template-columns: 1fr; gap: 0; }
  }
</style>

<section class="ct-page">
  <div class="ct-inner">

    <div class="ct-info">
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.intro_1 != blank -%}<p class="ct-intro">{{ section.settings.intro_1 }}</p>{%- endif -%}
      {%- if section.settings.intro_2 != blank -%}<p class="ct-intro">{{ section.settings.intro_2 }}</p>{%- endif -%}

      <ul class="ct-list">
        {%- if section.settings.address != blank -%}
          <li>
            <a href="https://www.google.com/maps/search/?api=1&query={{ section.settings.address | url_encode }}" target="_blank" rel="noopener">
              <span class="ct-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg></span>
              {{ section.settings.address }}
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <li>
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}">
              <span class="ct-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg></span>
              {{ section.settings.phone }}
            </a>
          </li>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <li>
            <a href="mailto:{{ section.settings.email }}">
              <span class="ct-ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
              {{ section.settings.email }}
            </a>
          </li>
        {%- endif -%}
      </ul>

      {%- if section.settings.hours != blank -%}
        <p class="ct-hours">{{ section.settings.hours }}</p>
      {%- endif -%}
    </div>

    <div class="ct-card" id="contact-form">
      <h2>{{ section.settings.form_heading }}</h2>
      <p class="ct-card-sub">{{ section.settings.form_sub }}</p>

      {%- form 'contact', id: 'ContactForm' -%}

        {%- if form.posted_successfully? -%}
          <div class="ct-alert ct-alert--ok" role="status">{{ section.settings.success_text }}</div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="ct-alert ct-alert--err" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="ct-row">
          <div class="ct-field">
            <label for="ct-first">First Name</label>
            <input id="ct-first" type="text" name="contact[First Name]" autocomplete="given-name" required value="{{ form.first_name }}">
          </div>
          <div class="ct-field">
            <label for="ct-last">Last Name</label>
            <input id="ct-last" type="text" name="contact[Last Name]" autocomplete="family-name" required value="{{ form.last_name }}">
          </div>
        </div>

        <div class="ct-field">
          <label for="ct-email">Email Address</label>
          <input id="ct-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
        </div>

        <div class="ct-field">
          <label for="ct-phone">Phone Number</label>
          <div class="ct-phone">
            <select name="contact[Country Code]" aria-label="Country code">
              <option>+1</option>
              <option>+44</option>
              <option>+61</option>
              <option>+49</option>
              <option>+33</option>
              <option>+81</option>
              <option>+86</option>
              <option>+91</option>
              <option>+92</option>
              <option>+55</option>
              <option>+52</option>
              <option>+34</option>
              <option>+39</option>
              <option>+31</option>
              <option>+65</option>
              <option>+971</option>
            </select>
            <input id="ct-phone" type="tel" name="contact[Phone]" autocomplete="tel-national" value="{{ form.phone }}">
          </div>
        </div>

        <div class="ct-field">
          <label for="ct-message">Message</label>
          <textarea id="ct-message" name="contact[body]" required>{{ form.body }}</textarea>
        </div>

        <label class="ct-consent">
          <input type="checkbox" name="contact[Consent]" value="Agreed" required>
          <span>I agree to the <a href="{{ section.settings.privacy_url | default: '/pages/privacy-policy' }}">Privacy Policy</a> and consent to being contacted regarding my inquiry.</span>
        </label>

        <button type="submit" class="ct-submit">Send Message</button>

      {%- endform -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Contact Us",
  "settings": [
    { "type": "header", "content": "Left side" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Fineyst Transfers" },
    { "type": "textarea", "id": "intro_1", "label": "Intro paragraph 1", "default": "Have questions? Need a quote? Want to start your custom transfers order? We're here to help and we respond fast." },
    { "type": "textarea", "id": "intro_2", "label": "Intro paragraph 2", "default": "Whether you're placing a large B2B order, requesting samples, or just exploring your options, our team is ready to assist." },
    { "type": "text", "id": "address", "label": "Address", "default": "122 Henderson Rd, Sandy Creek, NY 13145, USA" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "+1-888-499-7708" },
    { "type": "text", "id": "email", "label": "Email", "default": "info@fineystpatches.com" },
    { "type": "text", "id": "hours", "label": "Hours note", "default": "Mon-Sat: 9:00am - 6:00pm EST · Sun: Closed" },

    { "type": "header", "content": "Form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send Us a Message" },
    { "type": "textarea", "id": "form_sub", "label": "Form subtext", "default": "Have a custom transfer idea in mind? Fill out the form below and our team will get back to you within 24 hours." },
    { "type": "textarea", "id": "success_text", "label": "Success message", "default": "Thank you for reaching out to us. We've received your message and will get back to you as soon as possible." },
    { "type": "url", "id": "privacy_url", "label": "Privacy Policy link" }
  ],
  "presets": [
    { "name": "Contact Us" }
  ]
}
{% endschema %}
