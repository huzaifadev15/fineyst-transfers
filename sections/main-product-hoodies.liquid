  /* Fixed 28px tracks — with 1fr the swatches stretched into rectangles. */
  .pdp-color-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .pdp-color-swatch { position: relative; flex: 0 0 28px; width: 28px; height: 28px; border-radius: 8px; border: 1px solid #B1B1B1; padding: 0; cursor: pointer; transition: transform .1s, box-shadow .1s; display: flex; align-items: center; justify-content: center; }
  .pdp-color-swatch:hover { transform: scale(1.08); }
  .pdp-color-swatch.is-active { box-shadow: 0 0 0 2px #fff, 0 0 0 2px var(--nt-blue); }
  .pdp-color-check { opacity: 0; color: #111827; filter: drop-shadow(0 0 2px rgba(255,255,255,0.9)); }
  .pdp-color-swatch.is-active .pdp-color-check { opacity: 1; }

  .pdp-buy-panel { background: var(--nt-surface); border-radius: 10px; padding: 20px; }
