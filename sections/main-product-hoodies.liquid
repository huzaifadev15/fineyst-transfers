{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign image_count = product.images.size
  assign swatches = product.metafields.custom.swatch_colors.value
  assign color_index = -1
  assign size_index = -1
-%}

{%- comment -%} Locate Color / Size options by name so the grid works regardless
of the order Shopify stored them in. {%- endcomment -%}
{%- for opt in product.options_with_values -%}
  {%- assign nm = opt.name | downcase -%}
  {%- if nm == 'color' -%}{%- assign color_index = forloop.index0 -%}{%- endif -%}
  {%- if nm == 'size' -%}{%- assign size_index = forloop.index0 -%}{%- endif -%}
{%- endfor -%}

{%- if color_index >= 0 -%}
  {%- assign color_option = product.options_with_values[color_index] -%}
  {%- assign selected_color = current_variant.options[color_index] -%}
{%- endif -%}

{%- comment -%} White vs coloured pricing, derived from the real variant prices
rather than hard-coded. {%- endcomment -%}
{%- assign white_min = 2147483647 -%}
{%- assign white_cmp = 0 -%}
{%- assign colors_min = 2147483647 -%}
{%- assign colors_cmp = 0 -%}
{%- for v in product.variants -%}
  {%- assign cname = '' -%}
  {%- if color_index >= 0 -%}{%- assign cname = v.options[color_index] | downcase -%}{%- endif -%}
  {%- if cname contains 'white' -%}
    {%- if v.price < white_min -%}
      {%- assign white_min = v.price -%}
      {%- assign white_cmp = v.compare_at_price | default: 0 -%}
    {%- endif -%}
  {%- else -%}
    {%- if v.price < colors_min -%}
      {%- assign colors_min = v.price -%}
      {%- assign colors_cmp = v.compare_at_price | default: 0 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{%- comment -%} Facet metafields are list.single_line_text_field — they need
.value and a join, otherwise they render as raw JSON. {%- endcomment -%}
{%- assign fabric_txt = product.metafields.custom.fabric.value | join: ', ' -%}
{%- assign weight_txt = product.metafields.custom.weight.value | join: ', ' -%}
{%- assign fit_txt = product.metafields.custom.fit.value | join: ', ' -%}

<section class="main-product-hoodies pdp" data-section-id="{{ section.id }}">

  {%- if section.settings.show_info_strip -%}
    <div class="pdp-topstrip">
      <div class="container pdp-topstrip-inner">
        <span class="pdp-topstrip-item pdp-topstrip-item--accent">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {{ section.settings.strip_1 | default: 'Order by 5PM, Receive it Tomorrow' }}
        </span>
        <span class="pdp-topstrip-item">{{ section.settings.strip_2 | default: 'Free Shipping at $99' }}</span>
        <span class="pdp-topstrip-item">{{ section.settings.strip_3 | default: 'Free 45-Day Returns' }}</span>
        <span class="pdp-topstrip-item">{{ section.settings.strip_4 | default: 'No Minimums' }}</span>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ================= Buy box ================= {%- endcomment -%}
  <div class="container pdp-inner">

    <div class="pdp-media">
      <div class="product-gallery" data-gallery>
        {%- if section.settings.badge_text != blank -%}
          <span class="pdp-cert-badge">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6z"/><path d="m9 12 2 2 4-4"/></svg>
            {{ section.settings.badge_text }}
          </span>
        {%- endif -%}

        {%- if image_count > 1 -%}
          <button class="gallery-arrow gallery-arrow--prev" aria-label="Previous image" data-gallery-prev>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
        {%- endif -%}

        <div class="gallery-main" data-gallery-main>
          {%- if image_count > 0 -%}
            {%- for image in product.images -%}
              <div class="gallery-slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide>
                <img src="{{ image | image_url: width: 1400 }}"
                     alt="{{ image.alt | default: product.title | escape }}"
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     sizes="(min-width: 990px) 45vw, 100vw">
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="hero-media-placeholder"></div>
          {%- endif -%}
        </div>

        {%- if image_count > 1 -%}
          <button class="gallery-arrow gallery-arrow--next" aria-label="Next image" data-gallery-next>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if image_count > 1 -%}
        <div class="gallery-thumbs">
          {%- for image in product.images limit: 6 -%}
            <button class="gallery-thumb{% if forloop.first %} is-active{% endif %}" type="button"
                    data-gallery-thumb data-index="{{ forloop.index0 }}"
                    aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if fabric_txt != blank or weight_txt != blank or fit_txt != blank -%}
        <div class="pdp-spec-tiles">
          {%- if fabric_txt != blank -%}<div class="pdp-spec-tile"><span>Fabric</span><strong>{{ fabric_txt }}</strong></div>{%- endif -%}
          {%- if weight_txt != blank -%}<div class="pdp-spec-tile"><span>Weight</span><strong>{{ weight_txt }}</strong></div>{%- endif -%}
          {%- if fit_txt != blank -%}<div class="pdp-spec-tile"><span>Fit</span><strong>{{ fit_txt }}</strong></div>{%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp-info">
      {%- if product.vendor != blank -%}
        <a class="pdp-vendor-link" href="/collections/all?filter.p.vendor={{ product.vendor | url_encode }}">Browse All {{ product.vendor }}</a>
      {%- endif -%}

      <h1>{{ product.title }}</h1>

      {%- comment -%} White / Colors price cards ---------- {%- endcomment -%}
      <div class="pdp-price-cards">
        {%- if white_min < 2147483647 -%}
          <div class="pdp-price-card">
            <span class="pdp-price-card-name">White</span>
            <span class="pdp-price-card-lbl">As low as</span>
            <span class="pdp-price-card-now">{{ white_min | money }}</span>
            {%- if white_cmp > white_min -%}
              <span class="pdp-price-card-was">{{ white_cmp | money }}</span>
              <span class="pdp-price-card-save">Save {{ white_cmp | minus: white_min | times: 100.0 | divided_by: white_cmp | round }}%</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if colors_min < 2147483647 -%}
          <div class="pdp-price-card">
            <span class="pdp-price-card-name">{% if white_min < 2147483647 %}Colors{% else %}As low as{% endif %}</span>
            {%- if white_min < 2147483647 -%}<span class="pdp-price-card-lbl">As low as</span>{%- endif -%}
            <span class="pdp-price-card-now">{{ colors_min | money }}</span>
            {%- if colors_cmp > colors_min -%}
              <span class="pdp-price-card-was">{{ colors_cmp | money }}</span>
              <span class="pdp-price-card-save">Save {{ colors_cmp | minus: colors_min | times: 100.0 | divided_by: colors_cmp | round }}%</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Colour swatches ---------- {%- endcomment -%}
      {%- if color_index >= 0 and color_option.values.size > 0 -%}
        <div class="pdp-colors">
          <div class="pdp-color-hd">
            <span class="pdp-color-hd-lbl">Color:</span>
            <span class="pdp-color-current">
              <span class="pdp-color-current-chip" data-selected-color-chip></span>
              <strong data-selected-color-label>{{ selected_color }}</strong>
              <svg class="pdp-color-caret" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </span>
            <span class="pdp-color-count">{{ color_option.values.size }} color{% if color_option.values.size != 1 %}s{% endif %}</span>
          </div>
          <div class="pdp-color-grid">
            {%- for value in color_option.values -%}
              {%- assign swatch_hex = '#D9D9D9' -%}
              {%- assign swatch_img_index = '' -%}
              {%- assign value_down = value | downcase -%}
              {%- for c in swatches -%}
                {%- assign c_name_down = c.name | downcase -%}
                {%- if c_name_down == value_down -%}
                  {%- assign swatch_hex = c.hex -%}
                  {%- assign swatch_img_index = c.image_index -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              <button type="button"
                      class="pdp-color-swatch{% if value == selected_color %} is-active{% endif %}"
                      style="background:{{ swatch_hex }};"
                      data-color-swatch
                      data-color="{{ value | escape }}"
                      data-hex="{{ swatch_hex }}"
                      data-image-index="{{ swatch_img_index }}"
                      title="{{ value | escape }}"
                      aria-label="{{ value | escape }}">
                <svg class="pdp-color-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </button>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Size / quantity panel ---------- {%- endcomment -%}
      <form class="pdp-buy-panel" data-pdp-form>
        <div class="pdp-size-hd">Choose Size</div>
        <div class="pdp-size-grid" data-size-grid>
          {%- for v in product.variants -%}
            {%- assign show_variant = true -%}
            {%- if color_index >= 0 and v.options[color_index] != selected_color -%}
              {%- assign show_variant = false -%}
            {%- endif -%}
            {%- if show_variant -%}
              <div class="pdp-size-col{% unless v.available %} is-unavailable{% endunless %}">
                <div class="pdp-size-name">
                  {%- if size_index >= 0 -%}{{ v.options[size_index] }}{%- else -%}{{ v.title }}{%- endif -%}
                </div>
                <span class="pdp-qty-wrap">
                  <input type="number" class="pdp-size-qty" min="0" value="" inputmode="numeric"
                         data-variant-qty="{{ v.id }}" data-price="{{ v.price }}"
                         aria-label="Quantity for {% if size_index >= 0 %}{{ v.options[size_index] }}{% else %}{{ v.title }}{% endif %}"
                         {% unless v.available %}disabled{% endunless %}>
                  <span class="pdp-qty-arrows">
                    <button type="button" data-qty-step="1" tabindex="-1" aria-label="Increase">
                      <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8l6 8H6z"/></svg>
                    </button>
                    <button type="button" data-qty-step="-1" tabindex="-1" aria-label="Decrease">
                      <svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 16 6 8h12z"/></svg>
                    </button>
                  </span>
                </span>
                {%- if v.compare_at_price > v.price -%}
                  <div class="pdp-size-was">{{ v.compare_at_price | money }}</div>
                {%- endif -%}
                <div class="pdp-size-price">{{ v.price | money }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="pdp-cart-summary" data-cart-summary hidden>
          <span data-summary-qty>0 items</span>
          <span data-summary-total></span>
        </div>

        <button type="submit" class="pdp-add-to-cart" data-add-to-cart>ADD TO CART</button>
        <p class="pdp-cart-msg" data-cart-msg hidden></p>
      </form>
    </div>
  </div>

  {%- comment -%} ============ Volume pricing + DTF upload ============ {%- endcomment -%}
  {%- assign tier_blocks = section.blocks | where: 'type', 'volume_tier' -%}
  {%- if tier_blocks.size > 0 or section.settings.show_dtf_upload -%}
    <div class="container pdp-mid">
      {%- if tier_blocks.size > 0 -%}
        <div class="pdp-volume">
          <h2 class="pdp-volume-hd">Buy More <span>Save More</span></h2>
          {%- if section.settings.volume_note != blank -%}
            <p class="pdp-volume-note">{{ section.settings.volume_note }}</p>
          {%- endif -%}
          <table class="pdp-volume-table">
            <thead>
              <tr>
                <th>Cart Total</th>
                <th>{{ section.settings.volume_col_1 | default: 'White' }}</th>
                <th>{{ section.settings.volume_col_2 | default: 'Colors' }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for block in tier_blocks -%}
                <tr {{ block.shopify_attributes }}>
                  <td class="pdp-volume-total">{{ block.settings.cart_total }}</td>
                  <td>
                    <span class="pdp-volume-price">{{ block.settings.price_1 }}</span>
                    {%- if block.settings.off_1 != blank -%}<span class="pdp-volume-off">{{ block.settings.off_1 }}</span>{%- endif -%}
                  </td>
                  <td>
                    <span class="pdp-volume-price">{{ block.settings.price_2 }}</span>
                    {%- if block.settings.off_2 != blank -%}<span class="pdp-volume-off">{{ block.settings.off_2 }}</span>{%- endif -%}
                  </td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
          {%- if section.settings.volume_footnote != blank -%}
            <p class="pdp-volume-foot">{{ section.settings.volume_footnote }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_dtf_upload -%}
        <div class="pdp-dtf">
          <h2 class="pdp-dtf-hd">{{ section.settings.dtf_heading | default: 'Add DTF Transfers to your order' }}</h2>
          <p class="pdp-dtf-sub">{{ section.settings.dtf_sub }}</p>
          <div class="pdp-dtf-panel">
            <span class="pdp-dtf-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V8m0 0-3.5 3.5M12 8l3.5 3.5"/><path d="M20 16.7A4.5 4.5 0 0 0 17.5 8h-1.3A7 7 0 1 0 5 15.7"/></svg>
            </span>
            <div class="pdp-dtf-body">
              <div class="pdp-dtf-title">{{ section.settings.dtf_panel_title | default: 'Upload Your Artwork' }}</div>
              <p>{{ section.settings.dtf_panel_text | default: 'Click the button below to add your file(s)' }}</p>
              {%- if section.settings.dtf_button_link != blank -%}
                <a href="{{ section.settings.dtf_button_link }}" class="pdp-dtf-btn">{{ section.settings.dtf_button_label | default: 'Upload Your Design' }}</a>
              {%- endif -%}
            </div>
            {%- if section.settings.dtf_image -%}
              <img class="pdp-dtf-img" src="{{ section.settings.dtf_image | image_url: width: 600 }}" alt="" loading="lazy">
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- comment -%} ============ Description + accordions ============ {%- endcomment -%}
  <div class="pdp-detail-band">
    <div class="container pdp-detail">
      <div class="pdp-detail-left">
        {%- if product.description != blank -%}
          <h2 class="pdp-section-hd">Description</h2>
          <div class="pdp-description rte">{{ product.description }}</div>
        {%- endif -%}
      </div>

      <div class="pdp-detail-right">
        {%- comment -%} Breakdown rows come from whichever facet metafields this
        product actually has, so nothing renders blank. {%- endcomment -%}
        {%- assign spec_labels = 'Fabric,Weight,Fit,Type,Style,Sleeve Length,Sleeve Style,Neckline,Collar,Cuffs,Treatment,Tag,Gender-Age,Construction,Closure,Bill' | split: ',' -%}
        {%- assign spec_keys = 'fabric,weight,fit,type,style,sleeve_length,sleeve_style,neckline,collar,cuffs,treatment,tag,gender_age,construction,closure,bill' | split: ',' -%}
        {%- assign spec_rows = '' -%}
        {%- for key in spec_keys -%}
          {%- assign val = product.metafields.custom[key].value | join: ', ' -%}
          {%- if val != blank -%}
            {%- assign label = spec_labels[forloop.index0] -%}
            {%- assign spec_rows = spec_rows | append: '<tr><th>' | append: label | append: '</th><td>' | append: val | append: '</td></tr>' -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if spec_rows != blank -%}
          <div class="pdp-acc" data-acc>
            <button type="button" class="pdp-acc-hd" data-acc-toggle>
              <span class="pdp-acc-name">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
                Breakdown
              </span>
              <span class="pdp-acc-icon">+</span>
            </button>
            <div class="pdp-acc-body">
              <table class="pdp-spec-table">{{ spec_rows }}</table>
            </div>
          </div>
        {%- endif -%}

        {%- assign features_list = product.metafields.custom.features.value -%}
        {%- if features_list.size > 0 -%}
          <div class="pdp-acc" data-acc>
            <button type="button" class="pdp-acc-hd" data-acc-toggle>
              <span class="pdp-acc-name">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 1.9 5.8L20 10l-5 3.6 1.5 6L12 16.5 7.5 19.6 9 13.6 4 10l6.1-1.2z"/></svg>
                Features
              </span>
              <span class="pdp-acc-icon">+</span>
            </button>
            <div class="pdp-acc-body">
              <ul class="pdp-feature-list">
                {%- for f in features_list -%}<li>{{ f }}</li>{%- endfor -%}
              </ul>
            </div>
          </div>
        {%- endif -%}

        {%- if section.settings.size_chart != blank -%}
          <div class="pdp-acc" data-acc>
            <button type="button" class="pdp-acc-hd" data-acc-toggle>
              <span class="pdp-acc-name">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 15 15 2l7 7L9 22z"/><path d="m6 11 2 2M10 7l2 2M14 11l2 2"/></svg>
                Size Chart
              </span>
              <span class="pdp-acc-icon">+</span>
            </button>
            <div class="pdp-acc-body rte">{{ section.settings.size_chart }}</div>
          </div>
        {%- endif -%}

        {%- if section.settings.shipping_returns != blank -%}
          <div class="pdp-acc" data-acc>
            <button type="button" class="pdp-acc-hd" data-acc-toggle>
              <span class="pdp-acc-name">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                Shipping &amp; Returns
              </span>
              <span class="pdp-acc-icon">+</span>
            </button>
            <div class="pdp-acc-body rte">{{ section.settings.shipping_returns }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} ============ Print promo banner ============ {%- endcomment -%}
  {%- if section.settings.promo_heading != blank -%}
    <div class="container">
      <div class="pdp-promo">
        <div class="pdp-promo-body">
          {%- if section.settings.promo_eyebrow != blank -%}
            <span class="pdp-promo-eyebrow">{{ section.settings.promo_eyebrow }}</span>
          {%- endif -%}
          <h2 class="pdp-promo-hd">{{ section.settings.promo_heading }}</h2>
          {%- if section.settings.promo_text != blank -%}
            <p class="pdp-promo-text">{{ section.settings.promo_text }}</p>
          {%- endif -%}
          {%- assign promo_badges = section.settings.promo_badges | split: ',' -%}
          {%- if promo_badges.size > 0 -%}
            <div class="pdp-promo-badges">
              {%- for b in promo_badges -%}
                <span class="pdp-promo-badge">{{ b | strip }}</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.promo_link != blank -%}
            <a class="pdp-promo-btn" href="{{ section.settings.promo_link }}">{{ section.settings.promo_button | default: 'Print My Blanks' }} &rarr;</a>
          {%- endif -%}
        </div>
        {%- if section.settings.promo_image -%}
          <img class="pdp-promo-img" src="{{ section.settings.promo_image | image_url: width: 1200 }}" alt="" loading="lazy">
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ Recommended ============ {%- endcomment -%}
  <div class="container pdp-recommended" data-recommendations data-product-id="{{ product.id }}" hidden>
    <div class="pdp-rec-hd">
      <h2 class="pdp-section-hd">Recommended</h2>
      <span class="pdp-rec-divider"></span>
      <span class="pdp-section-sub">You may also <strong>like</strong> these products</span>
    </div>
    <div class="pdp-rec-grid" data-rec-grid></div>
  </div>
</section>

<style>
  /* Design tokens measured from the reference PDP. Scoped to this section so
     the rest of the theme keeps its own palette. */
  .main-product-hoodies {
    --nt-surface: #F5F4F2;   /* price cards, spec tiles, buy panel */
    --nt-orange:  #F27708;   /* headline price + save badge */
    --nt-blue:    #019AFF;   /* add to cart */
    --nt-navy:    #03406C;   /* per-size and volume prices */
    --nt-green:   #1A7A3C;   /* recommended "starting at" prices */
    --nt-ink:     #2B2B2B;
    --nt-muted:   #5A5B60;
    --nt-retail:  #888888;
    --nt-line:    #DDDDDD;
    --nt-dark:    #111111;
  }
  .main-product-hoodies.pdp { padding: 0 0 60px; }

  .pdp-topstrip { background: #FFF8E6; border-bottom: 1px solid #F3E3B3; margin-bottom: 26px; }
  .pdp-topstrip-inner { display: flex; flex-wrap: wrap; gap: 8px 26px; padding: 9px 0; justify-content: center; }
  .pdp-topstrip-item { font-size: 0.76rem; font-weight: 600; color: #6B5B2E; display: inline-flex; align-items: center; gap: 6px; }
  .pdp-topstrip-item--accent { font-weight: 800; color: #8A6D1F; }

  .pdp-inner { display: grid; grid-template-columns: 1fr 1.15fr; gap: 44px; align-items: start; }

  /* ---- gallery ---- */
  .product-gallery { position: relative; }
  .pdp-cert-badge { position: absolute; top: 12px; left: 12px; z-index: 3; display: inline-flex; align-items: center; gap: 6px; background: #1F2937; color: #fff; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; padding: 7px 12px; border-radius: 7px; }
  .gallery-main { position: relative; aspect-ratio: 1; background: #fff; border: 1px solid var(--pdp-line); border-radius: 10px; overflow: hidden; }
  .gallery-slide { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity .2s; }
  .gallery-slide.is-active { opacity: 1; pointer-events: auto; }
  .gallery-slide img { width: 100%; height: 100%; object-fit: contain; }
  .gallery-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--pdp-line); background: #fff; box-shadow: 0 2px 8px rgba(16,24,40,0.10); display: flex; align-items: center; justify-content: center; cursor: pointer; color: #4B5563; }
  .gallery-arrow--prev { left: -14px; }
  .gallery-arrow--next { right: -14px; }
  .gallery-thumbs { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
  .gallery-thumb { width: 78px; height: 78px; border-radius: 8px; overflow: hidden; border: 1px solid var(--pdp-line); padding: 0; cursor: pointer; background: #fff; }
  .gallery-thumb.is-active { border-color: var(--brand); }
  .gallery-thumb img { width: 100%; height: 100%; object-fit: contain; }

  .pdp-spec-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 12px; }
