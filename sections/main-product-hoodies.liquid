  .pdp-qty-arrows button + button { border-top: 1px solid var(--nt-line); }
  .pdp-size-was { font-size: 12px; color: var(--nt-retail); text-decoration: line-through; margin-top: 6px; }
  .pdp-size-price { font-size: 15px; font-weight: 700; color: var(--nt-navy); margin-top: 2px; }

  /* display:flex outranks the UA [hidden] rule, so restate it explicitly. */
  .pdp-cart-summary { display: flex; justify-content: space-between; font-size: 13px; font-weight: 700; padding: 4px 2px 12px; }
  .pdp-cart-summary[hidden] { display: none; }
  .pdp-add-to-cart { width: 100%; background: var(--nt-blue); color: #fff; border: none; border-radius: 8px; padding: 14px 15px; font-size: 15px; font-weight: 700; text-transform: uppercase; cursor: pointer; transition: background .15s; }
  .pdp-add-to-cart:hover { background: #0286DD; }
  .pdp-add-to-cart:disabled { background: #94A3B8; cursor: default; }
  .pdp-cart-msg { font-size: 0.82rem; margin: 10px 0 0; }
  .pdp-cart-msg.is-error { color: #C92A2A; }
  .pdp-cart-msg.is-success { color: var(--success); }

  /* ---- volume + dtf ---- */
  .pdp-mid { display: grid; grid-template-columns: 1fr 1.15fr; gap: 44px; align-items: start; margin-top: 52px; }
  .pdp-volume-hd { font-size: 1.3rem; font-weight: 800; margin: 0 0 4px; }
  .pdp-volume-hd span { color: var(--nt-blue); }
  .pdp-volume-note { font-size: 0.78rem; color: #6B7280; margin: 0 0 16px; }
  .pdp-volume-table { width: 100%; border-collapse: collapse; }
  .pdp-volume-table th { text-align: left; font-size: 0.8rem; font-weight: 700; color: #374151; padding: 10px 8px; border-bottom: 1px solid var(--pdp-line); }
  .pdp-volume-table td { padding: 13px 8px; border-bottom: 1px solid var(--pdp-line); font-size: 0.85rem; }
  .pdp-volume-total { font-weight: 700; }
  .pdp-volume-price { font-size: 15px; font-weight: 700; color: var(--nt-navy); }
  .pdp-volume-off { font-size: 12px; color: var(--nt-blue); margin-left: 6px; }
  .pdp-volume-foot { font-size: 0.72rem; color: #6B7280; margin-top: 12px; }

  .pdp-dtf { text-align: center; }
  .pdp-dtf-hd { font-size: 1.15rem; font-weight: 800; margin: 0 0 6px; }
  .pdp-dtf-sub { font-size: 0.85rem; color: #6B7280; margin: 0 0 18px; }
  .pdp-dtf-panel { position: relative; display: flex; align-items: center; gap: 16px; text-align: left; background: #EFF8FF; border: 2px dashed #7DD3FC; border-radius: 10px; padding: 22px; overflow: hidden; }
  .pdp-dtf-icon { flex-shrink: 0; width: 42px; height: 42px; border-radius: 50%; background: #fff; color: var(--nt-blue); display: flex; align-items: center; justify-content: center; }
  .pdp-dtf-title { font-size: 1rem; font-weight: 800; margin-bottom: 4px; }
  .pdp-dtf-body p { font-size: 0.8rem; color: #4B5563; margin: 0 0 12px; max-width: 34ch; }
  .pdp-dtf-btn { display: inline-block; background: var(--nt-blue); color: #fff; font-size: 0.85rem; font-weight: 700; padding: 10px 18px; border-radius: 7px; }
  .pdp-dtf-img { width: 45%; max-width: 320px; margin-left: auto; border-radius: 8px; }

  /* ---- description + accordions ---- */
  .pdp-detail-band { background: #F9FAFB; margin-top: 52px; padding: 36px 0; }
  .pdp-detail { display: grid; grid-template-columns: 1fr 1.1fr; gap: 52px; align-items: start; }
  .pdp-section-hd { font-size: 1.05rem; font-weight: 800; margin: 0 0 14px; }
  .pdp-description { font-size: 0.88rem; line-height: 1.75; color: #374151; }
  .pdp-acc { border-top: 1px solid var(--pdp-line); }
  .pdp-acc:last-child { border-bottom: 1px solid var(--pdp-line); }
  .pdp-acc-hd { width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; padding: 18px 2px; font-size: 0.92rem; font-weight: 700; cursor: pointer; text-align: left; }
  .pdp-acc-name { display: inline-flex; align-items: center; gap: 10px; color: #374151; }
  .pdp-acc-icon { font-size: 1.2rem; color: #6B7280; transition: transform .15s; }
  .pdp-acc-body { display: none; padding: 0 2px 18px; font-size: 0.86rem; line-height: 1.65; }
  .pdp-acc.is-open .pdp-acc-body { display: block; }
  .pdp-acc.is-open .pdp-acc-icon { transform: rotate(45deg); }
  .pdp-feature-list { margin: 0; padding-left: 18px; }
  .pdp-feature-list li { margin-bottom: 5px; }
  .pdp-spec-table { width: 100%; border-collapse: collapse; }
  .pdp-spec-table th { text-align: left; font-weight: 700; padding: 7px 12px 7px 0; width: 40%; vertical-align: top; color: #6B7280; font-size: 0.82rem; }
  .pdp-spec-table td { padding: 7px 0; font-size: 0.85rem; }

  /* ---- promo ---- */
  .pdp-promo { display: grid; grid-template-columns: 1fr 1.1fr; gap: 24px; align-items: center; border: 1px solid var(--pdp-line); border-radius: 14px; padding: 30px; margin-top: 48px; overflow: hidden; }
  .pdp-promo-eyebrow { display: inline-block; background: #FFF1E6; color: #C2410C; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; padding: 5px 11px; border-radius: 999px; margin-bottom: 12px; }
  .pdp-promo-hd { font-size: 1.35rem; font-weight: 800; margin: 0 0 10px; }
  .pdp-promo-text { font-size: 0.88rem; color: #4B5563; margin: 0 0 14px; max-width: 46ch; }
  .pdp-promo-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .pdp-promo-badge { font-size: 0.74rem; font-weight: 600; color: #374151; background: #F3F4F6; border-radius: 999px; padding: 5px 12px; }
  .pdp-promo-badge::before { content: "•"; color: var(--nt-orange); margin-right: 6px; }
  .pdp-promo-btn { display: inline-block; background: var(--nt-orange); color: #fff; font-size: 0.88rem; font-weight: 700; padding: 12px 22px; border-radius: 8px; }
  .pdp-promo-img { width: 100%; border-radius: 10px; }

  /* ---- recommended ---- */
  .pdp-recommended { margin-top: 52px; }
  .pdp-rec-hd { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; }
  .pdp-rec-hd .pdp-section-hd { margin: 0; }
  .pdp-rec-divider { width: 1px; height: 20px; background: var(--pdp-line); }
  .pdp-section-sub { font-size: 0.85rem; color: #6B7280; }
  .pdp-rec-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 16px; }
  .pdp-rec-card { border: 1px solid var(--pdp-line); border-radius: 12px; overflow: hidden; background: #fff; display: block; }
  .pdp-rec-card img { width: 100%; aspect-ratio: 1; object-fit: contain; background: #fff; display: block; }
  .pdp-rec-body { padding: 10px 12px 14px; }
  .pdp-rec-colors { font-size: 0.7rem; color: #6B7280; font-weight: 600; margin-bottom: 8px; }
  .pdp-rec-lbl { font-size: 0.62rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #9CA3AF; }
  .pdp-rec-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .pdp-rec-price { font-size: 15px; font-weight: 700; color: var(--nt-green); }
  .pdp-rec-vendor { font-size: 0.75rem; font-weight: 700; color: #1E3A8A; }
  .pdp-rec-title { font-size: 0.78rem; font-weight: 500; color: #374151; line-height: 1.35; margin-top: 6px; }

  @media (max-width: 900px) {
    .pdp-inner, .pdp-mid, .pdp-detail, .pdp-promo { grid-template-columns: 1fr; gap: 24px; }
    .gallery-arrow--prev { left: 8px; }
    .gallery-arrow--next { right: 8px; }
    .pdp-dtf-img { display: none; }
  }
</style>

<script>
(function () {
  var root = document.currentScript.closest(".main-product-hoodies") || document.querySelector(".main-product-hoodies");
  if (!root) return;

  var variants = {{ product.variants | json }};
  var colorIndex = {{ color_index }};
  var sizeIndex = {{ size_index }};

  function formatMoney(cents) {
    return (cents / 100).toLocaleString(undefined, {
      style: 'currency',
      currency: '{{ cart.currency.iso_code | default: shop.currency }}'
    });
  }
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  /* ---------- Gallery ---------- */
  var slides = root.querySelectorAll('[data-gallery-slide]');
  var thumbs = root.querySelectorAll('[data-gallery-thumb]');
  var prevBtn = root.querySelector('[data-gallery-prev]');
  var nextBtn = root.querySelector('[data-gallery-next]');
  var activeIndex = 0;

  function showSlide(i) {
    if (!slides.length) return;
    activeIndex = (i + slides.length) % slides.length;
    slides.forEach(function (s, idx) { s.classList.toggle('is-active', idx === activeIndex); });
    thumbs.forEach(function (t, idx) { t.classList.toggle('is-active', idx === activeIndex); });
  }
  thumbs.forEach(function (t, idx) { t.addEventListener('click', function () { showSlide(idx); }); });
  if (prevBtn) prevBtn.addEventListener('click', function () { showSlide(activeIndex - 1); });
  if (nextBtn) nextBtn.addEventListener('click', function () { showSlide(activeIndex + 1); });

  /* ---------- Size grid ---------- */
  var sizeGrid = root.querySelector('[data-size-grid]');
  var summary = root.querySelector('[data-cart-summary]');
  var summaryQty = root.querySelector('[data-summary-qty]');
  var summaryTotal = root.querySelector('[data-summary-total]');

  function updateSummary() {
    if (!sizeGrid) return;
    var qty = 0, total = 0;
    sizeGrid.querySelectorAll('[data-variant-qty]').forEach(function (input) {
      var n = parseInt(input.value, 10) || 0;
      if (n > 0) { qty += n; total += n * (parseInt(input.dataset.price, 10) || 0); }
    });
    if (summary) summary.hidden = qty === 0;
    if (summaryQty) summaryQty.textContent = qty + (qty === 1 ? ' item' : ' items');
    if (summaryTotal) summaryTotal.textContent = formatMoney(total);
  }

  function renderSizeGrid(color) {
    if (!sizeGrid) return;
    var matching = variants.filter(function (v) {
      return colorIndex < 0 || v.options[colorIndex] === color;
    });
    sizeGrid.innerHTML = matching.map(function (v) {
      var label = escapeHtml(sizeIndex >= 0 ? v.options[sizeIndex] : v.title);
      var was = (v.compare_at_price && v.compare_at_price > v.price)
        ? '<div class="pdp-size-was">' + formatMoney(v.compare_at_price) + '</div>'
        : '';
      return '<div class="pdp-size-col' + (v.available ? '' : ' is-unavailable') + '">' +
        '<div class="pdp-size-name">' + label + '</div>' +
        '<span class="pdp-qty-wrap">' +
          '<input type="number" class="pdp-size-qty" min="0" value="" inputmode="numeric"' +
            ' data-variant-qty="' + v.id + '" data-price="' + v.price + '"' +
            ' aria-label="Quantity for ' + label + '"' +
            (v.available ? '' : ' disabled') + '>' +
          '<span class="pdp-qty-arrows">' +
            '<button type="button" data-qty-step="1" tabindex="-1" aria-label="Increase">' +
              '<svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 8l6 8H6z"/></svg></button>' +
            '<button type="button" data-qty-step="-1" tabindex="-1" aria-label="Decrease">' +
              '<svg width="8" height="8" viewBox="0 0 24 24" fill="currentColor"><path d="M12 16 6 8h12z"/></svg></button>' +
          '</span>' +
        '</span>' +
        was +
        '<div class="pdp-size-price">' + formatMoney(v.price) + '</div>' +
      '</div>';
    }).join('');
    updateSummary();
  }

  if (sizeGrid) {
    sizeGrid.addEventListener('input', updateSummary);

    // Delegated so the arrows keep working after the grid is re-rendered.
    sizeGrid.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-qty-step]');
      if (!btn) return;
      var input = btn.closest('.pdp-qty-wrap').querySelector('[data-variant-qty]');
      if (!input || input.disabled) return;
      var next = (parseInt(input.value, 10) || 0) + parseInt(btn.dataset.qtyStep, 10);
      input.value = next > 0 ? next : '';
      updateSummary();
    });
  }

  /* ---------- Colour swatches ---------- */
  var colorChip = root.querySelector('[data-selected-color-chip]');
  var colorLabel = root.querySelector('[data-selected-color-label]');

  function syncChip(swatch) {
    if (colorChip) colorChip.style.background = swatch.dataset.hex || '#D9D9D9';
    if (colorLabel) colorLabel.textContent = swatch.dataset.color;
  }

  var swatchEls = root.querySelectorAll('[data-color-swatch]');
  swatchEls.forEach(function (swatch) {
    swatch.addEventListener('click', function () {
      swatchEls.forEach(function (s) { s.classList.remove('is-active'); });
      swatch.classList.add('is-active');
      syncChip(swatch);

      var imgIndex = parseInt(swatch.dataset.imageIndex, 10);
      if (!isNaN(imgIndex)) showSlide(imgIndex);

      renderSizeGrid(swatch.dataset.color);
    });
  });
  var activeSwatch = root.querySelector('[data-color-swatch].is-active');
  if (activeSwatch) syncChip(activeSwatch);

  /* ---------- Add to cart (multi-variant) ---------- */
  var form = root.querySelector('[data-pdp-form]');
  var msg = root.querySelector('[data-cart-msg]');
  var addBtn = root.querySelector('[data-add-to-cart]');

  function showMsg(text, kind) {
    if (!msg) return;
    msg.textContent = text;
    msg.className = 'pdp-cart-msg ' + (kind === 'error' ? 'is-error' : 'is-success');
    msg.hidden = false;
  }

  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var items = [];
      sizeGrid.querySelectorAll('[data-variant-qty]').forEach(function (input) {
        var n = parseInt(input.value, 10) || 0;
        if (n > 0) items.push({ id: parseInt(input.dataset.variantQty, 10), quantity: n });
      });

      if (!items.length) {
        showMsg('Enter a quantity for at least one size.', 'error');
        return;
      }

      addBtn.disabled = true;
      addBtn.textContent = 'ADDING…';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      })
        .then(function (r) { return r.json().then(function (body) { return { ok: r.ok, body: body }; }); })
        .then(function (res) {
          if (!res.ok) throw new Error(res.body && res.body.description ? res.body.description : 'Could not add to cart.');
          var count = items.reduce(function (n, i) { return n + i.quantity; }, 0);
          showMsg(count + (count === 1 ? ' item' : ' items') + ' added to your cart.', 'success');
          sizeGrid.querySelectorAll('[data-variant-qty]').forEach(function (i) { i.value = 0; });
          updateSummary();
          document.dispatchEvent(new CustomEvent('cart:updated'));
        })
        .catch(function (err) { showMsg(err.message, 'error'); })
        .finally(function () {
          addBtn.disabled = false;
          addBtn.textContent = 'ADD TO CART';
        });
    });
  }

  /* ---------- Recommendations ---------- */
  var recWrap = root.querySelector('[data-recommendations]');
  if (recWrap) {
    fetch('/recommendations/products.json?product_id=' + recWrap.dataset.productId + '&limit=5')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.products || !data.products.length) return;
        var grid = recWrap.querySelector('[data-rec-grid]');
        grid.innerHTML = data.products.map(function (p) {
          var img = p.featured_image || (p.images && p.images[0]) || '';
          // Colour count is derived from the variants the API returns; hex
          // values aren't available here, so show a count rather than
          // rendering swatches in the wrong colours.
          var colors = 0;
          if (p.variants && p.variants.length) {
            var seen = {};
            p.variants.forEach(function (v) { if (v.option1) seen[v.option1] = 1; });
            colors = Object.keys(seen).length;
          }
          return '<a class="pdp-rec-card" href="' + p.url + '">' +
            (img ? '<img src="' + img + '" alt="" loading="lazy">' : '') +
            '<div class="pdp-rec-body">' +
              (colors > 1 ? '<div class="pdp-rec-colors">' + colors + ' colors</div>' : '') +
              '<div class="pdp-rec-lbl">Starting at</div>' +
              '<div class="pdp-rec-row">' +
                '<span class="pdp-rec-price">' + formatMoney(p.price) + '</span>' +
                (p.vendor ? '<span class="pdp-rec-vendor">' + escapeHtml(p.vendor) + '</span>' : '') +
              '</div>' +
              '<div class="pdp-rec-title">' + escapeHtml(p.title) + '</div>' +
            '</div></a>';
        }).join('');
        recWrap.hidden = false;
      })
      .catch(function () { /* recommendations are optional */ });
  }

  /* ---------- Accordions ---------- */
  root.querySelectorAll('[data-acc-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      btn.closest('[data-acc]').classList.toggle('is-open');
    });
  });

  updateSummary();
})();
</script>

