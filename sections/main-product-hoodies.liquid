  .pdp-price-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; margin-bottom: 22px; }
  .pdp-price-card { display: flex; align-items: center; gap: 8px; background: var(--nt-surface); border-radius: 8px; padding: 0 0 0 16px; overflow: hidden; min-height: 44px; }
  .pdp-price-card-name { font-size: 13px; font-weight: 700; color: var(--nt-ink); }
  .pdp-price-card-lbl { font-size: 11px; font-weight: 400; color: var(--nt-muted); }
  .pdp-price-card-now { font-size: 16px; font-weight: 800; color: var(--nt-orange); }
  .pdp-price-card-was { font-size: 13px; font-weight: 400; color: var(--nt-retail); text-decoration: line-through; }
  .pdp-price-card-save { margin-left: auto; align-self: stretch; display: flex; align-items: center; background: var(--nt-orange); color: #fff; font-size: 11px; font-weight: 800; padding: 0 16px; white-space: nowrap; }

  .pdp-colors { margin-bottom: 20px; }
  .pdp-color-hd { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; margin-bottom: 10px; }
  .pdp-color-hd-lbl { font-weight: 700; }
  .pdp-color-current { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--pdp-line); border-radius: 6px; padding: 4px 10px; }
  .pdp-color-current-chip { width: 15px; height: 15px; border-radius: 3px; border: 1px solid rgba(0,0,0,0.18); display: inline-block; }
  .pdp-color-caret { color: #6B7280; flex-shrink: 0; }
