  .pdp-spec-tile span { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--nt-muted); margin-bottom: 5px; font-weight: 500; }
  .pdp-spec-tile strong { font-size: 15px; font-weight: 700; }

  /* ---- buy box ---- */
  .pdp-vendor-link { font-size: 13px; font-weight: 600; color: var(--nt-ink); text-decoration: underline; }
