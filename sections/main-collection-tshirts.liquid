{%- liquid
  assign per_page = section.settings.products_per_page | default: 24
-%}

<section class="main-collection-tshirts">
  <div class="container coll-head">
    <div class="coll-head-text">
      <h1>{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="coll-desc rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
    {%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}
    {%- if badge_blocks.size > 0 -%}
      <div class="coll-badges">
        {%- for badge in section.blocks -%}
          {%- if badge.type == 'badge' -%}
            <div class="coll-badge" {{ badge.shopify_attributes }}>
              <span class="coll-badge-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h7l-1 8 10-12h-7z"/></svg>
              </span>
              <span>{{ badge.settings.text }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_quick_nav and section.blocks.size > 0 -%}
    <div class="coll-quicknav-wrap">
      <div class="container">
        <div class="coll-quicknav">
          {%- for block in section.blocks -%}
            {%- if block.type == 'quick_link' -%}
              <a href="{{ block.settings.link }}" class="coll-quicktab{% if block.settings.link contains collection.handle %} is-active{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.image -%}
                  <span class="coll-quicktab-thumb">{{ block.settings.image | image_url: width: 64 | image_tag: loading: 'lazy', alt: block.settings.label }}</span>
                {%- endif -%}
                <span>{{ block.settings.label }}</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="container coll-body">

    <aside class="coll-sidebar" id="collFilters">
      {%- if collection.filters.size > 0 -%}
        <form id="collFilterForm">
          {%- for filter in collection.filters -%}
            {%- if filter.values.size > 0 -%}
              <div class="filter-group" data-filter-group>
                <button type="button" class="filter-group-hd" data-filter-toggle>
                  {{ filter.label }}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="filter-chevron"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="filter-group-body">
                  {%- if filter.type == 'price_range' -%}
                    <div class="filter-price-range">
                      <label>
                        <span>Min</span>
                        <input type="number" min="0" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" placeholder="{{ filter.range_min | money }}">
                      </label>
                      <label>
                        <span>Max</span>
                        <input type="number" min="0" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" placeholder="{{ filter.range_max | money }}">
                      </label>
                    </div>
                  {%- else -%}
                    <ul class="filter-list">
                      {%- for value in filter.values -%}
                        {%- if value.count > 0 or value.active -%}
                          <li>
                            <label class="filter-check">
                              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                              <span>{{ value.label }}</span>
                              <small>({{ value.count }})</small>
                            </label>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          <button type="submit" class="btn-blue filter-apply-btn">Apply Filters</button>
          {%- if collection.current_vendor or collection.current_type or current_tags.size > 0 -%}
            <a href="{{ collection.url }}" class="filter-clear-link">Clear all</a>
          {%- endif -%}
        </form>
      {%- endif -%}
    </aside>

    <div class="coll-main">
      <div class="coll-toolbar">
        <span class="coll-count">Showing {{ collection.products_count }} product{% if collection.products_count != 1 %}s{% endif %}</span>
        <form id="collSortForm">
          <select name="sort_by" data-coll-sort>
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        </form>
      </div>

      {%- paginate collection.products by per_page -%}
        {%- if collection.products.size > 0 -%}
          <div class="product-grid">
            {%- for product in collection.products -%}
              <a class="product-card" href="{{ product.url }}">
                <span class="product-card-media">
                  {%- if product.featured_image -%}
                    {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title }}
                  {%- else -%}
                    <span class="hero-media-placeholder"></span>
                  {%- endif -%}
                </span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="product-card-save">Save {{ product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round }}%</span>
                {%- endif -%}
                <span class="product-card-body">
                  <span class="product-card-price">
                    <small>As low as</small>
                    <strong>{{ product.price_min | money }}</strong>
                    {%- if product.compare_at_price > product.price -%}
                      <s>{{ product.compare_at_price | money }}</s>
                    {%- endif -%}
                  </span>
                  {%- if product.vendor != blank -%}<span class="product-card-vendor">{{ product.vendor }}</span>{%- endif -%}
                  <span class="product-card-title">{{ product.title }}</span>
                </span>
              </a>
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="coll-pagination" aria-label="Pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="coll-page-link">&larr; Prev</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="coll-page-link">{{ part.title }}</a>
                {%- else -%}
                  <span class="coll-page-link{% if part.title == paginate.current_page %} is-active{% endif %}">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="coll-page-link">Next &rarr;</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <p class="coll-empty">No products found in this collection yet.</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</section>

<style>
  .main-collection-tshirts { padding: 28px 0 60px; }
  .coll-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 20px; }
  .coll-head h1 { font-size: 2rem; font-weight: 800; }
  .coll-desc { color: var(--pdp-muted); margin-top: 6px; max-width: 640px; font-size: 0.95rem; }
  .coll-badges { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .coll-badge { display: flex; align-items: center; gap: 8px; padding: 10px 16px; border: 1px solid var(--pdp-line); border-radius: 10px; font-size: 0.85rem; font-weight: 700; white-space: nowrap; }
  .coll-badge-icon { color: var(--brand); display: flex; }

  .coll-quicknav-wrap { border-top: 1px solid var(--pdp-line); border-bottom: 1px solid var(--pdp-line); margin-bottom: 24px; }
  .coll-quicknav { display: flex; gap: 10px; overflow-x: auto; padding: 14px 0; }
  .coll-quicktab { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border: 1px solid var(--pdp-line); border-radius: 999px; font-size: 0.85rem; font-weight: 700; white-space: nowrap; flex-shrink: 0; transition: border-color .15s, color .15s; }
  .coll-quicktab:hover, .coll-quicktab.is-active { border-color: var(--brand); color: var(--brand); }
  .coll-quicktab-thumb { width: 22px; height: 22px; border-radius: 50%; overflow: hidden; display: block; }
  .coll-quicktab-thumb img { width: 100%; height: 100%; object-fit: cover; }

  .coll-body { display: grid; grid-template-columns: 240px 1fr; gap: 32px; align-items: start; }
  .coll-sidebar { position: sticky; top: calc(var(--nav-bottom, 97px) + 20px); }
  .filter-group { border-bottom: 1px solid var(--pdp-line); padding: 14px 0; }
  .filter-group-hd { width: 100%; display: flex; justify-content: space-between; align-items: center; background: none; border: none; font-size: 0.9rem; font-weight: 700; cursor: pointer; padding: 0; }
  .filter-chevron { transition: transform .2s; }
  .filter-group[data-collapsed] .filter-chevron { transform: rotate(-90deg); }
  .filter-group[data-collapsed] .filter-group-body { display: none; }
  .filter-group-body { margin-top: 10px; display: flex; flex-direction: column; gap: 8px; max-height: 260px; overflow-y: auto; }
  .filter-check { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; cursor: pointer; }
  .filter-check small { color: var(--pdp-muted); }
  .filter-price-range { display: flex; gap: 10px; }
  .filter-price-range label { display: flex; flex-direction: column; gap: 4px; font-size: 0.75rem; color: var(--pdp-muted); flex: 1; }
  .filter-price-range input { padding: 6px 8px; border: 1px solid var(--pdp-line); border-radius: 6px; width: 100%; }
  .filter-apply-btn { width: 100%; margin-top: 16px; padding: 10px; font-size: 0.85rem; }
  .filter-clear-link { display: block; text-align: center; margin-top: 10px; font-size: 0.8rem; color: var(--pdp-muted); text-decoration: underline; }

  .coll-toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .coll-count { font-size: 0.85rem; color: var(--pdp-muted); }
  .coll-toolbar select { padding: 8px 12px; border: 1px solid var(--pdp-line); border-radius: 8px; font-size: 0.85rem; }

  .product-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .product-card { display: flex; flex-direction: column; border: 1px solid var(--pdp-line); border-radius: 12px; overflow: hidden; position: relative; transition: box-shadow .15s, transform .15s; }
  .product-card:hover { box-shadow: 0 8px 24px rgba(16,24,40,0.1); transform: translateY(-2px); }
  .product-card-media { display: block; aspect-ratio: 1; background: #f6f7f9; }
  .product-card-media img { width: 100%; height: 100%; object-fit: cover; }
  .product-card-save { position: absolute; top: 10px; left: 10px; background: var(--danger); color: #fff; font-size: 0.7rem; font-weight: 800; padding: 3px 8px; border-radius: 6px; }
  .product-card-body { padding: 12px 14px 16px; display: flex; flex-direction: column; gap: 3px; }
  .product-card-price { display: flex; align-items: baseline; gap: 6px; }
  .product-card-price small { font-size: 0.7rem; color: var(--pdp-muted); }
  .product-card-price strong { font-size: 1.05rem; color: var(--success); font-weight: 800; }
  .product-card-price s { font-size: 0.75rem; color: var(--pdp-muted); }
  .product-card-vendor { font-size: 0.72rem; font-weight: 700; color: var(--pdp-muted); text-transform: uppercase; letter-spacing: 0.03em; }
  .product-card-title { font-size: 0.88rem; font-weight: 600; color: var(--color-text); line-height: 1.35; }

  .coll-pagination { display: flex; justify-content: center; gap: 8px; margin-top: 36px; }
  .coll-page-link { padding: 8px 14px; border: 1px solid var(--pdp-line); border-radius: 8px; font-size: 0.85rem; font-weight: 600; }
  .coll-page-link.is-active { background: var(--brand); border-color: var(--brand); color: #fff; }
  .coll-empty { padding: 60px 0; text-align: center; color: var(--pdp-muted); }

  @media (max-width: 900px) {
    .coll-body { grid-template-columns: 1fr; }
    .coll-sidebar { position: static; order: 2; }
    .product-grid { grid-template-columns: repeat(2, 1fr); }
    .coll-badges { grid-template-columns: 1fr; }
  }
</style>

<script>
(function () {
  var sortSelect = document.querySelector('[data-coll-sort]');
  if (sortSelect) {
    sortSelect.addEventListener('change', function () {
      var url = new URL(window.location.href);
      url.searchParams.set('sort_by', this.value);
      window.location.href = url.toString();
    });
  }
  document.querySelectorAll('[data-filter-toggle]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var group = btn.closest('[data-filter-group]');
      if (!group) return;
      if (group.hasAttribute('data-collapsed')) group.removeAttribute('data-collapsed');
      else group.setAttribute('data-collapsed', '');
    });
  });
})();
</script>

{% schema %}
{
  "name": "T-Shirt Collection",
  "settings": [
    { "type": "checkbox", "id": "show_quick_nav", "label": "Show quick category nav", "default": true },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 12, "max": 48, "step": 4, "default": 24 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Info badge",
      "settings": [
        { "type": "text", "id": "text", "label": "Badge text", "default": "Free shipping on $59+" }
      ]
    },
    {
      "type": "quick_link",
      "name": "Quick nav link",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Thumbnail (optional)" },
        { "type": "text", "id": "label", "label": "Label", "default": "Short Sleeve" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "T-Shirt Collection",
      "blocks": [
        { "type": "badge", "settings": { "text": "No Minimum Orders" } },
        { "type": "badge", "settings": { "text": "Printed & Shipped in 24 Hours" } },
        { "type": "badge", "settings": { "text": "Free Shipping on $59+" } },
        { "type": "badge", "settings": { "text": "Bulk Discounts" } }
      ]
    }
  ]
}
{% endschema %}
