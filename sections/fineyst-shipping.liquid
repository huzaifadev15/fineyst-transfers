{{ 'fineyst-shipping.css' | asset_url | stylesheet_tag }}
<section class="fy-shipping" id="fineyst-shipping-{{ section.id }}">
 <div class="fy-shipping__wrap">
  {% if section.settings.show_breadcrumb %}<nav class="fy-shipping__breadcrumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>Shipping Policy</nav>{% endif %}
  <header><div class="fy-shipping__eyebrow">{{ section.settings.eyebrow | escape }}</div><h1>{{ section.settings.heading | escape }}</h1><p class="fy-shipping__intro">{{ section.settings.introduction | escape | newline_to_br }}</p></header>
  <div class="fy-shipping__rule"></div>
  <div class="fy-shipping__layout">
   {% if section.settings.show_navigation %}<aside class="fy-shipping__aside" aria-label="On this page"><div class="fy-shipping__aside-label">On this page</div><nav class="fy-shipping__nav" aria-label="Shipping policy sections">{% for block in section.blocks %}{% if block.type == 'policy' %}<a href="#fy-policy-{{ block.id }}">{{ forloop.index | prepend: '0' | slice: -2, 2 }} · {{ block.settings.title | escape }}</a>{% endif %}{% endfor %}<a href="#fy-shipping-contact">Contact us</a></nav></aside>{% endif %}
   <div class="fy-shipping__content">
    {% assign policy_number = 0 %}
    {% for block in section.blocks %}{% if block.type == 'policy' %}{% assign policy_number = policy_number | plus: 1 %}<article class="fy-shipping__policy" id="fy-policy-{{ block.id }}" {{ block.shopify_attributes }}><h2 class="fy-shipping__heading"><span class="fy-shipping__num">{{ policy_number | prepend: '0' | slice: -2, 2 }}</span><span>{{ block.settings.title | escape }}</span></h2><div class="fy-shipping__body rte">{{ block.settings.content }}</div></article>{% endif %}{% endfor %}
    <div class="fy-shipping__contact" id="fy-shipping-contact"><h2>{{ section.settings.contact_heading | escape }}</h2><p>{{ section.settings.contact_text | escape }}</p>{% if section.settings.contact_email != blank %}<p>Email: <a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a></p>{% elsif shop.email != blank %}<p>Email: <a href="mailto:{{ shop.email | escape }}">{{ shop.email | escape }}</a></p>{% endif %}<p>Website: <a href="{{ shop.url }}">{{ shop.name | escape }}</a></p></div>
    {% if section.settings.show_tip %}<div class="fy-shipping__tip"><strong>{{ section.settings.tip_title | escape }}</strong><p>{{ section.settings.tip_text | escape }}</p></div>{% endif %}
    <div class="fy-shipping__cta"><div><h2>{{ section.settings.cta_heading | escape }}</h2><p>{{ section.settings.cta_text | escape }}</p></div><a class="fy-shipping__button" href="{{ section.settings.cta_url | default: '/pages/contact' }}">{{ section.settings.cta_label | escape }} →</a></div>
   </div>
  </div>
 </div>
</section>
{% schema %}
{
  "name": "Fineyst Shipping",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show sticky section navigation",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FINEYST TRANSFERS / ORDER & DELIVERY INFORMATION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page title",
      "default": "Shipping Policy"
    },
    {
      "type": "textarea",
      "id": "introduction",
      "label": "Introduction",
      "default": "Learn how Fineyst Transfers processes and ships orders for custom DTF transfers, UV DTF stickers, gang sheets, and printed apparel. Shipping options and any charges are shown at checkout."
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact heading",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "contact_text",
      "label": "Contact description",
      "default": "Need help with delivery or tracking? Please include your order number when contacting our support team."
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Support email (leave blank to use Shopify store email)"
    },
    {
      "type": "checkbox",
      "id": "show_tip",
      "label": "Show pro tip",
      "default": true
    },
    {
      "type": "text",
      "id": "tip_title",
      "label": "Tip heading",
      "default": "PRO TIP"
    },
    {
      "type": "textarea",
      "id": "tip_text",
      "label": "Tip copy",
      "default": "Double-check your shipping address and uploaded artwork before checkout. Production time and shipping transit time are separate."
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Support CTA heading",
      "default": "Questions About Shipping?"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "Support CTA copy",
      "default": "Contact our team for help with shipping details, tracking or delivery concerns."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Contact Shipping Support"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "policy",
      "name": "Policy section",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Section heading",
          "default": "Policy heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Policy content",
          "default": "<p>Add policy text here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Fineyst Shipping"
    }
  ]
}
{% endschema %}
