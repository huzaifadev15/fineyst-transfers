{%- comment -%}
  FAQ — structure ported from the Patches FAQ: a centred header over a
  two-column grid of bordered accordion cards with an accent stripe, chevron,
  and a checkbox toggle (no JS). Blocks are split evenly across the columns.
{%- endcomment -%}

{%- assign total = section.blocks.size -%}
{%- assign half = total | plus: 1 | divided_by: 2 -%}

<section class="faq-section" aria-labelledby="faq-heading">
  <div class="faq-container">

    <header class="faq-header">
      <h2 id="faq-heading" class="faq-title">{{ section.settings.heading | default: 'DTF Transfers FAQ' }}</h2>
      <p class="faq-subtitle">{{ section.settings.subheading | default: 'Find answers to common questions about our transfers and services' }}</p>
    </header>

    <div class="faq-grid">
      {%- for col in (1..2) -%}
        <div class="faq-col">
          {%- for block in section.blocks -%}
            {%- if col == 1 and forloop.index > half -%}{%- continue -%}{%- endif -%}
            {%- if col == 2 and forloop.index <= half -%}{%- continue -%}{%- endif -%}
            {%- assign faq_id = section.id | append: '-faq-' | append: forloop.index -%}
            <div class="faq-item" {{ block.shopify_attributes }}>
              <input class="faq-toggle" type="checkbox" id="{{ faq_id }}">
              <label class="faq-btn" for="{{ faq_id }}">
                <span class="faq-accent"></span>
                <h3 class="faq-question">{{ block.settings.question }}</h3>
                <svg class="faq-chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </label>
              <div class="faq-answer">{{ block.settings.answer }}</div>
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "DTF Transfers FAQ" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Find answers to common questions about our transfers and services" }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "What is a DTF transfer?", "answer": "<p>A direct-to-film transfer is your artwork printed onto film and heat-applied to fabric. It gives vivid full-color detail with a soft, flexible finish and strong wash durability.</p>" } },
        { "type": "faq_item", "settings": { "question": "Is there a minimum order?", "answer": "<p>No minimum, ever. Order a single transfer or thousands - the price per square inch stays the same, and volume discounts kick in automatically as your order grows.</p>" } },
        { "type": "faq_item", "settings": { "question": "What equipment do I need?", "answer": "<p>A heat press gives the most consistent results, but a household iron or a Cricut EasyPress works too. You need steady heat, even pressure, and about 15 seconds.</p>" } },
        { "type": "faq_item", "settings": { "question": "How long do transfers last?", "answer": "<p>Our transfers are lab-tested past 100 wash cycles without cracking, peeling, or fading. Wash inside out in cold water to get the most life out of them.</p>" } },
        { "type": "faq_item", "settings": { "question": "What file format should I upload?", "answer": "<p>PNG with a transparent background at 300 DPI is ideal. We also accept PDF, AI, SVG, TIFF, and JPG. If a file is not print-ready, our art team cleans it up free of charge.</p>" } },
        { "type": "faq_item", "settings": { "question": "How fast is production?", "answer": "<p>Most orders are printed and shipped within 24 hours. Order before the daily cutoff and your transfers leave the building the next business day.</p>" } },
        { "type": "faq_item", "settings": { "question": "What payment methods do you accept?", "answer": "<p>All major credit cards, PayPal, Shop Pay, Apple Pay, and Google Pay. Every transaction is encrypted and processed securely at checkout.</p>" } },
        { "type": "faq_item", "settings": { "question": "Do you ship internationally?", "answer": "<p>Yes, we ship worldwide. Shipping is free on qualifying US orders. International rates and delivery windows vary by destination and are calculated at checkout.</p>" } },
        { "type": "faq_item", "settings": { "question": "Can I put multiple designs on one sheet?", "answer": "<p>That is exactly what a gang sheet is for. Use the Gang Sheet Builder to arrange as many designs as you can fit, and you only pay for the sheet space you use.</p>" } },
        { "type": "faq_item", "settings": { "question": "How do I track my order?", "answer": "<p>You will get a tracking number by email as soon as your order ships, and you can follow it in real time from your account or the carrier's site.</p>" } }
      ]
    }
  ]
}
{% endschema %}
