<style>
  .bbg-section { background: #fff; padding: 36px 0 8px; }
  .bbg-inner { max-width: 1400px; margin: 0 auto; padding: 0 40px; }
  .bbg-header { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .bbg-title { font-size: 22px; font-weight: 800; color: #0F0F1A; margin: 0; }
  .bbg-view-all { display: inline-flex; align-items: center; gap: 4px; font-size: 14px; font-weight: 600; color: var(--brand); }
  .bbg-view-all:hover { color: var(--brand-dark); }
  .bbg-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .bbg-card { display: flex; align-items: center; justify-content: center; aspect-ratio: 3 / 2; background: #fff; border: 1px solid #EFEFEF; border-radius: 14px; overflow: hidden; transition: border-color .15s, box-shadow .15s, transform .15s; }
  .bbg-card:hover { border-color: var(--brand); box-shadow: 0 4px 14px rgba(62,109,142,0.14); transform: translateY(-2px); }
  /* Logo art is supplied on its own flat backdrop, so it fills the tile edge to edge. */
  .bbg-card-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bbg-card-word { padding: 14px; font-size: 15px; font-weight: 800; letter-spacing: -0.02em; color: #2A2A2A; text-align: center; line-height: 1.2; }

  @media (max-width: 1100px) { .bbg-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 900px)  { .bbg-inner { padding: 0 20px; } .bbg-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 600px)  { .bbg-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .bbg-title { font-size: 19px; } }
</style>

{%- comment -%}
  Shop by Brand — a grid of logo tiles, modelled on the Ninja blank-apparel
  brand strip. Blocks without a logo image fall back to the brand name set in
  wordmark type, so the section is useful before any logo art exists.
{%- endcomment -%}

<section class="bbg-section">
  <div class="bbg-inner">

    <div class="bbg-header">
      <h2 class="bbg-title">{{ section.settings.heading | default: 'Shop by Brand' }}</h2>
      {%- if section.settings.view_all_link != blank -%}
        <a href="{{ section.settings.view_all_link }}" class="bbg-view-all">
          {{ section.settings.view_all_text | default: 'Shop All Brands' }} <span aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>

    <div class="bbg-grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="bbg-card" {{ block.shopify_attributes }}>
          {%- if block.settings.logo -%}
            {{ block.settings.logo | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.name, class: 'bbg-card-img' }}
          {%- elsif block.settings.static_logo != blank -%}
            {%- comment -%}
              Liquid cannot test whether an asset exists, so a missing or misnamed
              file falls back to the wordmark rather than a broken-image icon.
            {%- endcomment -%}
            <img src="{{ block.settings.static_logo | strip | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy" class="bbg-card-img"
                 onerror="this.style.display='none';this.nextElementSibling.removeAttribute('hidden');">
            <span class="bbg-card-word" hidden>{{ block.settings.name }}</span>
          {%- else -%}
            <span class="bbg-card-word">{{ block.settings.name }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>


{% schema %}
{
  "name": "Shop by Brand",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Brand" },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "Shop All Brands" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Takes priority over the static file below." },
        { "type": "text", "id": "static_logo", "label": "Static logo file", "info": "Filename in /assets, e.g. brand-gildan.png. Falls back to the brand name if both are empty." },
        { "type": "text", "id": "name", "label": "Brand name", "default": "Gildan" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Brand",
      "blocks": [
        { "type": "brand", "settings": { "name": "Gildan" } },
        { "type": "brand", "settings": { "name": "Bella + Canvas" } },
        { "type": "brand", "settings": { "name": "Next Level" } },
        { "type": "brand", "settings": { "name": "Comfort Colors" } },
        { "type": "brand", "settings": { "name": "Hanes" } },
        { "type": "brand", "settings": { "name": "Team 365" } },
        { "type": "brand", "settings": { "name": "Jerzees" } },
        { "type": "brand", "settings": { "name": "Augusta Sportswear" } },
        { "type": "brand", "settings": { "name": "UltraClub" } },
        { "type": "brand", "settings": { "name": "Tultex" } }
      ]
    }
  ]
}
{% endschema %}
