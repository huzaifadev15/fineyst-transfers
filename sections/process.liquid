<section class="process">
  <div class="container">
    <div class="process-head">
      <h2>{{ section.settings.heading | default: "The Fineyst DTF Process" }}</h2>
      {% if section.settings.tagline != blank %}
        <p class="process-tagline">{{ section.settings.tagline }}</p>
      {% endif %}
    </div>

    <ol class="process-steps">
      {% for block in section.blocks %}
        <li class="process-step" {{ block.shopify_attributes }}>
          <div class="process-media">
            {% if block.settings.video %}
              {{ block.settings.video | video_tag: image_size: '800x', autoplay: true, loop: true, muted: true, controls: false }}
            {% elsif block.settings.image %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {% elsif block.settings.static_video != blank %}
              <video src="{{ block.settings.static_video | asset_url }}" autoplay loop muted playsinline></video>
            {% elsif block.settings.static_image != blank %}
              <img src="{{ block.settings.static_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy">
            {% else %}
              <div class="process-media-placeholder"></div>
            {% endif %}
          </div>
          <h3>{{ block.settings.title | escape }}</h3>

{%- assign process_text = block.settings.text | escape -%}

{%- if forloop.first -%}
  {%- assign process_text = process_text
    | replace: 'custom DTF transfers', '<a href="/products/dtf-transfers">custom DTF transfers</a>'
  -%}
{%- endif -%}

{%- if forloop.last -%}
  {%- assign process_text = process_text
    | replace: 'Press at 310°F', '<a href="/pages/pressing-instructions">Press at 310°F</a>'
  -%}
{%- endif -%}

<p>{{ process_text }}</p>
        </li>
      {% endfor %}
    </ol>


      
<div class="process-slider-dots" aria-label="Process slider navigation">
  {% for block in section.blocks %}
    <button
      type="button"
      class="process-slider-dot{% if forloop.first %} is-active{% endif %}"
      aria-label="Go to step {{ forloop.index }}"
      aria-current="{% if forloop.first %}step{% else %}false{% endif %}"
      data-slide="{{ forloop.index0 }}">
    </button>
  {% endfor %}
</div>





  </div>
</section>




<script>
(function () {
  const section = document.currentScript.closest('.shopify-section')
    || document.currentScript.parentElement;

  function initProcessSlider() {
    const slider = section.querySelector('.process-steps');
    const dots = section.querySelectorAll('.process-slider-dot');
    const slides = section.querySelectorAll('.process-step');

    if (!slider || !dots.length || !slides.length) return;

    const updateDots = () => {
      const index = Math.max(0, Math.min(
        slides.length - 1,
        Math.round(slider.scrollLeft / (slides[0].getBoundingClientRect().width + 16))
      ));

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-current', i === index ? 'step' : 'false');
      });
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        slider.scrollTo({
          left: slides[index].offsetLeft - slides[0].offsetLeft,
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
            ? 'instant' : 'smooth'
        });
      });
    });

    slider.addEventListener('scroll', updateDots, { passive: true });
    window.addEventListener('resize', updateDots);
    updateDots();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProcessSlider);
  } else {
    initProcessSlider();
  }
})();
</script>






{% schema %}
{
  "name": "Process",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Fineyst DTF Process" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Faster. Simpler. Satisfaction Guaranteed." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Plays muted on loop. Takes priority over the image." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "static_image", "label": "Static image file", "info": "Filename in /assets, e.g. dtf-1.jpg. Used when no image is picked." },
        { "type": "text", "id": "static_video", "label": "Static video file", "info": "Filename in /assets, e.g. dtf-video-1.mp4. Takes priority over the static image." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Process",
      "blocks": [
        { "type": "step", "settings": { "title": "Upload Your Design & Order Online", "text": "From simple graphics to high-detail artwork, upload any design with unlimited colors. We convert it into a high-quality DTF transfer, ready to press." } },
        { "type": "step", "settings": { "title": "Printed & Shipped in 24–48 Hours", "text": "We produce your transfer for sharp detail, vibrant color, and consistent, professional-grade results." } },
        { "type": "step", "settings": { "title": "Heat Press or Iron when Ready", "text": "Press at 310°F / 155°C with medium pressure for 12–15 seconds. Repress for 5 seconds for maximum durability. Unused transfers store long-term without loss of quality." } }
      ]
    }
  ]
}
{% endschema %}
