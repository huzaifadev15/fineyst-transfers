{%- liquid
  assign rating = product.metafields.reviews.rating | default: section.settings.rating_value
  assign rating_count = product.metafields.reviews.rating_count | default: section.settings.rating_count
-%}

<section class="main-product main-product-dtf-transfer pdp">
  <div class="container pdp-inner">

    <div class="pdp-media">
      {%- comment -%}
        The full image list travels on the gallery element so the arrows work
        even when there is no thumbnail row (single-image products), and so the
        arrows can be hidden outright when there is nothing to page through.
      {%- endcomment -%}
      {%- comment -%}
        Gallery carries images only. Product videos render below the thumbnails
        in the promo slot, matching the Ninja layout, rather than sitting in the
        image carousel.
      {%- endcomment -%}
      {%- assign image_count = product.images.size -%}

      <div class="product-gallery" data-gallery>
        {%- if image_count > 1 -%}
          <button class="gallery-arrow gallery-arrow--prev" aria-label="Previous image">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
        {%- endif -%}

        <div class="gallery-main" data-gallery-main>
          {%- if image_count > 0 -%}
            {%- for image in product.images -%}
              <div class="gallery-slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide>
                <img src="{{ image | image_url: width: 1400 }}"
                     alt="{{ image.alt | escape }}"
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     sizes="(min-width: 990px) 45vw, 100vw">
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="hero-media-placeholder"></div>
          {%- endif -%}
        </div>

        {%- if image_count > 1 -%}
          <button class="gallery-arrow gallery-arrow--next" aria-label="Next image">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if image_count > 1 -%}
        <div class="gallery-thumbs">
          {%- for image in product.images -%}
            <button class="gallery-thumb{% if forloop.first %} is-active{% endif %}" type="button"
                    data-gallery-thumb data-index="{{ forloop.index0 }}"
                    aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Product videos sit here, under the thumbnails. {%- endcomment -%}
      {%- assign product_videos = product.media | where: 'media_type', 'video' -%}
      {%- if product_videos.size > 0 -%}
        <div class="gallery-videos">
          {%- for media in product_videos -%}
            <div class="gallery-video">
              {{ media | video_tag: image_size: '1200x', controls: true, muted: true, playsinline: true }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {% if section.settings.feature_video != blank or section.settings.feature_image %}
        <a class="gallery-feature" href="{{ section.settings.feature_link | default: '#' }}">
          {% if section.settings.feature_video != blank %}
            <video autoplay muted loop playsinline preload="metadata"
                   {% if section.settings.feature_image %}poster="{{ section.settings.feature_image | image_url: width: 900 }}"{% endif %}>
              <source src="{{ section.settings.feature_video | file_url }}" type="video/mp4">
            </video>
          {% else %}
            {{ section.settings.feature_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: 'See VIVID AF in action' }}
          {% endif %}
        </a>
      {% endif %}
    </div>

    <div class="pdp-info">
      <div class="pdp-title-row">
        <h1>{{ product.title }}</h1>
        {% if section.settings.badge_text != blank %}
          <span class="pdp-flag">{{ section.settings.badge_text }}</span>
        {% endif %}
      </div>

      <div class="pdp-meta">
        <span class="pdp-meta-item pdp-meta-price">
          <strong>As Low As</strong>
          {% if section.settings.unit_price != blank %}
            {{ section.settings.unit_price }}
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </span>
        {% if section.settings.fulfillment_note != blank %}
          <span class="pdp-meta-item">{{ section.settings.fulfillment_note }}</span>
        {% endif %}
        {% if rating_count != blank %}
          <span class="pdp-meta-item pdp-meta-rating">
            <span class="pdp-stars" aria-hidden="true">★★★★★</span>
            <a href="#reviews">{{ rating_count }} Reviews</a>
          </span>
        {% endif %}
      </div>

      <ul class="pdp-features">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3l3 2 3-2 5 3-2 4-2-1v12H8V9L6 10 4 6z"/></svg>
          <span>Works on Any Fabric or Color</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="13" r="4"/><path d="M8 6.5h2"/></svg>
          <span>Certified for {{ section.settings.wash_count }}+ Washes</span>
          <button type="button" class="pdp-info-dot" aria-label="More about wash testing" data-tip="Independently lab-tested through {{ section.settings.wash_count }} home wash and dry cycles with no cracking or peeling.">i</button>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4z"/><path d="M18 16l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>
          <span>Vibrant Colors &amp; Ultra-fine Details</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.3-2.9 8.1-7 9.5-4.1-1.4-7-5.2-7-9.5V6z"/><path d="M9 12l2 2 4-4"/></svg>
          <span>100% Satisfaction Guaranteed</span>
        </li>
      </ul>

      <div class="pdp-strip">
        <a class="pdp-strip-link" href="{{ section.settings.volume_link | default: '#pricing' }}">{{ section.settings.volume_text }}</a>
        <span class="pdp-strip-item pdp-delivery" data-delivery data-cutoff-hour="{{ section.settings.cutoff_hour }}">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8l-9-5-9 5v8l9 5 9-5z"/><path d="M3.3 7.5L12 12.5l8.7-5M12 21.5v-9"/></svg>
          Fastest Delivery <strong data-delivery-date>—</strong> order in <strong data-delivery-countdown>—</strong>
        </span>
        <span class="pdp-strip-item">No Minimum, Setup or Art Fees</span>
      </div>

      <div class="upload-card">
        <div class="upload-card-head">
          <h2>Upload Your Artwork</h2>
          <div class="upload-tabs">
            <button type="button" class="upload-tab is-active">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15V4M8 8l4-4 4 4"/><path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3"/></svg>
              Upload
            </button>
            <a class="upload-tab" href="/pages/design-library">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M4 17l5-5 4 4 3-2 4 4"/></svg>
              Previous Designs
            </a>
            <a class="upload-tab" href="/pages/ai-tools">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4z"/><path d="M18.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/></svg>
              Create with AI
            </a>
            <a class="upload-tab" href="/pages/design-studio">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              Design Studio
            </a>
          </div>
        </div>

        <div class="upload-card-body">
          <div class="upload-dropzone" data-upload-dropzone>
            <span class="upload-icon">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 18a4 4 0 0 1-.6-7.95 5.5 5.5 0 0 1 10.7-1.6A3.75 3.75 0 0 1 17.5 18"/><path d="M12 21v-8M9 15.5l3-3 3 3"/></svg>
            </span>
            <p class="upload-title">Upload your files (up to {{ section.settings.max_files }})</p>
            <p class="upload-sub">Drag and drop files here or click to browse</p>
            <input type="file" accept="image/*,.pdf,.ai,.eps,.svg,.psd" multiple hidden data-upload-input>
            <button type="button" class="btn-blue" data-upload-browse>Browse</button>
            <ul class="upload-file-list" data-upload-file-list></ul>
          </div>

          <a class="upload-phone" href="{{ section.settings.phone_upload_link | default: '#' }}">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14h1M17 20h4M14 20h1"/></svg>
            Upload from your phone
          </a>
        </div>

        {% if section.settings.show_ai_tools %}
        <div class="ai-tools-panel">
          <span class="ai-tools-label">AI Tools</span>
          <div class="ai-tools-row">
            <span>Remove Background</span>
            <button type="button" class="ai-toggle" data-ai-toggle aria-pressed="false" aria-label="Remove background"></button>
          </div>
          <div class="ai-tools-row">
            <span>Upscale Image</span>
            <button type="button" class="ai-toggle" data-ai-toggle aria-pressed="false" aria-label="Upscale image"></button>
          </div>
          <a class="ai-edit-btn" href="/pages/ai-tools">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4z"/></svg>
            More AI Edit Tools
          </a>
        </div>
        {% endif %}
      </div>

      {%- comment -%}
        Popular Sizes & Prices — shown before an upload so shoppers can see real
        prices without having to pick a file first. Hidden once the editor opens.
      {%- endcomment -%}
      {%- assign quick_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'quick_size' -%}{%- assign quick_count = quick_count | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
      {%- if quick_count > 0 -%}
        <div class="quick-sizes">
          <div class="quick-sizes-head">
            <h3>{{ section.settings.quick_title | default: 'Popular Sizes &amp; Prices' }}</h3>
            <p>{{ section.settings.quick_sub | default: 'No setup fees · Bulk discounts up to 50% off' }}</p>
          </div>
          <div class="quick-sizes-row">
            {%- for block in section.blocks -%}
              {%- if block.type == 'quick_size' -%}
                <div class="quick-size" {{ block.shopify_attributes }}>
                  <span class="quick-size-dim">{{ block.settings.label }}</span>
                  <span class="quick-size-note">as low as</span>
                  <span class="quick-size-price">{{ block.settings.price }}<small>ea</small></span>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <div class="editor" data-editor data-dpi="{{ section.settings.print_dpi }}" data-max-width="{{ section.settings.max_print_width }}">
        <div class="editor-grid">

          <aside class="editor-panel size-guide">
            <div class="size-guide-inner">
              <h3>{{ section.settings.size_guide_title }}</h3>
              <p class="size-guide-sub">Hover over any image to enlarge</p>
              <div class="size-guide-grid" data-preview-stage>
                {% for block in section.blocks %}
                  {% if block.type == 'mockup' %}
                    <figure class="mockup" {{ block.shopify_attributes }} data-mockup data-width-in="{{ block.settings.width_in }}">
                      <figcaption class="mockup-size" data-mockup-size>{{ block.settings.width_in }}"</figcaption>
                      <div class="mockup-tile">
                        {% if block.settings.image %}
                          {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.label }}
                        {% else %}
                          <span class="mockup-placeholder">{{ block.settings.label }}</span>
                        {% endif %}
                        <img class="mockup-art" data-mockup-art alt="" style="width: {{ block.settings.art_width }}%; top: {{ block.settings.art_top }}%;">
                      </div>
                    </figure>
                  {% endif %}
                {% endfor %}
              </div>
              <p class="swatch-label">Change your preview items to any color below:</p>
              <div class="swatches" data-swatches>
                {% assign swatch_colors = section.settings.swatch_colors | split: ',' %}
                {% for color in swatch_colors %}
                  {% assign hex = color | strip %}
                  <button type="button" class="swatch {% if forloop.first %}is-active{% endif %}" data-swatch data-color="{{ hex }}" style="--swatch: {{ hex }}" aria-label="Preview color {{ hex }}"></button>
                {% endfor %}
                <button type="button" class="swatch swatch--multi" data-swatch data-color="" aria-label="Original color"></button>
              </div>
            </div>
          </aside>

          <div class="editor-mid">
          <div class="editor-panel editor-stage">
            <h2 class="editor-step"><span>Step 1:</span> Customize Your Image</h2>

            <div class="editor-body">
              <div class="editor-rail">
                <span class="rail-label">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                  AI Tools
                </span>

                <div class="rail-tool rail-tool--open" data-rail-tool>
                  <div class="rail-tool-head">
                    <span>Remove Background</span>
                    <button type="button" class="ai-toggle" data-ai-toggle data-controls="bg-options" aria-pressed="true" aria-label="Remove background"></button>
                  </div>
                  <div class="rail-options" data-bg-options>
                    {% for i in (1..3) %}
                      <button type="button" class="rail-option {% if forloop.first %}is-active{% endif %}" data-rail-option data-index="{{ forloop.index }}">
                        <span class="rail-option-thumb">
                          <img data-option-art alt="">
                          <span class="rail-spinner" aria-hidden="true"></span>
                        </span>
                        <span class="rail-option-label">Option {{ forloop.index }}</span>
                      </button>
                    {% endfor %}
                  </div>
                </div>

                <div class="rail-tool">
                  <div class="rail-tool-head">
                    <span>Upscale</span>
                    <button type="button" class="ai-toggle" data-ai-toggle aria-pressed="false" aria-label="Upscale image"></button>
                  </div>
                </div>

                <button type="button" class="rail-more" data-rail-more aria-expanded="false">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4z"/></svg>
                  AI Edit Tools
                  <svg class="rail-more-caret" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                </button>
                <div class="rail-more-panel" data-rail-more-panel hidden>
                  <a href="/pages/ai-tools">Recolor artwork</a>
                  <a href="/pages/ai-tools">Sharpen edges</a>
                  <a href="/pages/ai-tools">Remove white box</a>
                  <a href="/pages/design-studio">Open Design Studio</a>
                </div>
              </div>

              <div class="editor-canvas-wrap">
                <div class="canvas-dim canvas-dim--w"><span data-dim-w>—</span></div>
                <div class="canvas-dim canvas-dim--h"><span data-dim-h>—</span></div>
                <div class="editor-canvas" data-canvas>
                  <button type="button" class="canvas-btn canvas-btn--delete" data-canvas-delete aria-label="Remove artwork">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6"/><path d="M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
                  </button>
                  <button type="button" class="canvas-btn canvas-btn--zoom" data-canvas-zoom aria-label="Zoom artwork">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8.5v5M8.5 11h5"/></svg>
                  </button>
                  <img class="canvas-art" data-canvas-art alt="Your uploaded artwork">
                </div>
              </div>
            </div>

            <label class="design-notes-toggle">
              <input type="checkbox" data-notes-toggle>
              <span>
                <strong>Need more than AI Edits? Add Design Notes</strong>
                We'll handle the rest before printing
              </span>
            </label>
            <textarea class="design-notes" data-notes name="properties[Design Notes]" rows="3" placeholder="Tell our art team what to change…" hidden></textarea>
          </div>

          <div class="editor-panel size-step" data-sizes>
            <h2 class="editor-step"><span>Step 2:</span> Choose your Transfer Sizes</h2>

            <div class="size-tabs">
              <button type="button" class="size-tab is-active" data-size-tab="custom">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" stroke-dasharray="3 2.5"/><circle cx="9" cy="10" r="1.6"/><path d="M4 17l4.5-4.5 3.5 3.5 3-2.5 5 4"/></svg>
                Custom Size
              </button>
              <button type="button" class="size-tab" data-size-tab="popular">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5l1.5 3.2 3.3.4-2.4 2.2.6 3.2-3-1.6-3 1.6.6-3.2-2.4-2.2 3.3-.4z"/></svg>
                Popular Size
              </button>
            </div>

            <div class="size-panel" data-size-panel="custom">
              <p class="size-help">Need help with sizing? Choose a <button type="button" class="size-help-link" data-size-tab="popular">Popular Size</button></p>

              <div class="size-head">
                <span>Width (inches)</span><span>Height (inches)</span><span>Qty</span><span>Price</span><span>Total</span><span></span><span></span>
              </div>
              <div class="size-rows" data-size-rows></div>

              <template data-size-template>
                <div class="size-row" data-size-row>
                  <label class="size-field"><span class="size-field-label">Width (inches)</span>
                    <input type="number" step="0.01" min="{{ section.settings.min_print_size }}" max="{{ section.settings.max_print_width }}" data-size-w>
                  </label>
                  <label class="size-field"><span class="size-field-label">Height (inches)</span>
                    <input type="number" step="0.01" min="{{ section.settings.min_print_size }}" max="{{ section.settings.max_print_width }}" data-size-h>
                  </label>
                  <label class="size-field size-field--qty"><span class="size-field-label">Qty</span>
                    <input type="number" step="1" min="1" value="1" data-size-qty>
                  </label>
                  <div class="size-cell">
                    <span class="size-field-label">Price</span>
                    <s data-size-was></s>
                    <span class="size-amount"><strong data-size-price>—</strong> <small>ea</small></span>
                  </div>
                  <div class="size-cell">
                    <span class="size-field-label">Total</span>
                    <s data-size-total-was></s>
                    <span class="size-amount"><strong data-size-total>—</strong></span>
                  </div>
                  <span class="size-off" data-size-off></span>
                  <button type="button" class="size-remove" data-size-remove aria-label="Remove this size">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
                  </button>
                </div>
              </template>

              <button type="button" class="size-add" data-size-add>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                Add another size of this design
              </button>
            </div>

            <div class="size-panel" data-size-panel="popular" hidden>
              <p class="size-help">Tap a size to add it. Heights follow your artwork's proportions.</p>
              <div class="popular-sizes">
                {% for block in section.blocks %}
                  {% if block.type == 'mockup' %}
                    <button type="button" class="popular-size" data-popular-size data-width-in="{{ block.settings.width_in }}">
                      <strong>{{ block.settings.width_in }}"</strong>
                      <span>{{ block.settings.label }}</span>
                    </button>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
          </div>

          <aside class="editor-panel discount-card">
            <h3 class="discount-title">Buy More &amp; Save w/ <span>Cumulative Discounts</span></h3>
            <p class="discount-sub">{{ section.settings.discount_note }}</p>

            <div class="tier-table" data-tiers data-qty="{{ section.settings.default_qty }}" data-bands="{{ section.settings.price_bands | escape }}">
              <div class="tier-head">
                <span>Total Qty</span><span>Price</span><span>Discount</span>
              </div>
              <button type="button" class="tier-viewall" data-tier-viewall aria-expanded="false">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                View All
              </button>
              <div class="tier-rows" data-tier-rows>
                {% for block in section.blocks %}
                  {% if block.type == 'tier' %}
                    <div class="tier-row" {{ block.shopify_attributes }} data-tier data-min="{{ block.settings.min_qty }}" data-max="{{ block.settings.max_qty }}" data-pct="{{ block.settings.pct }}">
                      <div class="tier-cells">
                        <span class="tier-qty">{{ block.settings.min_qty }}{% if block.settings.max_qty > 0 %}-{{ block.settings.max_qty }}{% else %}+{% endif %}</span>
                        <span class="tier-price"><span data-tier-price>{{ block.settings.price }}</span> <small>ea</small></span>
                        <span class="tier-discount">{{ block.settings.discount }}</span>
                      </div>
                      <p class="tier-hint" data-tier-hint hidden></p>
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>

            {% if section.settings.guarantee_text != blank %}
              <div class="guarantee">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.6 5.6 6 .8-4.4 4.2 1.1 6-5.3-3-5.3 3 1.1-6L3.4 9.4l6-.8z"/></svg>
                <p><strong>{{ section.settings.guarantee_title }}</strong> <em>{{ section.settings.guarantee_text }}</em></p>
              </div>
            {% endif %}
          </aside>

        </div>
      </div>

      {% if section.settings.show_buy_form %}
      {% form 'product', product, class: 'pdp-form' %}
        {% unless product.has_only_default_variant %}
          <div class="pdp-options">
            {% for option in product.options_with_values %}
              <label class="pdp-option">
                <span>{{ option.name }}</span>
                <select name="options[{{ option.name }}]">
                  {% for value in option.values %}
                    <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                  {% endfor %}
                </select>
              </label>
            {% endfor %}
          </div>
        {% endunless %}

        <div class="pdp-buy">
          <label class="pdp-qty">
            <span class="visually-hidden">Quantity</span>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric">
          </label>
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn-blue btn-blue--lg" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}
              Add to Cart <span class="pdp-buy-price">{{ product.price | money }}</span>
            {% else %}
              Sold Out
            {% endif %}
          </button>
        </div>
      {% endform %}
      {% endif %}

      {% if product.description != blank %}
        <div class="pdp-description rte">{{ product.description }}</div>
      {% endif %}
    </div>

  </div>
</section>

