{%- comment -%}
  Section: Instant price check
  File location in theme: sections/instant-price-check.liquid
  Prices, links and discounts are editable from the Theme Editor (no code needed).
{%- endcomment -%}

<section class="fx-wrap" data-fx
  data-dtf-rate="{{ section.settings.dtf_rate | escape }}" data-dtf-min="{{ section.settings.dtf_min | escape }}" data-dtf-url="{{ section.settings.dtf_url | escape }}" data-dtf-presets="{{ section.settings.dtf_presets | escape }}"
  data-uv-rate="{{ section.settings.uv_rate | escape }}" data-uv-min="{{ section.settings.uv_min | escape }}" data-uv-url="{{ section.settings.uv_url | escape }}" data-uv-presets="{{ section.settings.uv_presets | escape }}"
  data-gang-rate="{{ section.settings.gang_rate | escape }}" data-gang-min="{{ section.settings.gang_min | escape }}" data-gang-url="{{ section.settings.gang_url | escape }}"
  data-uvgang-rate="{{ section.settings.uvgang_rate | escape }}" data-uvgang-min="{{ section.settings.uvgang_min | escape }}" data-uvgang-url="{{ section.settings.uvgang_url | escape }}"
  data-tiers="{{ section.settings.tiers | escape }}"
  data-maxside="{{ section.settings.max_side | escape }}">

<style>
  .fx-wrap{--green:#0f3d2e;--lime:#b6f500;--tint:#eef7ee;--tint2:#e3f1e5;--page:{{ section.settings.bg_color }};--line:#e1e8e3;--mut:#6b7a73;
    font-family:inherit,system-ui,sans-serif;background:var(--page);color:var(--green);padding:56px 20px}
  .fx-wrap *{box-sizing:border-box}
  .fx-head{text-align:center;max-width:620px;margin:0 auto 28px}
  .fx-head h2{font-size:clamp(24px,3.2vw,34px);line-height:1.15;margin:0 0 8px;font-weight:800;color:var(--green)}
  .fx-head p{margin:0;color:var(--mut);font-size:14px;line-height:1.6}
  .fx-card{max-width:960px;margin:0 auto;background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;
    display:grid;grid-template-columns:1.3fr .7fr;gap:28px;box-shadow:0 8px 30px rgba(15,61,46,.06)}
  .fx-tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
  .fx-tab{background:#fff;border:1px solid var(--line);color:var(--green);padding:9px 16px;font-size:13px;font-weight:600;font-family:inherit;cursor:pointer;border-radius:999px}
  .fx-tab[aria-pressed=true]{background:var(--green);border-color:var(--green);color:#fff}
  .fx-lbl{font-size:12px;font-weight:700;color:var(--mut);margin:0 0 8px}
  .fx-row{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:6px}
  .fx-f{display:flex;flex-direction:column;gap:6px;font-size:12px;font-weight:600;color:var(--mut)}
  .fx-f input{width:112px;height:42px;border:1px solid var(--line);border-radius:10px;padding:0 12px;font-size:15px;font-weight:600;font-family:inherit;color:var(--green);background:#fff;margin:0}
  .fx-q{display:flex;height:42px;border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#fff}
  .fx-q button{width:38px;border:0;background:var(--tint);color:var(--green);font-size:18px;cursor:pointer;padding:0}
  .fx-q input{width:56px;border:0;border-radius:0;text-align:center;height:100%}
  .fx-err{color:#b45309;font-size:12px;min-height:18px;margin:4px 0 10px}
  .fx-sizes{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:8px}
  .fx-size{display:flex;justify-content:space-between;gap:6px;background:var(--tint);border:1px solid var(--tint2);color:var(--green);padding:10px;font-size:12.5px;font-weight:600;font-family:inherit;cursor:pointer;border-radius:10px}
  .fx-size span{color:var(--mut);font-weight:600}
  .fx-size[aria-pressed=true]{background:#fff;border-color:var(--green);box-shadow:0 0 0 1px var(--green)}
  .fx-res{background:var(--tint);border:1px solid var(--tint2);border-radius:14px;padding:22px;display:flex;flex-direction:column}
  .fx-res small{color:var(--mut);font-size:12px;font-weight:600}
  .fx-total{font-size:46px;font-weight:800;line-height:1;margin:8px 0 16px;color:var(--green)}
  .fx-line{display:flex;justify-content:space-between;padding:11px 0;border-top:1px solid var(--tint2);font-size:13px;color:var(--mut)}
  .fx-line b{color:var(--green);font-weight:700}
  .fx-note{font-size:11.5px;color:var(--mut);line-height:1.5;margin:12px 0 18px}
  .fx-cta{display:block;text-align:center;background:var(--lime);color:var(--green);font-weight:800;font-size:14px;padding:13px;border-radius:999px;text-decoration:none;margin-top:auto}
  .fx-cta:hover{filter:brightness(.96)}
  .fx-wrap button:focus-visible,.fx-wrap input:focus-visible,.fx-cta:focus-visible{outline:3px solid var(--green);outline-offset:2px}
  @media(max-width:820px){.fx-card{grid-template-columns:1fr;padding:20px}.fx-total{font-size:40px}}
</style>

<div class="fx-head">
  <h2>{{ section.settings.heading | escape }}</h2>
  <p>{{ section.settings.subheading | escape }}</p>
</div>

<div class="fx-card">
  <div>
    <div class="fx-tabs" data-tabs></div>
    <div class="fx-lbl">Your size</div>
    <div class="fx-row">
      <label class="fx-f">Width (in)<input data-w type="number" min="1" step="0.1" value="10"></label>
      <label class="fx-f">Height (in)<input data-h type="number" min="1" step="0.1" value="10"></label>
      <div class="fx-f">Quantity
        <div class="fx-q"><button type="button" data-minus aria-label="Decrease quantity">−</button><input data-q type="number" min="1" value="1"><button type="button" data-plus aria-label="Increase quantity">+</button></div>
      </div>
    </div>
    <div class="fx-err" data-err role="alert"></div>
    <div data-pop>
      <div class="fx-lbl">Popular sizes</div>
      <div class="fx-sizes" data-sizes></div>
    </div>
  </div>
  <aside class="fx-res" aria-live="polite">
    <small data-what></small>
    <div class="fx-total" data-total>$0.00</div>
    <div class="fx-line"><span>Rate</span><b data-rate>—</b></div>
    <div class="fx-line"><span>Per piece</span><b data-per>—</b></div>
    <p class="fx-note">Printing price only. Blank garments, shipping and tax are not included.</p>
    <a class="fx-cta" data-go href="{{ section.settings.dtf_url }}">Order this size</a>
  </aside>
</div>

<script>
(function(){
  document.querySelectorAll('.fx-wrap[data-fx]').forEach(function(root){
    if(root.dataset.ready)return; root.dataset.ready=1;
    var d=root.dataset, $=function(s){return root.querySelector(s)};
    var num=function(v,f){v=parseFloat(v);return isNaN(v)?f:v};
    function presets(str){
      var o={},list=[];
      (str||'').split(/[,\n]+/).forEach(function(p){
        var m=p.trim().toLowerCase().replace(/[×"in]/g,function(c){return c=='×'?'x':''}).match(/^([\d.]+)\s*x\s*([\d.]+)\s*[:=]\s*\$?([\d.]+)$/);
        if(m){var k=m[1]+'x'+m[2];o[k]=parseFloat(m[3]);list.push(k)}
      });
      return {map:o,list:list};
    }
    var C={
      dtf:{label:'DTF by size',rate:num(d.dtfRate,.045),min:num(d.dtfMin,.18),url:d.dtfUrl,pre:presets(d.dtfPresets)},
      uv:{label:'UV DTF by size',rate:num(d.uvRate,.08),min:num(d.uvMin,.3),url:d.uvUrl,pre:presets(d.uvPresets)},
      gang:{label:'DTF gang sheet',rate:num(d.gangRate,.02),min:num(d.gangMin,6),url:d.gangUrl,pre:presets(''),sheet:true},
      uvgang:{label:'UV DTF gang sheet',rate:num(d.uvgangRate,.06),min:num(d.uvgangMin,8),url:d.uvgangUrl,pre:presets(''),sheet:true}
    };
    var tiers=[[1,0]];
    (d.tiers||'').split(',').forEach(function(t){var p=t.split(':');if(p.length==2)tiers.push([num(p[0],0),num(p[1],0)/100])});
    tiers.sort(function(a,b){return a[0]-b[0]});
    var maxSide=num(d.maxside,22), type='dtf', fmt=function(n){return '$'+n.toFixed(2)};
    var tabs=$('[data-tabs]'), sizes=$('[data-sizes]'), inW=$('[data-w]'), inH=$('[data-h]'), inQ=$('[data-q]');

    Object.keys(C).forEach(function(k){
      var b=document.createElement('button');b.type='button';b.className='fx-tab';b.textContent=C[k].label;b.dataset.k=k;
      b.onclick=function(){type=k;render()};tabs.appendChild(b);
    });
    function unit(c,w,h){
      var a=w+'x'+h,b=h+'x'+w;
      if(c.pre.map[a]!=null)return {p:c.pre.map[a],preset:true};
      if(c.pre.map[b]!=null)return {p:c.pre.map[b],preset:true};
      return {p:Math.max(c.min,w*h*c.rate),preset:false};
    }
    function disc(q){var x=0;tiers.forEach(function(t){if(q>=t[0])x=t[1]});return x}

    function render(){
      var c=C[type],W=parseFloat(inW.value),H=parseFloat(inH.value),q=Math.max(1,parseInt(inQ.value)||1);
      Array.prototype.forEach.call(tabs.children,function(b){b.setAttribute('aria-pressed',b.dataset.k===type)});
      sizes.innerHTML='';
      c.pre.list.forEach(function(s){
        var p=s.split('x'),b=document.createElement('button');b.type='button';b.className='fx-size';
        b.innerHTML=p[0]+' × '+p[1]+'"<span>'+fmt(c.pre.map[s])+'</span>';
        b.setAttribute('aria-pressed',(W==+p[0]&&H==+p[1])||(W==+p[1]&&H==+p[0]));
        b.onclick=function(){inW.value=p[0];inH.value=p[1];render()};
        sizes.appendChild(b);
      });
      $('[data-pop]').style.display=c.pre.list.length?'':'none';
      if(!(W>0)||!(H>0)){$('[data-err]').textContent='Enter a width and height.';$('[data-total]').textContent='$0.00';return}
      if(Math.min(W,H)>maxSide){$('[data-err]').textContent='One side must be '+maxSide+'" or less.';$('[data-total]').textContent='$0.00';return}
      $('[data-err]').textContent='';
      var u=unit(c,W,H),dc=disc(q),per=u.p*(1-dc),total=per*q;
      $('[data-what]').textContent=c.label+' · '+W+' × '+H+'"'+(q>1?' · '+q+' pcs':'');
      $('[data-total]').textContent=fmt(total);
      $('[data-rate]').textContent=dc?'Volume discount '+Math.round(dc*100)+'%':(u.preset?'Preset price':'Custom size');
      $('[data-per]').textContent=fmt(per);
      var go=$('[data-go]');
      go.textContent=c.sheet?'Build your gang sheet':'Order this size';
      go.href=c.url+(c.sheet?'':(c.url.indexOf('?')>-1?'&':'?')+'w='+W+'&h='+H+'&qty='+q);
    }
    [inW,inH,inQ].forEach(function(i){i.addEventListener('input',render)});
    $('[data-minus]').onclick=function(){inQ.value=Math.max(1,(parseInt(inQ.value)||1)-1);render()};
    $('[data-plus]').onclick=function(){inQ.value=(parseInt(inQ.value)||1)+1;render()};
    render();
  });
})();
</script>
</section>

{% schema %}
{
  "name": "Instant price check",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Check Your Price Instantly" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Enter your size and quantity to see the exact printing price before you upload anything." },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#f6f7f9" },
    { "type": "text", "id": "max_side", "label": "Max side in inches (film width)", "default": "22" },

    { "type": "header", "content": "DTF by size" },
    { "type": "text", "id": "dtf_rate", "label": "Price per sq in ($) for custom sizes", "default": "0.045" },
    { "type": "text", "id": "dtf_min", "label": "Minimum price per piece ($)", "default": "0.18" },
    { "type": "text", "id": "dtf_url", "label": "Order page link", "default": "/collections/dtf-transfers-by-size" },
    { "type": "textarea", "id": "dtf_presets", "label": "Preset sizes (WxH:price, comma separated)", "default": "2x2:0.18, 4x2:0.36, 3x3:0.41, 5x3:0.68, 4x4:0.73, 5x5:1.14, 6x6:1.64, 7x7:2.23, 11x5:2.50, 8x8:2.91, 9x9:3.68, 9x11:4.50, 10x10:4.55, 11x11:5.50" },

    { "type": "header", "content": "UV DTF by size" },
    { "type": "text", "id": "uv_rate", "label": "Price per sq in ($)", "default": "0.08" },
    { "type": "text", "id": "uv_min", "label": "Minimum price per piece ($)", "default": "0.30" },
    { "type": "text", "id": "uv_url", "label": "Order page link", "default": "/collections/uv-dtf-transfers" },
    { "type": "textarea", "id": "uv_presets", "label": "Preset sizes (WxH:price, comma separated, optional)", "default": "" },

    { "type": "header", "content": "DTF gang sheet" },
    { "type": "text", "id": "gang_rate", "label": "Price per sq in ($)", "default": "0.02" },
    { "type": "text", "id": "gang_min", "label": "Minimum price ($)", "default": "6.00" },
    { "type": "text", "id": "gang_url", "label": "Builder page link", "default": "/pages/gang-sheet-builder" },

    { "type": "header", "content": "UV DTF gang sheet" },
    { "type": "text", "id": "uvgang_rate", "label": "Price per sq in ($)", "default": "0.06" },
    { "type": "text", "id": "uvgang_min", "label": "Minimum price ($)", "default": "8.00" },
    { "type": "text", "id": "uvgang_url", "label": "Builder page link", "default": "/pages/uv-gang-sheet-builder" },

    { "type": "header", "content": "Quantity discounts" },
    { "type": "text", "id": "tiers", "label": "Quantity:percent off (comma separated)", "default": "10:5, 25:10, 50:15, 100:20", "info": "Leave empty for no discounts." }
  ],
  "presets": [
    { "name": "Instant price check" }
  ]
}
{% endschema %}
