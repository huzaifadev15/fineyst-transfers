<style>
  /* ── Gang Sheet specific overrides ─────────────────────────── */
  .main-product-dtf-upload .pdp-features--grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
  }

  .pdp-meta-sep {
    color: var(--color-border, #d1d5db);
    margin: 0 6px;
  }

  /* Size selector */
  .gang-sheet-form { display: flex; flex-direction: column; gap: 20px; margin-top: 18px; }
  .gang-section-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text, #111);
    margin-bottom: 10px;
  }
  .gang-section-note { font-weight: 400; color: var(--color-text-muted, #6b7280); }

  .gang-sizes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
    gap: 8px;
  }

  .gang-size-btn {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    padding: 10px 6px;
    border: 1.5px solid var(--color-border, #d1d5db);
    border-radius: 8px;
    background: var(--color-bg, #fff);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
    text-align: center;
  }
  .gang-size-btn:hover { border-color: var(--color-accent, #0ea5e9); }
  .gang-size-btn.is-active {
    border-color: var(--color-accent, #0ea5e9);
    background: color-mix(in srgb, var(--color-accent, #0ea5e9) 8%, transparent);
  }
  .gang-size-label { font-size: 13px; font-weight: 600; color: var(--color-text, #111); }
  .gang-size-price { font-size: 12px; color: var(--color-text, #111); }
  .gang-size-off {
    font-size: 10px;
    font-weight: 600;
    color: #16a34a;
    background: #dcfce7;
    border-radius: 4px;
    padding: 1px 5px;
  }

  /* Film style */
  .gang-films {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .gang-film-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    border: 1.5px solid var(--color-border, #d1d5db);
    border-radius: 24px;
    background: var(--color-bg, #fff);
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    transition: border-color 0.15s;
  }
  .gang-film-btn:hover { border-color: var(--color-accent, #0ea5e9); }
  .gang-film-btn.is-active { border-color: var(--color-accent, #0ea5e9); }
  .gang-film-swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(0,0,0,0.1);
    flex-shrink: 0;
  }
  .gang-film-badge {
    position: absolute;
    top: -8px;
    left: 8px;
    font-size: 9px;
    font-weight: 700;
    background: var(--color-accent, #0ea5e9);
    color: #fff;
    border-radius: 4px;
    padding: 1px 5px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }
  .gang-film-check { color: var(--color-accent, #0ea5e9); display: flex; align-items: center; }

  /* Selected size / film / price recap above the builder CTA */
  .gang-selection-summary {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    margin: 16px 0 10px;
    padding: 12px 14px;
    border: 1px solid #E8EAEE;
    border-radius: 10px;
    background: #F8FAFC;
    font-size: 14px;
  }
  .gang-selection-label { color: #667085; font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em; }
  .gang-selection-value { color: #101828; }
  .gang-selection-sep { color: #98A2B3; margin: 0 4px; }
  .gang-selection-price { margin-left: auto; display: inline-flex; align-items: baseline; gap: 8px; }
  .gang-selection-price strong { font-size: 18px; color: #101828; }
  .gang-selection-price s { color: #98A2B3; }
  .gang-selection-price em { font-style: normal; color: #067647; font-weight: 600; font-size: 12px; }

  /* CTA button */
  .gang-builder-btn {
    width: 100%;
    justify-content: center;
    padding: 16px;
    font-size: 15px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
  }

  /* Rewards */
  /* Rewards bar: filled grey strip with the percentage boxed on the left,
     label and LEARN MORE inline, matching the Ninja layout. */
  .gang-rewards {
    margin-top: 14px;
    border: 1px solid #E8EAEE;
    border-radius: 10px;
    background: #F4F6F8;
    padding: 12px 14px;
  }
  .gang-rewards-inner { display: flex; align-items: center; gap: 14px; }
  .gang-rewards-pct {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    flex-shrink: 0;
    min-width: 62px;
    padding: 6px 8px;
    border-radius: 8px;
    background: #fff;
    border: 1px solid #E8EAEE;
    line-height: 1.1;
    text-align: center;
  }
  .gang-rewards-pct em { font-style: normal; font-size: 9px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: #667085; }
  .gang-rewards-pct strong { font-size: 19px; font-weight: 900; color: #101828; }
  .gang-rewards-text { display: flex; flex-direction: column; gap: 3px; font-size: 12px; color: #475467; }
  .gang-rewards-head { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .gang-rewards-label { font-size: 12px; font-weight: 800; letter-spacing: 0.02em; text-transform: uppercase; color: #101828; }
  .gang-rewards-text p { margin: 0; }
  .gang-rewards-more {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.03em;
    color: var(--brand, #3E6D8E);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .gang-rewards-text p { margin: 0; color: var(--color-text-muted, #6b7280); }

  @media (max-width: 749px) {
    .main-product-dtf-upload .pdp-features--grid { grid-template-columns: 1fr; }
    .gang-sizes { grid-template-columns: repeat(3, 1fr); }
  }
</style>

{%- liquid
  assign rating = product.metafields.reviews.rating | default: section.settings.rating_value
  assign rating_count = product.metafields.reviews.rating_count | default: section.settings.rating_count
-%}

<section class="main-product main-product-dtf-upload pdp">
  <div class="container pdp-inner">

    <div class="pdp-media">
      {%- comment -%}
        Same gallery as the transfers PDP: images become slides, arrows only
        appear when there is more than one, and product videos render below the
        thumbnails rather than inside the carousel.
      {%- endcomment -%}
      {%- assign image_count = product.images.size -%}

      <div class="product-gallery" data-gallery>
        {%- if image_count > 1 -%}
          <button class="gallery-arrow gallery-arrow--prev" aria-label="Previous image">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
          </button>
        {%- endif -%}

        <div class="gallery-main" data-gallery-main>
          {%- if image_count > 0 -%}
            {%- for image in product.images -%}
              <div class="gallery-slide{% if forloop.first %} is-active{% endif %}" data-gallery-slide>
                <img src="{{ image | image_url: width: 1400 }}"
                     alt="{{ image.alt | escape }}"
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     sizes="(min-width: 990px) 45vw, 100vw">
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="hero-media-placeholder"></div>
          {%- endif -%}
        </div>

        {%- if image_count > 1 -%}
          <button class="gallery-arrow gallery-arrow--next" aria-label="Next image">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
          </button>
        {%- endif -%}
      </div>

      {%- if image_count > 1 -%}
        <div class="gallery-thumbs">
          {%- for image in product.images -%}
            <button class="gallery-thumb{% if forloop.first %} is-active{% endif %}" type="button"
                    data-gallery-thumb data-index="{{ forloop.index0 }}"
                    aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 200 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- assign product_videos = product.media | where: 'media_type', 'video' -%}
      {%- if product_videos.size > 0 -%}
        <div class="gallery-videos">
          {%- for media in product_videos -%}
            <div class="gallery-video">
              {{ media | video_tag: image_size: '1200x', controls: true, muted: true, playsinline: true }}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp-info">
      <div class="pdp-title-row">
        <h1>{{ product.title }}</h1>
        {% if section.settings.badge_text != blank %}
          <span class="pdp-flag">{{ section.settings.badge_text }}</span>
        {% endif %}
      </div>

      <div class="pdp-meta">
        <span class="pdp-meta-item pdp-meta-price">
          <strong>As Low As</strong>
          {% if section.settings.unit_price != blank %}
            {{ section.settings.unit_price }}
          {% else %}
            {{ product.price | money }}
          {% endif %}
        </span>
        {% if section.settings.fulfillment_note != blank %}
          <span class="pdp-meta-sep">|</span>
          <span class="pdp-meta-item">{{ section.settings.fulfillment_note }}</span>
        {% endif %}
        {% if rating_count != blank %}
          <span class="pdp-meta-sep">|</span>
          <span class="pdp-meta-item pdp-meta-rating">
            <span class="pdp-stars" aria-hidden="true">★★★★★</span>
            <a href="#reviews">{{ rating_count }} Reviews</a>
          </span>
        {% endif %}
      </div>

      <ul class="pdp-features pdp-features--grid">
        <li>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3l3 2 3-2 5 3-2 4-2-1v12H8V9L6 10 4 6z"/></svg>
          <span>Works on Any Fabric or Color</span>
        </li>
        <li>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4z"/><path d="M18 16l.8 2 2 .8-2 .8-.8 2-.8-2-2-.8 2-.8z"/></svg>
          <span>Vibrant Colors &amp; Ultra-fine Details</span>
        </li>
        <li>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="3" width="16" height="18" rx="2"/><circle cx="12" cy="13" r="4"/><path d="M8 6.5h2"/></svg>
          <span>Certified for {{ section.settings.wash_count }}+ Washes
            <button type="button" class="pdp-info-dot" aria-label="More about wash testing" data-tip="Independently lab-tested through {{ section.settings.wash_count }} home wash and dry cycles with no cracking or peeling.">i</button>
          </span>
        </li>
        <li>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5.5c0 4.3-2.9 8.1-7 9.5-4.1-1.4-7-5.2-7-9.5V6z"/><path d="M9 12l2 2 4-4"/></svg>
          <span>100% Satisfaction Guaranteed</span>
        </li>
      </ul>

      <div class="pdp-strip">
        <a class="pdp-strip-link" href="{{ section.settings.volume_link | default: '#size-select' }}">{{ section.settings.volume_text }}</a>
        <span class="pdp-strip-sep"></span>
        <span class="pdp-strip-item pdp-delivery" data-delivery data-cutoff-hour="{{ section.settings.cutoff_hour }}">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8l-9-5-9 5v8l9 5 9-5z"/><path d="M3.3 7.5L12 12.5l8.7-5M12 21.5v-9"/></svg>
          Fastest Delivery <strong data-delivery-date>—</strong> order in <strong data-delivery-countdown>—</strong>
        </span>
        <span class="pdp-strip-sep"></span>
        <span class="pdp-strip-item">No Minimums, Setup or Art Fees</span>
      </div>

      <div class="gang-sheet-form" id="size-select" data-gang-form>

        <div class="gang-size-section">
          <h2 class="gang-section-title">Select size <span class="gang-section-note">(all sizes are {{ section.settings.sheet_width }} inches wide)</span></h2>
          <div class="gang-sizes" data-gang-sizes>
            {% for block in section.blocks %}
              {% if block.type == 'sheet_size' %}
                <button
                  type="button"
                  class="gang-size-btn {% if forloop.first %}is-active{% endif %}"
                  {{ block.shopify_attributes }}
                  data-gang-size
                  data-ft="{{ block.settings.size_ft | default: block.settings.label }}"
                  data-variant-id="{{ block.settings.variant_id }}"
                  data-price="{{ block.settings.price }}"
                  data-compare="{{ block.settings.compare_price }}"
                  data-discount="{{ block.settings.discount_pct }}"
                  aria-pressed="{{ forloop.first }}"
                >
                  <span class="gang-size-label">{{ block.settings.label }}</span>
                  <span class="gang-size-price">{{ block.settings.price }}</span>
                  {% if block.settings.discount_pct != blank and block.settings.discount_pct != '0' %}
                    <span class="gang-size-off">{{ block.settings.discount_pct }}% off</span>
                  {% endif %}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="gang-film-section">
          <h2 class="gang-section-title">Select film style</h2>
          <div class="gang-films" data-gang-films>
            {% for block in section.blocks %}
              {% if block.type == 'film_style' %}
                <button
                  type="button"
                  class="gang-film-btn {% if forloop.first %}is-active{% endif %}"
                  {{ block.shopify_attributes }}
                  data-gang-film
                  data-film-id="{{ block.settings.option_value }}"
                  aria-pressed="{{ forloop.first }}"
                >
                  {% if block.settings.badge != blank %}
                    <span class="gang-film-badge">{{ block.settings.badge }}</span>
                  {% endif %}
                  <span class="gang-film-swatch" style="background: {{ block.settings.swatch_css }};"></span>
                  <span class="gang-film-name">{{ block.settings.label }}</span>
                  {% if forloop.first %}<span class="gang-film-check" aria-hidden="true">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>
                  </span>{% endif %}
                </button>
              {% endif %}
            {% endfor %}
          </div>
        </div>

        <div class="gang-selection-summary" data-gang-summary>
          <span class="gang-selection-label">Your selection</span>
          <span class="gang-selection-value">
            <strong data-gang-summary-size>—</strong>
            <span class="gang-selection-sep">·</span>
            <strong data-gang-summary-film>—</strong>
          </span>
          <span class="gang-selection-price">
            <strong data-gang-summary-price>—</strong>
            <s data-gang-summary-compare hidden></s>
            <em data-gang-summary-off hidden></em>
          </span>
        </div>

        <a
          href="{{ section.settings.builder_url | default: '/apps/gang-sheet-builder' }}"
          class="btn-blue btn-blue--lg gang-builder-btn"
          data-gang-builder-cta
          data-builder-base="{{ section.settings.builder_url | default: '/apps/gang-sheet-builder' }}"
        >
          {{ section.settings.builder_cta }}
        </a>

        {% if section.settings.rewards_cashback != blank %}
          <div class="gang-rewards">
            <div class="gang-rewards-inner">
              <span class="gang-rewards-pct"><em>Up to</em><strong>{{ section.settings.rewards_pct }}%</strong><em>Back</em></span>
              <div class="gang-rewards-text">
                <span class="gang-rewards-head">
                  <span class="gang-rewards-label">{{ section.settings.rewards_label }}</span>
                  {% if section.settings.rewards_link != blank %}
                    <a class="gang-rewards-more" href="{{ section.settings.rewards_link }}">LEARN MORE</a>
                  {% endif %}
                </span>
                <p>{{ section.settings.rewards_cashback }}</p>
              </div>
            </div>
          </div>
        {% endif %}

        {% if section.settings.show_bnpl %}
          <div class="bnpl">
            <p class="bnpl-title">{{ section.settings.bnpl_title | default: 'Finance with Buy Now Pay Later options' }}</p>
            <div class="bnpl-logos">
              {% if section.settings.bnpl_image != blank %}
                <img src="{{ section.settings.bnpl_image | image_url: width: 1200 }}" alt="Shop Pay, Afterpay, Klarna, Sezzle and Affirm" loading="lazy">
              {% else %}
                {%- comment -%}
                  Falls back to the card-logo strip if the BNPL file has not been
                  uploaded yet, so this never renders as a broken image.
                {%- endcomment -%}
                <img src="{{ section.settings.bnpl_static_image | default: 'payment.webp' | strip | asset_url }}"
                     alt="Shop Pay, Afterpay, Klarna, Sezzle and Affirm"
                     loading="lazy"
                     onerror="this.onerror=null;this.src='{{ 'payment-methods.webp' | asset_url }}';">
              {% endif %}
            </div>
            {% if section.settings.bnpl_note != blank %}
              <p class="bnpl-note">{{ section.settings.bnpl_note }}</p>
            {% endif %}
          </div>
        {% endif %}

      </div>

      {% if product.description != blank %}
        <div class="pdp-description rte">{{ product.description }}</div>
      {% endif %}
    </div>

  </div>
</section>


<script>
(function () {
  const form = document.querySelector('[data-gang-form]');
  if (!form) return;

  const cta = form.querySelector('[data-gang-builder-cta]');
  const sumSize = form.querySelector('[data-gang-summary-size]');
  const sumFilm = form.querySelector('[data-gang-summary-film]');
  const sumPrice = form.querySelector('[data-gang-summary-price]');
  const sumCompare = form.querySelector('[data-gang-summary-compare]');
  const sumOff = form.querySelector('[data-gang-summary-off]');

  /* Label like "10 Feet" → 10. data-ft may already hold a bare number. */
  function feetOf(btn) {
    const match = String(btn.dataset.ft || '').match(/[\d.]+/);
    return match ? match[0] : '';
  }

  /* Mirror the current size + film choice into the summary row and onto the
     builder link, so the app proxy opens the editor pre-set to that sheet. */
  function syncSelection() {
    const size = form.querySelector('[data-gang-size].is-active');
    const film = form.querySelector('[data-gang-film].is-active');
    if (!size) return;

    const label = size.querySelector('.gang-size-label');
    const price = size.dataset.price || '';
    const compare = size.dataset.compare || '';
    const off = size.dataset.discount || '';
    const filmName = film ? (film.querySelector('.gang-film-name') || {}).textContent || '' : '';

    if (sumSize) sumSize.textContent = label ? label.textContent.trim() : '';
    if (sumFilm) sumFilm.textContent = filmName.trim() || '—';
    if (sumPrice) sumPrice.textContent = price;
    if (sumCompare) {
      sumCompare.textContent = compare;
      sumCompare.hidden = !compare;
    }
    if (sumOff) {
      sumOff.textContent = off ? off + '% off' : '';
      sumOff.hidden = !off || off === '0';
    }

    if (!cta) return;
    const base = cta.dataset.builderBase || '/apps/gang-sheet-builder';
    const url = new URL(base, window.location.origin);
    const ft = feetOf(size);
    if (ft) url.searchParams.set('ft', ft);
    if (film && film.dataset.filmId) url.searchParams.set('film', film.dataset.filmId);
    if (price) url.searchParams.set('price', price);
    if (size.dataset.variantId) url.searchParams.set('variant', size.dataset.variantId);
    /* toString keeps an absolute builder_url intact; a relative one was
       already resolved against the storefront origin above. */
    cta.href = url.toString();
  }

  /* ── Size selection ── */
  form.querySelectorAll('[data-gang-size]').forEach(btn => {
    btn.addEventListener('click', () => {
      form.querySelectorAll('[data-gang-size]').forEach(b => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');
      syncSelection();
    });
  });

  /* ── Film style selection ── */
  form.querySelectorAll('[data-gang-film]').forEach(btn => {
    btn.addEventListener('click', () => {
      form.querySelectorAll('[data-gang-film]').forEach(b => {
        b.classList.remove('is-active');
        b.setAttribute('aria-pressed', 'false');
        const chk = b.querySelector('.gang-film-check');
        if (chk) chk.remove();
      });
      btn.classList.add('is-active');
      btn.setAttribute('aria-pressed', 'true');
      if (!btn.querySelector('.gang-film-check')) {
        const chk = document.createElement('span');
        chk.className = 'gang-film-check';
        chk.setAttribute('aria-hidden', 'true');
        chk.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>';
        btn.appendChild(chk);
      }
      syncSelection();
    });
  });

  /* Prime the summary and builder link from the defaults rendered by Liquid. */
  syncSelection();

  /* ── Delivery countdown ── */
  const deliveryEl = form.closest('section').querySelector('[data-delivery]');
  if (deliveryEl) {
    const cutoff = parseInt(deliveryEl.dataset.cutoffHour || '17', 10);
    function updateDelivery() {
      const now = new Date();
      const cutoffToday = new Date(now);
      cutoffToday.setHours(cutoff, 0, 0, 0);
      const targetDate = now < cutoffToday ? cutoffToday : new Date(cutoffToday.getTime() + 86400000);
      const diff = targetDate - now;
      const h = Math.floor(diff / 3600000);
      const m = Math.floor((diff % 3600000) / 60000);
      const cdEl = deliveryEl.querySelector('[data-delivery-countdown]');
      const dtEl = deliveryEl.querySelector('[data-delivery-date]');
      if (cdEl) cdEl.textContent = h + 'h ' + m + 'm';
      if (dtEl) {
        const ship = new Date();
        ship.setDate(ship.getDate() + (now < cutoffToday ? 1 : 2));
        dtEl.textContent = ship.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
      }
    }
    updateDelivery();
    setInterval(updateDelivery, 60000);
  }
})();
</script>

{% schema %}
{
  "name": "DTF Gang Sheet Builder",
  "settings": [
