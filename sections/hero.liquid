{%- assign column_one_blocks = section.blocks | where: 'type', 'column_1_image' -%}
{%- assign column_two_blocks = section.blocks | where: 'type', 'column_2_image' -%}
{%- assign column_three_blocks = section.blocks | where: 'type', 'column_3_image' -%}
{%- assign mobile_row_one = column_one_blocks | concat: column_two_blocks -%}
{%- assign mobile_row_two = column_three_blocks | concat: column_two_blocks -%}

<section class="hero-section" aria-labelledby="hero-heading-{{ section.id }}">
  <div class="hero-bg-wrap">
    <div class="hero-inner-wrap">
      <div class="hero-left">
        <div class="hero-inner">
          <header class="hero-heading">
            <h1 id="hero-heading-{{ section.id }}" class="hero-title-main">{{ section.settings.title | escape | newline_to_br }}</h1>
            {%- if section.settings.subtitle != blank -%}
              <div class="hero-subtitle">
                {%- if section.settings.highlight_text != blank -%}
                  {%- assign subtitle_parts = section.settings.subtitle | split: section.settings.highlight_text -%}
                  {%- for part in subtitle_parts -%}
                    {{- part | escape -}}
                    {%- unless forloop.last -%}<mark class="hero-highlight">{{ section.settings.highlight_text | escape }}</mark>{%- endunless -%}
                  {%- endfor -%}
                {%- else -%}
                  {{- section.settings.subtitle | escape -}}
                {%- endif -%}
              </div>
            {%- endif -%}
          </header>

          {%- if section.settings.description != blank -%}
            <div class="hero-desc">{{ section.settings.description }}</div>
          {%- endif -%}

          <nav class="hero-btns" aria-label="Hero links">
            {%- if section.settings.primary_label != blank -%}
              <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url | escape }}" class="hero-btn hero-btn--primary">
                {{ section.settings.primary_label | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.show_secondary_button and section.settings.secondary_label != blank -%}
              <a href="{{ section.settings.secondary_link | default: routes.all_products_collection_url | escape }}" class="hero-btn hero-btn--secondary">
                <span class="hero-btn-inner">
                  {{ section.settings.secondary_label | escape }}
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hero-btn-arrow" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                </span>
              </a>
            {%- endif -%}
          </nav>

          {%- if section.settings.show_badges -%}
            <div class="hero-badges">
              {%- for block in section.blocks -%}
                {%- if block.type == 'badge' and block.settings.text != blank -%}
                  <span class="badge" {{ block.shopify_attributes }}>
                    <span class="badge-icon" aria-hidden="true">
                      <svg width="10" height="10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
                    </span>
                    {{ block.settings.text | escape }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_scrolling_images -%}
        <div class="hero-right" aria-label="Featured product images">
          <div class="hero-cols-inner">
            <div class="hero-col hero-col--up" style="--column-duration: {{ section.settings.column_1_speed }}s;">
              {%- for pass in (1..2) -%}
                {%- if column_one_blocks.size > 0 -%}
                  {%- for block in column_one_blocks -%}
                    <div class="hero-img-wrap" {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                      {%- if block.settings.image != blank -%}
                        <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image_alt | default: block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                      {%- else -%}
                        {{ 'product-1' | placeholder_svg_tag: 'hero-image-placeholder' }}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <div class="hero-img-wrap" aria-hidden="true">{{ 'product-1' | placeholder_svg_tag: 'hero-image-placeholder' }}</div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="hero-col hero-col--down" style="--column-duration: {{ section.settings.column_2_speed }}s;">
              {%- for pass in (1..2) -%}
                {%- if column_two_blocks.size > 0 -%}
                  {%- for block in column_two_blocks -%}
                    <div class="hero-img-wrap" {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                      {%- if block.settings.image != blank -%}
                        <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image_alt | default: block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                      {%- else -%}
                        {{ 'product-2' | placeholder_svg_tag: 'hero-image-placeholder' }}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <div class="hero-img-wrap" aria-hidden="true">{{ 'product-2' | placeholder_svg_tag: 'hero-image-placeholder' }}</div>
                {%- endif -%}
              {%- endfor -%}
            </div>

            <div class="hero-col hero-col--up" style="--column-duration: {{ section.settings.column_3_speed }}s;">
              {%- for pass in (1..2) -%}
                {%- if column_three_blocks.size > 0 -%}
                  {%- for block in column_three_blocks -%}
                    <div class="hero-img-wrap" {% if pass == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                      {%- if block.settings.image != blank -%}
                        <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.image_alt | default: block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                      {%- else -%}
                        {{ 'product-3' | placeholder_svg_tag: 'hero-image-placeholder' }}
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                {%- else -%}
                  <div class="hero-img-wrap" aria-hidden="true">{{ 'product-3' | placeholder_svg_tag: 'hero-image-placeholder' }}</div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_scrolling_images -%}
      <div class="hero-mobile-media" aria-label="Featured product images">
        <div class="hero-mobile-track hero-mobile-track--left" style="--mobile-duration: {{ section.settings.mobile_scroll_speed }}s;">
          {%- for pass in (1..2) -%}
            {%- if mobile_row_one.size > 0 -%}
              {%- for block in mobile_row_one -%}
                <div class="hero-mobile-tile" aria-hidden="true">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.image_alt | default: block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'hero-image-placeholder' }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="hero-mobile-tile" aria-hidden="true">{{ 'product-1' | placeholder_svg_tag: 'hero-image-placeholder' }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        <div class="hero-mobile-track hero-mobile-track--right" style="--mobile-duration: {{ section.settings.mobile_scroll_speed }}s;">
          {%- for pass in (1..2) -%}
            {%- if mobile_row_two.size > 0 -%}
              {%- for block in mobile_row_two -%}
                <div class="hero-mobile-tile" aria-hidden="true">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 400 }}" alt="{{ block.settings.image_alt | default: block.settings.image.alt | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                  {%- else -%}
                    {{ 'product-2' | placeholder_svg_tag: 'hero-image-placeholder' }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="hero-mobile-tile" aria-hidden="true">{{ 'product-2' | placeholder_svg_tag: 'hero-image-placeholder' }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} {
    --hero-dark: {{ section.settings.dark_color }};
    --hero-lime: {{ section.settings.lime_color }};
    --hero-description: {{ section.settings.description_color }};
    --hero-button-bg: {{ section.settings.button_bg_color }};
    --hero-button-text: {{ section.settings.button_text_color }};
    --hero-badge-icon-bg: {{ section.settings.badge_icon_bg }};
    --hero-badge-icon-color: {{ section.settings.badge_icon_color }};
    --hero-badge-text: {{ section.settings.badge_text_color }};
    --hero-secondary-bg: {{ section.settings.secondary_button_bg }};
    --hero-gradient-start: {{ section.settings.gradient_start }};
    --hero-gradient-end: {{ section.settings.gradient_end }};
    --hero-tile-bg: {{ section.settings.tile_bg_color }};
    --hero-bg-image: {% if section.settings.bg_image != blank %}url('{{ section.settings.bg_image | image_url: width: 2000 }}'){% else %}none{% endif %};
    --hero-bg-position: {{ section.settings.bg_position }};
    --hero-overlay: {{ section.settings.bg_overlay }}%;
    --hero-padding-top: {{ section.settings.padding_top }}px;
    --hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hero-heading-desktop: {{ section.settings.heading_size_desktop }}px;
    --hero-heading-mobile: {{ section.settings.heading_size_mobile }}px;
  }

  #shopify-section-{{ section.id }} .hero-section {
    width: 100%;
    font-family: var(--font-primary, sans-serif) !important;
  }
  #shopify-section-{{ section.id }} .hero-bg-wrap {
    position: relative;
    overflow: hidden;
    background-color: var(--hero-gradient-start);
    background-image:
      linear-gradient(color-mix(in srgb, var(--hero-dark) var(--hero-overlay), transparent), color-mix(in srgb, var(--hero-dark) var(--hero-overlay), transparent)),
      var(--hero-bg-image),
      linear-gradient(135deg, var(--hero-gradient-start), var(--hero-gradient-end));
    background-position: center center, var(--hero-bg-position) center, center center;
    background-size: cover;
    background-repeat: no-repeat;
  }
  #shopify-section-{{ section.id }} .hero-bg-wrap::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 45%;
    height: 100%;
    background: var(--hero-lime);
    clip-path: polygon(40% 0, 100% 0, 100% 18%, 62% 18%);
    opacity: .35;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hero-bg-wrap::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    width: 40%;
    height: 100%;
    background: var(--hero-dark);
    clip-path: polygon(100% 78%, 100% 100%, 55% 100%);
    opacity: .12;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hero-inner-wrap,
  #shopify-section-{{ section.id }} .hero-mobile-media {
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .hero-inner-wrap {
    max-width: 1340px;
    margin: 0 auto;
    padding: calc(var(--nav-bottom, 0px) + var(--hero-padding-top)) 16px var(--hero-padding-bottom);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .hero-inner {
    position: relative;
    max-width: 740px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-left: 16px;
  }
  #shopify-section-{{ section.id }} .hero-heading { margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .hero-title-main {
    display: block;
    font-family: var(--font-primary, sans-serif) !important;
    font-style: italic;
    font-weight: 900;
    text-transform: uppercase;
    font-size: var(--hero-heading-desktop);
    line-height: .88;
    color: var(--hero-dark);
    margin: 0 0 14px;
  }
  #shopify-section-{{ section.id }} .hero-subtitle {
    display: block;
    max-width: 700px;
    font-size: clamp(18px, 2vw, 26px);
    font-weight: 700;
    line-height: 1.3;
    color: var(--hero-dark);
  }
  #shopify-section-{{ section.id }} .hero-highlight {
    background: var(--hero-lime);
    color: var(--hero-dark);
    padding: 0 8px;
    border-radius: 4px;
  }
  #shopify-section-{{ section.id }} .hero-desc {
    max-width: 520px;
    color: var(--hero-description);
    font-size: 16px;
    line-height: 1.55;
    margin: 4px 0 24px;
  }
  #shopify-section-{{ section.id }} .hero-desc p { margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .hero-desc p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section.id }} .hero-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  #shopify-section-{{ section.id }} .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 30px;
    border: 2px solid var(--hero-button-bg);
    border-radius: 999px;
    font-weight: 700;
    font-size: 16px;
    text-align: center;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease;
  }
  #shopify-section-{{ section.id }} .hero-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--hero-dark) 25%, transparent);
  }
  #shopify-section-{{ section.id }} .hero-btn--primary {
    background: var(--hero-button-bg);
    color: var(--hero-button-text);
  }
  #shopify-section-{{ section.id }} .hero-btn--secondary {
    background: var(--hero-secondary-bg);
    color: var(--hero-dark);
  }
  #shopify-section-{{ section.id }} .hero-btn-inner { display: inline-flex; align-items: center; gap: 8px; }
  #shopify-section-{{ section.id }} .hero-btn-arrow { transition: transform .2s ease; }
  #shopify-section-{{ section.id }} .hero-btn--secondary:hover .hero-btn-arrow { transform: translateX(3px); }
  #shopify-section-{{ section.id }} .hero-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 26px;
  }
  #shopify-section-{{ section.id }} .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--hero-badge-text);
    font-size: 13px;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 24px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--hero-badge-icon-bg);
    color: var(--hero-badge-icon-color);
  }
  #shopify-section-{{ section.id }} .hero-right {
    position: relative;
    min-width: 0;
    overflow: hidden;
    align-self: stretch;
    display: flex;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .hero-right::before,
  #shopify-section-{{ section.id }} .hero-right::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 90px;
    z-index: 2;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .hero-right::before {
    top: 0;
    background: linear-gradient(to bottom, color-mix(in srgb, var(--hero-dark) 18%, transparent), transparent);
  }
  #shopify-section-{{ section.id }} .hero-right::after {
    bottom: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--hero-dark) 18%, transparent), transparent);
  }
  #shopify-section-{{ section.id }} .hero-cols-inner {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    height: 600px;
    width: 100%;
    padding-left: 20px;
    position: relative;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .hero-col {
    flex: 1 1 0%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    will-change: transform;
  }
  #shopify-section-{{ section.id }} .hero-col--up { animation: heroScrollUp-{{ section.id }} var(--column-duration) linear infinite; }
  #shopify-section-{{ section.id }} .hero-col--down { animation: heroScrollDown-{{ section.id }} var(--column-duration) linear infinite; }
  #shopify-section-{{ section.id }} .hero-right:hover .hero-col { animation-play-state: paused; }
  #shopify-section-{{ section.id }} .hero-img-wrap {
    position: relative;
    flex: 0 0 auto;
    width: 100%;
    aspect-ratio: 3 / 4;
    margin-bottom: 16px;
    overflow: hidden;
    border-radius: 14px;
    background: var(--hero-tile-bg);
    box-shadow: 0 6px 18px color-mix(in srgb, var(--hero-dark) 14%, transparent);
  }
  #shopify-section-{{ section.id }} .hero-img-wrap img,
  #shopify-section-{{ section.id }} .hero-mobile-tile img,
  #shopify-section-{{ section.id }} .hero-image-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .hero-image-placeholder { background: var(--hero-tile-bg); }
  #shopify-section-{{ section.id }} .hero-mobile-media { display: none; }

  @keyframes heroScrollUp-{{ section.id }} {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }
  @keyframes heroScrollDown-{{ section.id }} {
    from { transform: translateY(-50%); }
    to { transform: translateY(0); }
  }
  @keyframes heroMarqueeLeft-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes heroMarqueeRight-{{ section.id }} {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }

  @media (max-width: 1100px) {
    #shopify-section-{{ section.id }} .hero-cols-inner { height: 520px; gap: 12px; padding-left: 12px; }
  }
  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .hero-inner-wrap {
      grid-template-columns: 1fr;
      padding: calc(var(--nav-bottom, 0px) + var(--hero-padding-top)) 16px 0;
      gap: 0;
    }
    #shopify-section-{{ section.id }} .hero-right { display: none; }
    #shopify-section-{{ section.id }} .hero-inner { max-width: none; align-items: center; text-align: center; padding-left: 0; }
    #shopify-section-{{ section.id }} .hero-title-main { font-size: var(--hero-heading-mobile); }
    #shopify-section-{{ section.id }} .hero-subtitle { font-size: clamp(17px, 4.6vw, 24px); }
    #shopify-section-{{ section.id }} .hero-desc { margin-bottom: 20px; }
    #shopify-section-{{ section.id }} .hero-btns { flex-direction: column; align-items: center; width: 100%; }
    #shopify-section-{{ section.id }} .hero-btn { width: 100%; max-width: 300px; }
    #shopify-section-{{ section.id }} .hero-badges { justify-content: center; }
    #shopify-section-{{ section.id }} .hero-mobile-media {
      display: grid;
      gap: 10px;
      margin-top: 28px;
      padding-bottom: var(--hero-padding-bottom);
      overflow: hidden;
    }
    #shopify-section-{{ section.id }} .hero-mobile-track {
      display: flex;
      width: max-content;
      gap: 10px;
      padding: 0 8px;
      will-change: transform;
    }
    #shopify-section-{{ section.id }} .hero-mobile-track--left { animation: heroMarqueeLeft-{{ section.id }} var(--mobile-duration) linear infinite; }
    #shopify-section-{{ section.id }} .hero-mobile-track--right { animation: heroMarqueeRight-{{ section.id }} var(--mobile-duration) linear infinite; }
    #shopify-section-{{ section.id }} .hero-mobile-tile {
      flex: 0 0 auto;
      width: 7.1rem;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      border-radius: 12px;
      background: var(--hero-tile-bg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .hero-col,
    #shopify-section-{{ section.id }} .hero-mobile-track,
    #shopify-section-{{ section.id }} .hero-btn { animation: none !important; transition: none !important; }
  }
</style>

{% schema %}
{
  "name": "Fineyst Hero",
  "settings": [
    { "type": "textarea", "id": "title", "label": "Title", "info": "Har line ke liye nayi line add karein.", "default": "DTF\nTRANSFERS" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "No Minimums, Ready to Press, Shipped in 24 Hours" },
    { "type": "text", "id": "highlight_text", "label": "Subtitle highlight text", "info": "Subtitle mein exact matching text lime highlight hoga.", "default": "24 Hours" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Vibrant, durable direct-to-film transfers for shirts, hoodies, hats, and more. No setup fees, no order minimums, full-color detail every time.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Order Transfers by Size" },
    { "type": "url", "id": "primary_link", "label": "Primary button URL" },
    { "type": "checkbox", "id": "show_secondary_button", "label": "Show secondary button", "default": true },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Build a Gang Sheet" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button URL" },
    { "type": "checkbox", "id": "show_badges", "label": "Show badges", "default": true },
    { "type": "checkbox", "id": "show_scrolling_images", "label": "Show scrolling images", "default": true },
    { "type": "header", "content": "Hero colors" },
    { "type": "color", "id": "dark_color", "label": "Dark green", "default": "#0B3D2E" },
    { "type": "color", "id": "lime_color", "label": "Lime highlight", "default": "#B8F23C" },
    { "type": "color", "id": "description_color", "label": "Description text", "default": "#1F3B33" },
    { "type": "color", "id": "button_bg_color", "label": "Primary button background", "default": "#0B3D2E" },
    { "type": "color", "id": "button_text_color", "label": "Primary button text", "default": "#FFFFFF" },
    { "type": "color", "id": "badge_icon_bg", "label": "Badge icon background", "default": "#0B3D2E" },
    { "type": "color", "id": "badge_icon_color", "label": "Badge icon checkmark", "default": "#FFFFFF" },
