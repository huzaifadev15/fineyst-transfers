{{ 'fineyst-terms-conditions.css' | asset_url | stylesheet_tag }}

<section class="ft-terms" style="--ft-accent: {{ section.settings.accent_color }}; --ft-width: {{ section.settings.content_width }}px;" aria-labelledby="ft-terms-title-{{ section.id }}">
  <div class="ft-terms__container">
    <header class="ft-terms__header">
      <h1 id="ft-terms-title-{{ section.id }}">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.introduction != blank %}
        <div class="ft-terms__intro rte">{{ section.settings.introduction }}</div>
      {% endif %}
    </header>

    <div class="ft-terms__body">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'policy' %}
            <section class="ft-terms__policy" {{ block.shopify_attributes }}>
              <h2>{{ block.settings.heading | escape }}</h2>
              <div class="ft-terms__richtext rte">{{ block.settings.body }}</div>
            </section>
          {% when 'tip' %}
            <aside class="ft-terms__tip" {{ block.shopify_attributes }}>
              <h3>{{ block.settings.heading | escape }}</h3>
              <div class="rte">{{ block.settings.body }}</div>
            </aside>
        {% endcase %}
      {% endfor %}

      {% if section.settings.show_contact %}
        <section class="ft-terms__policy ft-terms__contact" aria-labelledby="ft-contact-title-{{ section.id }}">
          <h2 id="ft-contact-title-{{ section.id }}">{{ section.settings.contact_heading | escape }}</h2>
          <p>{{ section.settings.contact_description | escape }}</p>
          {% if section.settings.contact_email != blank %}<p><strong>Email:</strong> <a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a></p>{% endif %}
          {% if section.settings.contact_phone != blank %}<p><strong>Phone:</strong> <a href="tel:{{ section.settings.contact_phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | escape }}">{{ section.settings.contact_phone | escape }}</a></p>{% endif %}
          {% if section.settings.website_url != blank %}<p><strong>Website:</strong> <a href="{{ section.settings.website_url | escape }}">{{ section.settings.website_url | escape }}</a></p>{% endif %}
        </section>
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_cta %}
    <div class="ft-terms__cta-wrap">
      <div class="ft-terms__container ft-terms__cta">
        <h2>{{ section.settings.cta_heading | escape }}</h2>
        <p>{{ section.settings.cta_text | escape }}</p>
        {% if section.settings.cta_link != blank %}
          <a class="ft-terms__button" href="{{ section.settings.cta_link }}">{{ section.settings.cta_button | escape }} <span aria-hidden="true">→</span></a>
        {% endif %}
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Fineyst Terms & Conditions",
  "tag": "section",
  "class": "fineyst-terms-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Page heading", "default": "Terms & Conditions" },
    { "type": "richtext", "id": "introduction", "label": "Introduction", "default": "<p>Welcome to Fineyst. By accessing our website or placing an order, you agree to these Terms and Conditions.</p><p>Please read these terms carefully before submitting an order.</p>" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 680, "max": 1200, "step": 20, "unit": "px", "default": 900 },
    { "type": "color", "id": "accent_color", "label": "Accent color", "default": "#111111" },
    { "type": "header", "content": "Contact information" },
    { "type": "checkbox", "id": "show_contact", "label": "Show contact section", "default": true },
    { "type": "text", "id": "contact_heading", "label": "Contact heading", "default": "Contact Us" },
    { "type": "text", "id": "contact_description", "label": "Contact description", "default": "If you have questions about these Terms & Conditions, please contact our team:" },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "support@example.com" },
    { "type": "text", "id": "contact_phone", "label": "Contact phone" },
    { "type": "url", "id": "website_url", "label": "Website URL" },
    { "type": "header", "content": "Bottom support callout" },
    { "type": "checkbox", "id": "show_cta", "label": "Show support callout", "default": true },
    { "type": "text", "id": "cta_heading", "label": "Callout heading", "default": "Have Questions About Our Terms?" },
    { "type": "text", "id": "cta_text", "label": "Callout description", "default": "Our customer service team is ready to assist with questions about our terms and conditions." },
    { "type": "text", "id": "cta_button", "label": "Button text", "default": "Contact Fineyst Support" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    { "type": "policy", "name": "Policy section", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Policy heading" },
      { "type": "richtext", "id": "body", "label": "Policy content", "default": "<p>Write the policy details here.</p>" }
    ]},
    { "type": "tip", "name": "Pro tip", "limit": 1, "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Pro Tip" },
      { "type": "richtext", "id": "body", "label": "Tip content", "default": "<p>Review your artwork and order specifications carefully before ordering.</p>" }
    ]}
  ],
  "presets": [{ "name": "Fineyst Terms & Conditions" }]
}
{% endschema %}
