{%- comment -%}
  PDP Customer Feedback — a horizontal strip of portrait UGC tiles (photo or
  looping video) with a play affordance on video tiles.
  Mirrors the Ninja Transfers PDP "Customer Feedback" block.
{%- endcomment -%}

<section class="pdp-ugc">
  <div class="pdp-ugc-inner">
    <h2 class="pdp-ugc-title">{{ section.settings.heading | default: 'Fineyst Transfers Customer Feedback' }}</h2>

    <div class="pdp-ugc-strip">
      {%- assign files = section.settings.files | default: 'cr img1.webp,cr img2.webp,cr img3.webp,cr img4.webp,cr img5.webp,cr img6.webp,cr img7.webp' | split: ',' -%}
      {%- for file in files -%}
        {%- assign f = file | strip -%}
        <figure class="pdp-ugc-tile">
          {%- if f contains '.mp4' -%}
            <video src="{{ f | asset_url }}" muted loop playsinline preload="metadata"></video>
            <span class="pdp-ugc-play" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
          {%- else -%}
            <img src="{{ f | asset_url }}" alt="" loading="lazy" width="200" height="266">
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PDP Customer Feedback",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fineyst Transfers Customer Feedback" },
    { "type": "textarea", "id": "files", "label": "Tile files", "info": "Comma-separated filenames from /assets. .mp4 renders as a video tile.", "default": "cr img1.webp,cr img2.webp,cr img3.webp,cr img4.webp,cr img5.webp,cr img6.webp,cr img7.webp" }
  ],
  "presets": [{ "name": "PDP Customer Feedback" }]
}
{% endschema %}
