{%- comment -%}
  About Us — hero, stats strip, product-type cards, "why brands trust us"
  list, brand story, location and who-we-are blocks, closing call to action.
  Blocks:
    Stat   — a number/label pair in the strip under the hero
    Card   — a product type in the "100% focused" grid
    Point  — one line in the "Why brands trust us" list
  Class names use the abt- prefix so they cannot clash with theme.css.
  CSS lives in this file.
{%- endcomment -%}

<style>
  .abt-page { background: #fff; padding-bottom: 72px; }
  .abt-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  .abt-sec { padding: 64px 0 0; }
  .abt-sec h2 { margin: 0 0 14px; font-size: clamp(1.5rem, 2.8vw, 2.2rem); font-weight: 900; letter-spacing: -0.02em; line-height: 1.15; color: #0B3D2E; }
  .abt-text { margin: 0 0 14px; font-size: 1rem; line-height: 1.75; color: #475467; }
  .abt-center { text-align: center; }
  .abt-center .abt-text { max-width: 720px; margin-left: auto; margin-right: auto; }

  .abt-btns { display: flex; flex-wrap: wrap; gap: 12px; }
  .abt-center .abt-btns { justify-content: center; }
  .abt-btn { display: inline-flex; align-items: center; justify-content: center; padding: 13px 28px; border-radius: 10px; font-size: 0.95rem; font-weight: 800; transition: transform 0.15s; }
  .abt-btn--primary { background: #B6F000; color: #0B3D2E; }
  .abt-btn--ghost { background: #fff; color: #0B3D2E; border: 1px solid #0B3D2E; }

  /* Hero */
  .abt-hero { background: linear-gradient(135deg, #E8F5E9 0%, #fff 65%); padding: 64px 0 56px; text-align: center; }
  .abt-hero .abt-wrap { max-width: 860px; }
  .abt-eyebrow { display: inline-block; margin: 0 0 16px; padding: 6px 14px; border-radius: 999px; background: #0B3D2E; color: #B6F000; font-size: 0.78rem; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
  .abt-hero h1 { margin: 0 0 16px; font-size: clamp(2.2rem, 4.6vw, 3.6rem); font-weight: 900; letter-spacing: -0.02em; line-height: 1.08; color: #0B3D2E; }
  .abt-hero h1 span { background: #B6F000; padding: 0 10px; border-radius: 10px; }
  .abt-lead { margin: 0 auto 24px; max-width: 680px; font-size: 1.1rem; line-height: 1.7; color: #344054; }
  .abt-hero .abt-btns { justify-content: center; margin-bottom: 24px; }
  .abt-hero .abt-text { max-width: 720px; margin-left: auto; margin-right: auto; }

  /* Stats strip */
  .abt-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: -28px; position: relative; z-index: 1; }
  .abt-stat { padding: 22px 16px; text-align: center; border-radius: 14px; background: #0B3D2E; box-shadow: 0 8px 22px rgba(11, 61, 46, 0.2); }
  .abt-stat-num { display: block; font-size: 1.7rem; font-weight: 900; line-height: 1.1; color: #B6F000; }
  .abt-stat-label { display: block; margin-top: 6px; font-size: 0.85rem; font-weight: 600; color: #D1FADF; }

  /* Product-type cards */
  .abt-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 32px; text-align: left; }
  .abt-card { padding: 26px 24px; border: 1px solid #E5E7EB; border-radius: 16px; background: #fff; box-shadow: 0 2px 12px rgba(16, 24, 40, 0.05); transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s; }
  .abt-card:hover { border-color: #B6F000; transform: translateY(-3px); box-shadow: 0 10px 26px rgba(16, 24, 40, 0.1); }
  .abt-card-ic { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-bottom: 14px; border-radius: 12px; background: #E8F5E9; color: #0B3D2E; }
  .abt-card h3 { margin: 0 0 6px; font-size: 1.1rem; font-weight: 900; color: #0B3D2E; }
  .abt-card p { margin: 0; font-size: 0.92rem; line-height: 1.6; color: #667085; }

  /* Why trust us */
  .abt-trust { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
  .abt-points { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .abt-points li { display: flex; align-items: flex-start; gap: 14px; padding: 16px 18px; border: 1px solid #E5E7EB; border-radius: 12px; background: #fff; font-size: 0.98rem; font-weight: 700; line-height: 1.5; color: #0B3D2E; }
  .abt-check { flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; margin-top: 1px; border-radius: 50%; background: #B6F000; color: #0B3D2E; }

  /* Brand story */
  .abt-story { margin-top: 64px; padding: 52px 32px; text-align: center; border-radius: 24px; background: #0B3D2E; }
  .abt-story h2 { color: #fff; }
  .abt-story .abt-text { max-width: 720px; margin-left: auto; margin-right: auto; color: #D1FADF; }
  .abt-quote { max-width: 720px; margin: 22px auto 0; padding: 18px 22px; border-radius: 14px; background: rgba(182, 240, 0, 0.12); border: 1px solid rgba(182, 240, 0, 0.45); font-size: 1.05rem; font-weight: 800; line-height: 1.6; color: #B6F000; }

  /* Two-up info */
  .abt-duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .abt-info { padding: 32px 28px; border-radius: 18px; background: #E8F5E9; border: 1px solid #CDEBD7; }
  .abt-info h2 { font-size: clamp(1.3rem, 2.2vw, 1.7rem); }
  .abt-info .abt-text:last-child { margin-bottom: 0; }

  /* CTA */
  .abt-cta { margin-top: 64px; padding: 48px 24px; text-align: center; border-radius: 22px; background: linear-gradient(135deg, #E8F5E9, #fff); border: 1px solid #B6F000; }
  .abt-cta h2 { margin: 0 0 10px; font-size: clamp(1.5rem, 2.8vw, 2.1rem); font-weight: 900; color: #0B3D2E; }
  .abt-cta .abt-text { max-width: 600px; margin: 0 auto 24px; }
  .abt-cta .abt-btns { justify-content: center; }

  @media (max-width: 900px) {
    .abt-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .abt-trust { grid-template-columns: 1fr; gap: 24px; }
    .abt-duo { grid-template-columns: 1fr; }
  }

  @media (max-width: 640px) {
    .abt-wrap { padding: 0 16px; }
    .abt-sec { padding-top: 44px; }
    .abt-hero { padding: 40px 0 44px; }
    .abt-lead { font-size: 1rem; }
    .abt-btn { flex: 1 1 100%; }
    .abt-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin-top: -22px; }
    .abt-stat { padding: 16px 10px; }
    .abt-stat-num { font-size: 1.35rem; }
    .abt-stat-label { font-size: 0.78rem; }
    .abt-cards { gap: 12px; margin-top: 22px; }
    .abt-card { padding: 18px 14px; }
    .abt-card h3 { font-size: 0.98rem; }
    .abt-card p { font-size: 0.82rem; }
    .abt-points li { padding: 13px 14px; font-size: 0.92rem; }
    .abt-story { margin-top: 44px; padding: 36px 18px; border-radius: 18px; }
    .abt-info { padding: 24px 18px; }
    .abt-cta { margin-top: 44px; padding: 34px 16px; border-radius: 18px; }
  }
</style>

<section class="abt-page">

  {%- comment -%} ===== Hero ===== {%- endcomment -%}
  <div class="abt-hero">
    <div class="abt-wrap">
      {%- if section.settings.eyebrow != blank -%}<span class="abt-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.lead != blank -%}<p class="abt-lead">{{ section.settings.lead }}</p>{%- endif -%}
      <div class="abt-btns">
        <a class="abt-btn abt-btn--primary" href="{{ section.settings.btn1_link | default: '/collections' }}">{{ section.settings.btn1_label }}</a>
        <a class="abt-btn abt-btn--ghost" href="{{ section.settings.btn2_link | default: '/pages/contact-us' }}">{{ section.settings.btn2_label }}</a>
      </div>
      {%- if section.settings.hero_text != blank -%}<p class="abt-text">{{ section.settings.hero_text }}</p>{%- endif -%}
    </div>
  </div>

  <div class="abt-wrap">

    {%- comment -%} ===== Stats strip ===== {%- endcomment -%}
    {%- assign has_stats = false -%}
    {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}{%- assign has_stats = true -%}{%- endif -%}{%- endfor -%}
    {%- if has_stats -%}
      <div class="abt-stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="abt-stat" {{ block.shopify_attributes }}>
              <span class="abt-stat-num">{{ block.settings.number }}</span>
              <span class="abt-stat-label">{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%} ===== Focus + product cards ===== {%- endcomment -%}
    <div class="abt-sec abt-center">
      <h2>{{ section.settings.focus_heading }}</h2>
      <p class="abt-text">{{ section.settings.focus_text }}</p>

      <div class="abt-cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'card' -%}
            <div class="abt-card" {{ block.shopify_attributes }}>
              <span class="abt-card-ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4z"/><path d="M18.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/></svg></span>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.text }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ===== Why brands trust us ===== {%- endcomment -%}
    <div class="abt-sec">
      <div class="abt-trust">
        <div>
          <h2>{{ section.settings.trust_heading }}</h2>
          <p class="abt-text">{{ section.settings.trust_text }}</p>
        </div>
        <ul class="abt-points">
          {%- for block in section.blocks -%}
            {%- if block.type == 'point' -%}
              <li {{ block.shopify_attributes }}>
                <span class="abt-check"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg></span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>

    {%- comment -%} ===== Brand story ===== {%- endcomment -%}
    <div class="abt-story">
      <h2>{{ section.settings.story_heading }}</h2>
      <p class="abt-text">{{ section.settings.story_text }}</p>
      {%- if section.settings.story_quote != blank -%}<div class="abt-quote">{{ section.settings.story_quote }}</div>{%- endif -%}
    </div>

    {%- comment -%} ===== Location + who we are ===== {%- endcomment -%}
    <div class="abt-sec">
      <div class="abt-duo">
        <div class="abt-info">
          <h2>{{ section.settings.location_heading }}</h2>
          <p class="abt-text">{{ section.settings.location_text }}</p>
        </div>
        <div class="abt-info">
          <h2>{{ section.settings.who_heading }}</h2>
          <p class="abt-text">{{ section.settings.who_text_1 }}</p>
          {%- if section.settings.who_text_2 != blank -%}<p class="abt-text">{{ section.settings.who_text_2 }}</p>{%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} ===== CTA ===== {%- endcomment -%}
    <div class="abt-cta">
      <h2>{{ section.settings.cta_heading }}</h2>
      <p class="abt-text">{{ section.settings.cta_text }}</p>
      <div class="abt-btns">
        <a class="abt-btn abt-btn--primary" href="{{ section.settings.cta1_link | default: '/collections' }}">{{ section.settings.cta1_label }}</a>
        <a class="abt-btn abt-btn--ghost" href="{{ section.settings.cta2_link | default: '/pages/contact-us' }}">{{ section.settings.cta2_label }}</a>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "About Us",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Printed in-house. Shipped in 24 hours." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About Us" },
    { "type": "textarea", "id": "lead", "label": "Lead text", "default": "Fineyst Transfers is more than a transfer supplier. We are the craft, the color, and the creative force behind premium custom DTF transfers in the USA." },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Get a Quote" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "Get In Touch" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" },
    { "type": "textarea", "id": "hero_text", "label": "Paragraph under buttons", "default": "Built for brands, businesses, and creators, we deliver vibrant, durable transfers designed to elevate apparel, uniforms, and merchandise. Whether you're planning a streetwear drop, a team uniform run, or a single custom piece, our transfers turn ideas into wearable art." },

    { "type": "header", "content": "Focus section" },
    { "type": "text", "id": "focus_heading", "label": "Heading", "default": "100% Focused on Custom Transfers" },
    { "type": "textarea", "id": "focus_text", "label": "Text", "default": "Transfers are not a side hustle for us, they're all we do. Our entire production setup is built around one mission: delivering the best custom transfers on the market, fast, affordably, and at any scale." },

    { "type": "header", "content": "Why brands trust us" },
    { "type": "text", "id": "trust_heading", "label": "Heading", "default": "Why Brands Trust Us" },
    { "type": "textarea", "id": "trust_text", "label": "Text", "default": "Fineyst Transfers is trusted by brands across fashion, sports, education, and small business. Our reputation is built on:" },

    { "type": "header", "content": "Brand story" },
    { "type": "text", "id": "story_heading", "label": "Heading", "default": "Our Brand. Your Story Pressed." },
    { "type": "textarea", "id": "story_text", "label": "Text", "default": "Your transfer is more than decoration, it's brand identity. That's why every project we take on is guided by detail, craftsmanship, and creativity. At Fineyst Transfers, we help build your story one press at a time." },
    { "type": "textarea", "id": "story_quote", "label": "Highlighted line", "default": "From team uniforms to brand launches and merchandise drops, we don't just make transfers. We make statements." },

    { "type": "header", "content": "Location and who we are" },
    { "type": "text", "id": "location_heading", "label": "Location heading", "default": "Based in the USA. Trusted Worldwide." },
    { "type": "textarea", "id": "location_text", "label": "Location text", "default": "We serve customers across the United States and beyond. Whether you're ordering a single transfer or scaling up for mass production, our team delivers with speed, precision, and care." },
    { "type": "text", "id": "who_heading", "label": "Who we are heading", "default": "Who We Are" },
    { "type": "textarea", "id": "who_text_1", "label": "Who we are, paragraph 1", "default": "Founded by apparel decoration specialists, Fineyst Transfers was built to solve what other suppliers couldn't: high-quality transfers without compromise." },
    { "type": "textarea", "id": "who_text_2", "label": "Who we are, paragraph 2", "default": "We combine hands-on production knowledge with modern systems, giving you both craft and consistency." },

    { "type": "header", "content": "Closing call to action" },
    { "type": "text", "id": "cta_heading", "label": "Heading", "default": "Ready to Create?" },
    { "type": "textarea", "id": "cta_text", "label": "Text", "default": "Let's build your next transfer together and make sure it represents your brand the way it should." },
    { "type": "text", "id": "cta1_label", "label": "Button 1 label", "default": "Get a Quote" },
    { "type": "url", "id": "cta1_link", "label": "Button 1 link" },
    { "type": "text", "id": "cta2_label", "label": "Button 2 label", "default": "Contact Us" },
    { "type": "url", "id": "cta2_link", "label": "Button 2 link" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number or word", "default": "24 hrs" },
        { "type": "text", "id": "label", "label": "Label", "default": "Printed & shipped" }
      ]
    },
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "DTF Transfers" },
        { "type": "textarea", "id": "text", "label": "Short text", "default": "Vibrant color, ultra-fine detail" }
      ]
    },
    {
      "type": "point",
      "name": "Point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "No minimums, setup or art fees" }
      ]
    }
  ],
  "presets": [
    { "name": "About Us" }
  ]
}
{% endschema %}
