    "pdp-details": {
      "type": "pdp-details",
      "blocks": {
        "d1": {
          "type": "row",
          "settings": {
            "label": "Price Calculator",
            "body": "<p>Order custom DTF transfers with straightforward, square-inch pricing. Enter your design size and quantity to calculate your printing cost.</p><ul><li>Automatic volume discounts at 15, 50, 100, and 250 pieces.</li><li>Save up to 50% with qualifying bulk orders.</li><li>No setup fees, artwork fees, or additional color-count charges.</li></ul>"
          }
        },
        "d2": {
          "type": "row",
          "settings": {
            "label": "Features",
            "body": "<ol><li>9-color VIVID+ printing (CMYK + RGBO + White)</li><li>Rich, vibrant colors and smooth gradients</li><li>Bright, opaque whites for light and dark fabrics</li><li>Fine details and sharp, professional-quality prints</li><li>Durable, flexible transfers designed for repeated washing</li><li>Compatible with cotton, polyester, blends, and other supported fabrics</li></ol>"
          }
        },
        "d3": {
          "type": "row",
          "settings": {
            "label": "Specialty DTF Styles",
            "body": "<p>Explore specialty transfer options including 3D puff, glitter, glow-in-the-dark, reflective, and metallic foil finishes.</p><p>We also offer UV DTF transfers for decorating compatible hard surfaces such as glass, metal, and tumblers. Application methods and instructions vary by product.</p>"
          }
        },
        "d4": {
          "type": "row",
          "settings": {
            "label": "Satisfaction Guarantee",
            "body": "<p>Your satisfaction matters to us. If your DTF transfers arrive with a printing defect or an eligible application issue, contact our support team with photos of the problem.</p><p>Qualifying orders are covered by our reprint guarantee, subject to our satisfaction policy</p>"
          }
        },
        "d5": {
          "type": "row",
          "settings": {
            "label": "Pressing Instructions",
            "body": "<p>Apply your ready-to-press DTF transfers using a heat press for consistent results.</p><ol><li>Pre-press your garment to remove moisture and wrinkles.</li><li>Position your transfer with the printed adhesive side against the fabric and the carrier film facing up.</li><li>Apply heat and even pressure according to the instructions included with your order.</li><li>Peel the carrier film using the specified hot, warm, or cold peel method.</li><li>Complete a finishing press if recommended for your transfer.</li></ol><p>Always follow the pressing instructions supplied with your order, as temperature, pressure, and timing may vary by transfer type and fabric.</p>"
          }
        },
        "d6": {
          "type": "row",
          "settings": {
            "label": "Shipping & Returns",
            "body": "<p>Most qualifying DTF transfer orders are printed and shipped within 24 hours. Free shipping is available on eligible US orders.</p><p>Because custom transfers are made to order, standard returns are not accepted. Eligible printing defects are covered under our reprint guarantee.</p>"
          }
        },
        "d7": {
          "type": "row",
          "settings": {
            "label": "Art Upload Recommendations",
            "body": "<p>For the best print quality, upload high-resolution artwork with a transparent background.</p><ul><li><strong>Recommended format:</strong> PNG at 300 DPI at final print size.</li><li><strong>Accepted formats:</strong> PNG, PDF, AI, SVG, TIFF, and JPG.</li><li><strong>Fine details:</strong> Keep small text and thin lines large enough to reproduce clearly.</li><li><strong>Transparent artwork:</strong> Avoid unwanted backgrounds and poorly rendered transparent effects.</li></ul><p>Our artwork review process helps identify potential print-quality issues before production</p>"
          }
        },
        "d8": {
          "type": "row",
          "settings": {
            "label": "Names & Numbers",
            "body": "<p>Create custom names and numbers for team uniforms, sports apparel, and personalized merchandise.</p><p>Use our DTF Gang Sheet Builder to arrange multiple names, numbers, or designs on one sheet. Order the quantities you need without per-name setup fees.</p>"
          }
        }
      },
      "block_order": [
        "d1",
        "d2",
        "d3",
        "d4",
        "d5",
        "d6",
        "d7",
        "d8"
      ],
      "settings": {
        "heading": "Product Details",
        "body": "<p>Create professional-quality custom DTF transfers with Fineyst Transfers. Our VIVID+ DTF printing process uses an expanded CMYK + RGBO + White ink system to produce vibrant colors, smooth gradients, crisp whites, and sharp details.</p><p>From custom t-shirts and hoodies to team uniforms and branded merchandise, our ready-to-press DTF transfers bring your designs to life on a wide range of compatible fabrics.</p>",
        "subheading": "Super Vivid Prints. No Upcharge.",
        "subbody": "<p>Experience the benefits of 9-color VIVID+ DTF printing without paying extra for a premium color upgrade.</p><p>Fineyst includes VIVID+ printing with every standard DTF transfer order at no additional charge.</p>"
      }
    },
