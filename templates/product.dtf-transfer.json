    "pdp-details": {
      "type": "pdp-details",
      "blocks": {
        "d1": {
          "type": "row",
          "settings": {
            "label": "Price Calculator",
            "body": "<p>Pricing is calculated per square inch, so you only pay for the space your design uses. Volume discounts apply automatically at 15, 50, 100 and 250 pieces - up to 50% off.</p>"
          }
        },
        "d2": {
          "type": "row",
          "settings": {
            "label": "Features",
            "body": "<p>9-color VIVID+ printing, 16.7 million colors, near-perfect Pantone matching, bright opaque whites, 100+ wash durability, and fine detail down to 3 pixels. Works on cotton, polyester, blends, canvas, denim and nylon.</p>"
          }
        },
        "d3": {
          "type": "row",
          "settings": {
            "label": "Specialty DTF Styles",
            "body": "<p>Beyond standard DTF we print puff, glitter, glow-in-the-dark, reflective, metallic foil and UV DTF. Each specialty style ships press-ready with its own pressing card.</p>"
          }
        },
        "d4": {
          "type": "row",
          "settings": {
            "label": "Satisfaction Guarantee",
            "body": "<p>If a transfer does not press correctly or arrives with a print defect, we reprint it free. No return shipping, no restocking fee, no argument.</p>"
          }
        },
        "d5": {
          "type": "row",
          "settings": {
            "label": "Pressing Instructions",
            "body": "<p>Press at 300-320°F for 10-15 seconds with medium pressure, then peel. Peel temperature depends on the transfer type and is printed on the card that ships with every order.</p>"
          }
        },
        "d6": {
          "type": "row",
          "settings": {
            "label": "Shipping & Returns",
            "body": "<p>Most orders are printed and shipped within 24 hours. Free shipping on qualifying US orders. Because every transfer is made to order we cannot accept returns, but our reprint guarantee covers any defect.</p>"
          }
        },
        "d7": {
          "type": "row",
          "settings": {
            "label": "Art Upload Recommendations",
            "body": "<p>Upload PNG with a transparent background at 300 DPI for best results. We also accept PDF, AI, SVG, TIFF and JPG. Our art team reviews every file free and will flag anything that will not print cleanly.</p>"
          }
        },
        "d8": {
          "type": "row",
          "settings": {
            "label": "Names & Numbers",
            "body": "<p>Building team apparel? Use the Gang Sheet Builder to lay out names and numbers on a single sheet, then press them one at a time. No per-name setup fee.</p>"
          }
        }
      },
      "block_order": [
        "d1",
