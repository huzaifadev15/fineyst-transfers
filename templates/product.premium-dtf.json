    "pdp-details": {
      "type": "pdp-details",
      "blocks": {
        "d1": {
          "type": "row",
          "settings": {
            "label": "Sheet Pricing",
            "body": "<p>Our DTF gang sheets are priced by sheet size, not by the number of designs you place on each sheet.</p><ul><li>Select your gang sheet size and upload your print-ready artwork.</li><li>Add multiple designs to one sheet without per-design charges.</li><li>Automatic volume discounts at 5, 10, 25, and 50 sheets.</li><li>No setup fees or additional charges based on the number of designs.</li></ul>"
          }
        },
        "d2": {
          "type": "row",
          "settings": {
            "label": "Features",
            "body": "<ul><li>9-color VIVID+ printing (CMYK + RGBO + White)</li><li>Multiple designs on a single DTF gang sheet</li><li>Vibrant colors, smooth gradients, and sharp details</li><li>Bright white printing for light and dark fabrics</li><li>Flexible, durable transfers designed for repeated washing</li><li>Carefully packaged gang sheets for shipping</li></ul>"
          }
        },
        "d3": {
          "type": "row",
          "settings": {
            "label": "Specialty DTF Film Styles",
            "body": "<p>Explore specialty gang sheet printing options including puff, glitter, glow-in-the-dark, reflective, and metallic foil transfers.</p><p>Each specialty finish has its own production and application requirements. Select the appropriate transfer style when ordering.</p><p>UV DTF gang sheets for compatible hard surfaces are available separately from standard apparel DTF transfers.</p>"
          }
        },
        "d4": {
          "type": "row",
          "settings": {
            "label": "Satisfaction Guarantee",
            "body": "<p>If your DTF gang sheet arrives with a qualifying printing defect, contact Fineyst support with your order details and photos of the issue.</p><p>Eligible printing defects are covered by our reprint guarantee, subject to our satisfaction policy.</p>"
          }
        },
        "d5": {
          "type": "row",
          "settings": {
            "label": "Pressing Instructions",
            "body": "<p>Cut individual designs from your printed DTF gang sheet before applying them to compatible apparel.</p><ol><li>Carefully cut out the design you want to apply.</li><li>Pre-press the garment to remove moisture and wrinkles.</li><li>Place the transfer on the fabric with the carrier film facing up.</li><li>Apply heat and pressure according to the instructions included with your order.</li><li>Peel using the recommended method and complete a finishing press if instructed.</li></ol><p>Always follow the pressing instructions supplied for your specific transfer type and fabric.</p>"
          }
        },
        "d6": {
          "type": "row",
          "settings": {
            "label": "Shipping & Returns",
            "body": "<p>Most qualifying DTF gang sheet orders are printed and shipped within 24 hours. Free shipping is available on eligible US orders.</p><p>Since custom DTF gang sheets are made to order, standard returns are not accepted. Qualifying printing defects are covered under our reprint guarantee.</p>"
          }
        },
        "row_3ErD9e": {
          "type": "row",
          "settings": {
            "label": "Art Upload Recommendations",
            "body": "<p>For the best DTF gang sheet printing results, upload a single print-ready PNG file at 300 DPI, sized to your selected gang sheet dimensions.</p><ul><li>Use a transparent background.</li><li>Maintain at least 0.25 inches between designs for easier cutting.</li><li>Leave a 0.5-inch margin around the sheet edges.</li><li>Export your completed gang sheet as one flattened PNG file.</li><li>Avoid low-resolution artwork and unintended transparent effects.</li></ul><p>Our artwork review process helps identify potential spacing or resolution issues before production.</p>"
          }
        },
        "d7": {
          "type": "row",
          "settings": {
            "label": "Art Upload Recommendations",
            "body": "<p>Upload PNG with a transparent background at 300 DPI for best results. We also accept PDF, AI, SVG, TIFF and JPG. Our art team reviews every file free and will flag anything that will not print cleanly.</p>"
          }
        },
        "d8": {
          "type": "row",
          "settings": {
            "label": "Downloadable Templates",
            "body": "<p>Print custom names and numbers for sports teams, uniforms, and personalized apparel using DTF gang sheets.</p><p>Arrange multiple names, numbers, or logos on one sheet, upload your print-ready layout, and cut individual designs before heat pressing.</p><p>No per-name setup fees.</p>"
          }
        }
      },
      "block_order": [
        "d1",
        "d2",
        "d3",
        "d4",
        "d5",
        "d6",
        "row_3ErD9e",
        "d7",
