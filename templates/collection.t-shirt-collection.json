    "faq": {
      "type": "faq",
      "blocks": {
        "faq_0": {
          "type": "faq_item",
          "settings": {
            "question": "What types of blank apparel do you offer?",
            "answer": "<p>T-shirts, long sleeves, tank tops, hoodies, sweatshirts, polos, and headwear from brands like Gildan, Bella + Canvas, Next Level, and Comfort Colors.</p>"
          }
        },
        "faq_1": {
          "type": "faq_item",
          "settings": {
            "question": "Are there any minimum order requirements for wholesale apparel?",
            "answer": "<p>No minimums. Order a single piece or several hundred and you get the same wholesale pricing, with bulk discounts applied automatically as quantity grows.</p>"
          }
        },
        "faq_2": {
          "type": "faq_item",
          "settings": {
            "question": "Can I mix and match styles and colors in one order?",
            "answer": "<p>Yes. Mix any styles, sizes, and colors in a single order - quantity breaks are calculated across your whole cart, not per style.</p>"
          }
        },
        "faq_3": {
          "type": "faq_item",
          "settings": {
            "question": "Do you have blank apparel for kids?",
            "answer": "<p>Yes. Youth, toddler, and infant cuts are available across many of our core styles. Use the Cut filter in the sidebar to see everything available in a given size range.</p>"
          }
        },
        "faq_4": {
          "type": "faq_item",
          "settings": {
            "question": "Can I customize the blank apparel I purchase?",
            "answer": "<p>Absolutely - that is what our DTF transfers are for. Order your blanks and transfers together and press them yourself, or use our gang sheets to fit many designs onto one sheet.</p>"
          }
        }
      },
