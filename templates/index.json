    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "faq_item",
          "settings": {
            "question": "What is a DTF transfer?",
            "answer": "<p>A DTF (Direct to Film) transfer is a full-color design printed onto special film and applied to compatible fabrics using a heat press. It creates vibrant, flexible prints for custom apparel.</p>"
          }
        },
        "q2": {
          "type": "faq_item",
          "settings": {
            "question": "Is there a minimum order?",
            "answer": "<p>No minimums! Order a single DTF transfer or buy in bulk. Our pricing adjusts automatically based on size and quantity.</p>"
          }
        },
        "q3": {
          "type": "faq_item",
          "settings": {
            "question": "What equipment do I need?",
            "answer": "<p>A heat press is recommended for consistent DTF transfer application. Follow our pressing instructions for the correct temperature, pressure, and timing.</p>"
          }
        },
        "q4": {
          "type": "faq_item",
          "settings": {
            "question": "How long do transfers last?",
            "answer": "<p>Our DTF transfers are designed for durable, long-lasting prints. Proper heat pressing, washing, and garment care help maintain their appearance.</p>"
          }
        },
        "q5": {
          "type": "faq_item",
          "settings": {
            "question": "What file format should I upload?",
            "answer": "<p>PNG files with transparent backgrounds at 300 DPI are recommended. We also accept PDF, AI, SVG, TIFF, and JPG files. Our team can review your artwork before printing.</p>"
          }
        },
        "q6": {
          "type": "faq_item",
          "settings": {
            "question": "How fast is production?",
            "answer": "<p>Most orders are printed and shipped within 24 hours when placed before our daily cutoff. Production times may vary depending on order size and artwork requirements.</p>"
          }
        },
        "q7": {
          "type": "faq_item",
          "settings": {
            "question": "What payment methods do you accept?",
            "answer": "<p>We accept major credit cards, PayPal, Shop Pay, Apple Pay, and Google Pay through our secure checkout.</p>"
          }
        },
        "q8": {
          "type": "faq_item",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we offer international shipping. Rates and estimated delivery times depend on your destination and are calculated at checkout.</p>"
          }
        },
        "q9": {
          "type": "faq_item",
          "settings": {
            "question": "Can I put multiple designs on one sheet?",
            "answer": "<p>Absolutely! Use our DTF Gang Sheet Builder to arrange multiple designs on one sheet and maximize your available print space.</p>"
          }
        },
        "q10": {
          "type": "faq_item",
          "settings": {
            "question": "How do I track my order?",
            "answer": "<p>Once your order ships, we'll send you a tracking number by email so you can follow its delivery progress.</p>"
          }
        }
      },
