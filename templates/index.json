    "things-to-know": {
      "type": "things-to-know",
      "blocks": {
        "k1": {
          "type": "item",
          "settings": {
            "label": "Print Process",
            "question": "How do DTF transfers work?",
            "answer": "Your artwork is printed onto a PET film with pigment ink, backed with a hot-melt adhesive powder, and cured. You lay the film on your garment, press it, and peel. No weeding, no cutting, no screens - the design bonds straight into the fabric with a soft, flexible finish."
          }
        },
        "k2": {
          "type": "item",
          "settings": {
            "label": "Types",
            "question": "What types of transfers can I order?",
            "answer": "Standard DTF for everyday apparel, gang sheets to fit many designs on one sheet, UV DTF for mugs and hard surfaces, puff for a raised 3D effect, glitter and metallic foil for decorative accents, reflective for high-visibility workwear, and sublimation for a dye-in-the-fabric hand feel on polyester."
          }
        },
        "k3": {
          "type": "item",
          "settings": {
            "label": "Uses",
            "question": "What are DTF transfers used for?",
            "answer": "Team and event merch, company uniforms and workwear, small-batch clothing brands, school and club apparel, promotional giveaways, and craft or Etsy shops. Because they press onto almost anything, one order can cover tees, hoodies, hats, tote bags, and aprons at once."
          }
        },
        "k4": {
          "type": "item",
          "settings": {
            "label": "Materials",
            "question": "What fabrics do DTF transfers work on?",
            "answer": "Cotton, polyester, cotton-poly blends, tri-blends, canvas, denim, nylon, leather, and most performance fabrics. Light or dark garments both work because every transfer is printed with a white ink underbase, so colors stay accurate on black just as they do on white."
          }
        },
        "k5": {
          "type": "item",
          "settings": {
            "label": "Pressing",
            "question": "What settings should I press at?",
            "answer": "Most transfers press at 300-320°F for 10-15 seconds with medium pressure, then peel. Whether you peel hot or cold depends on the transfer type - the exact setting ships with every order, and full guidance lives on our pressing instructions page."
          }
        }
      },
