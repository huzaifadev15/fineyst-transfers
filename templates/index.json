    "things-to-know": {
      "type": "things-to-know",
      "blocks": {
        "k1": {
          "type": "item",
          "settings": {
            "label": "Print Process",
            "question": "How do DTF transfers work?",
            "answer": "DTF (Direct to Film) transfers are printed onto a special film using DTF inks and adhesive powder. The finished design is applied to compatible fabric using a heat press, creating vibrant, flexible prints without cutting or weeding."
          }
        },
        "k2": {
          "type": "item",
          "settings": {
            "label": "Types",
            "question": "What types of transfers can I order?",
            "answer": "Fineyst offers custom DTF transfers by size, DTF gang sheets, UV DTF transfers, and specialty printing options. Choose ready-to-press designs for apparel, UV DTF for suitable hard surfaces, or specialty finishes for unique effects."
          }
        },
        "k3": {
          "type": "item",
          "settings": {
            "label": "Uses",
            "question": "What are DTF transfers used for?",
            "answer": "Custom DTF transfers are ideal for personalized t-shirts, hoodies, team uniforms, business apparel, event merchandise, and promotional clothing. They're a flexible option for small orders and bulk apparel printing."
          }
        },
        "k4": {
          "type": "item",
          "settings": {
            "label": "Materials",
            "question": "What fabrics do DTF transfers work on?",
            "answer": "DTF transfers work on many compatible fabrics, including cotton, polyester, and cotton-poly blends. They can be applied to light and dark garments, making them a versatile choice for custom apparel."
          }
        },
        "k5": {
          "type": "item",
          "settings": {
            "label": "Pressing",
            "question": "What settings should I press at?",
            "answer": "DTF pressing temperature, time, and pressure depend on the transfer and fabric. Use a heat press and follow the instructions provided with your order for accurate application and long-lasting results."
          }
        }
      },
