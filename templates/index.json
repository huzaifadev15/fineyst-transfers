    "what-is-dtf": {
      "type": "what-is-dtf",
      "settings": {
        "heading": "What is DTF?",
        "text": "<p><br/>DTF (Direct to Film) is a printing method that creates vibrant, durable designs for custom apparel. <a href=\"/products/dtf-transfers\" title=\"DTF transfers\">Ready-to-press DTF transfers</a> can be applied to cotton, polyester, blends, and other compatible fabrics using a heat press. Whether you're creating custom t-shirts, hoodies, business merchandise, or personalized gifts, <a href=\"/products/premium-dtf-gang-sheets\" title=\"DTF Gang Sheet - Upload\">DTF printing</a> delivers sharp details and full-color designs without the need for minimum orders.<br/><br/></p>",
        "cta_label": "",
        "cta_link": ""
      }
    },
